---
/**
 * /calculators/drops - drop-rate calculator with two modes.
 *
 * Mode 1 (Farm a mob): pick a mob, see its full drop table
 * with estimated %; pick a specific drop to see kill-count
 * and time-to-drop math.
 *
 * Mode 2 (Hunt for an item): pick an item, see all mobs that
 * drop it, sorted by drop rate (highest first) then mob level
 * (lower is easier). Same probability math on the selected
 * source.
 *
 * Data lineage: drop tables come from CoT 2 datamine's `score`
 * field on mobs.json. Score is an integer relative-frequency
 * rating (-1 to 12), NOT a percentage. See drop-rates.ts for
 * the community-consensus score->rate mapping and its
 * honesty caveats.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { MOB_DROP_CATALOG, ITEM_DROP_SOURCES, DROP_INDEX_STATS } from "../../data/drop-index";

// Ship both catalogs to the client. Slim projections keep the
// payload manageable (~150-250 KB gzipped).
const mobsJson = JSON.stringify(MOB_DROP_CATALOG);
const itemsJson = JSON.stringify(ITEM_DROP_SOURCES);
---

<BaseLayout
	title="Drop rate calculator - Liven's Classic Maple Guide"
	description="Estimate kill counts and time-to-drop for any item + mob combo in classic MapleStory. Datamined drop tables + community rate estimates + probability math."
	theme="sleepywood"
	currentPath="/calculators/drops"
>
	<nav class="crumbs">
		<a href="/">Home</a>
		<span class="crumbs__sep">&middot;</span>
		<a href="/calculators/exp">Calculators</a>
		<span class="crumbs__sep">&middot;</span>
		<span>Drops</span>
	</nav>

	<header class="calc-hero">
		<p class="eyebrow">Calculator</p>
		<h1>Drop rate estimator</h1>
		<p class="lede">
			How long until that Zakum helm actually drops? Datamined
			drop tables from <strong>{DROP_INDEX_STATS.mobsWithDrops}</strong> mobs
			+ <strong>{DROP_INDEX_STATS.uniqueItems}</strong> unique items
			({DROP_INDEX_STATS.totalDropEntries} total entries) with
			probability math to keep expectations honest.
		</p>
	</header>

	<div class="drops-mode-tabs" role="tablist">
		<button type="button" class="drops-mode-tab drops-mode-tab--active" data-mode="mob" role="tab" aria-selected="true">
			Farm a mob
		</button>
		<button type="button" class="drops-mode-tab" data-mode="item" role="tab" aria-selected="false">
			Hunt for an item
		</button>
	</div>

	<div class="calc-grid">
		<section class="calc-inputs">
			<h2 class="calc-inputs__h" id="mode-label">Pick a mob</h2>

			<label class="calc-field drops-mode-scope drops-mode-scope--mob" data-mode-scope="mob">
				<span class="calc-field__label">Mob search</span>
				<input type="search" id="input-mob-search" placeholder="e.g. snail, orange mushroom, zakum..." />
				<select id="input-mob-sel" size="8">
					<!-- Populated by JS -->
				</select>
			</label>

			<label class="calc-field drops-mode-scope drops-mode-scope--item" data-mode-scope="item" hidden>
				<span class="calc-field__label">Item search</span>
				<input type="search" id="input-item-search" placeholder="e.g. snail shell, dark scroll, zakum helmet..." />
				<select id="input-item-sel" size="8">
					<!-- Populated by JS -->
				</select>
			</label>

			<h3 class="calc-inputs__subh">Farming rate</h3>

			<label class="calc-field">
				<span class="calc-field__label">Kills per minute</span>
				<input type="number" id="input-kpm" min="1" max="500" value="30" step="1" />
				<span class="calc-field__hint">
					Your grind cadence. Cross-reference with your EXP
					calc setup for consistent planning.
				</span>
			</label>

			<label class="calc-field">
				<span class="calc-field__label">Target drops</span>
				<input type="number" id="input-target-drops" min="1" max="999" value="1" step="1" />
				<span class="calc-field__hint">
					How many of the item do you need? 1 = "any", higher
					for stackable materials (Refined Ore x 30 etc.).
				</span>
			</label>

			<label class="calc-field">
				<span class="calc-field__label">Drop rate multiplier</span>
				<input type="number" id="input-drop-mult" min="0.5" max="10" value="1.0" step="0.5" />
				<span class="calc-field__hint">
					Drop coupons, HS with drop buff, server events, etc.
					1.0 = base rate, 2.0 = 2x event, 3.0 = HS + 2x.
				</span>
			</label>

			<h3 class="calc-inputs__subh">Override estimated rate</h3>

			<label class="calc-field">
				<span class="calc-field__label">Custom drop rate % (optional)</span>
				<input type="number" id="input-custom-rate" min="0.001" max="100" step="0.1" placeholder="leave blank to use estimate" />
				<span class="calc-field__hint">
					If you know the actual server rate (or your CoT 2
					observations), override here. Blank = use the
					score-based estimate from the drop table.
				</span>
			</label>
		</section>

		<section class="calc-outputs">
			<h2 class="calc-outputs__h" id="results-header">Pick a mob to start</h2>

			<div class="drops-selected-panel" id="selected-panel" hidden>
				<div class="drops-selected__title" id="selected-title"></div>
				<div class="drops-selected__meta" id="selected-meta"></div>
			</div>

			<!-- Drop table for selected mob (mode: farm a mob) -->
			<div class="drops-table-wrap" id="drops-table-wrap" hidden>
				<h3 class="calc-outputs__subh">Drop table (click a row to focus)</h3>
				<ul class="drops-table" id="drops-table">
					<!-- Populated by JS -->
				</ul>
			</div>

			<!-- Source table for selected item (mode: hunt for an item) -->
			<div class="drops-sources-wrap" id="sources-wrap" hidden>
				<h3 class="calc-outputs__subh">Best mobs to farm (click one to focus)</h3>
				<ul class="drops-table" id="sources-table">
					<!-- Populated by JS -->
				</ul>
			</div>

			<!-- Probability panel: appears once a specific mob+item pair is focused -->
			<div class="drops-probs" id="drops-probs" hidden>
				<h3 class="calc-outputs__subh">Probability math for <span id="probs-item-name"></span></h3>

				<div class="calc-result-grid drops-result-grid">
					<div class="calc-result">
						<span class="calc-result__label">Effective drop %</span>
						<span class="calc-result__value" id="out-eff-rate">-</span>
					</div>
					<div class="calc-result calc-result--emphasis">
						<span class="calc-result__label">Expected kills</span>
						<span class="calc-result__value" id="out-expected">-</span>
					</div>
					<div class="calc-result">
						<span class="calc-result__label">Expected time</span>
						<span class="calc-result__value" id="out-expected-time">-</span>
					</div>
				</div>

				<h4 class="drops-percentile-h">Kills for probability</h4>
				<div class="calc-result-grid drops-result-grid">
					<div class="calc-result">
						<span class="calc-result__label">50% chance</span>
						<span class="calc-result__value" id="out-p50">-</span>
					</div>
					<div class="calc-result">
						<span class="calc-result__label">90% chance</span>
						<span class="calc-result__value" id="out-p90">-</span>
					</div>
					<div class="calc-result">
						<span class="calc-result__label">99% chance</span>
						<span class="calc-result__value" id="out-p99">-</span>
					</div>
				</div>
				<p class="drops-percentile-note">
					"50% chance" means at that kill count, half of players
					would already have the drop; the other half are still
					grinding. RNG doesn't reward the median. Plan for the
					90% mark, then celebrate if you get lucky.
				</p>
			</div>

			<p class="calc-accuracy calc-accuracy--warn" id="accuracy-note">
				<strong>Note:</strong> drop rates are ESTIMATED from
				datamine `score` values via a community-consensus mapping
				(see drop-rates.ts). Real v83 rates depend on server tuning
				and can vary +/- 50% from these estimates. CoT 2 launch
				(Oct 6) will let us calibrate. Use the custom-rate override
				if you have first-hand data.
			</p>

			<details class="calc-details">
				<summary>How this is calculated</summary>
				<p><strong>Effective rate</strong> = (score-mapped rate OR custom rate) * drop multiplier, capped at 100%.</p>
				<p><strong>Expected kills</strong> = TargetDrops / rate. Mean of the negative-binomial distribution - the actual grind will run over or under this by random amounts.</p>
				<p><strong>Kills for X% chance</strong> = ln(1 - X/100) / ln(1 - rate). Geometric CDF - "if I do this many kills, what's the probability I've seen at least 1 drop?"</p>
				<p><strong>Time estimates</strong> = kills / (KPM * 60) hours. Doesn't account for potion breaks, dying, chatting - real grinds add ~15% overhead.</p>
			</details>
		</section>
	</div>

	<script id="mobs-data" type="application/json" is:inline set:html={mobsJson}></script>
	<script id="items-data" type="application/json" is:inline set:html={itemsJson}></script>
</BaseLayout>

{/* Sprint 77.1 fix: switched from data-astro-rerun (which forces
    is:inline and breaks TS) to astro:page-load listener pattern. */}
<script>
document.addEventListener("astro:page-load", () => {
	if (!document.getElementById("input-mob-search")) return;
	// Score -> % mapping mirrored client-side. Kept in sync with
	// src/data/drop-rates.ts. Duplication is intentional: shipping
	// the mapping as data lets us avoid an ESM import in the
	// script block (Astro's inline scripts can import modules but
	// the bundler adds weight; a 15-entry lookup table is smaller
	// as a literal).
	const SCORE_TO_RATE: Record<number, number> = {
		12: 40.0, 11: 30.0, 10: 25.0, 9: 18.0, 8: 12.0,
		7: 8.0, 6: 6.0, 5: 4.0, 4: 2.5, 3: 1.5,
		2: 1.0, 1: 0.5, 0: 0.25, [-1]: 0.1,
	};
	function estimatedRate(score: number): number {
		if (score in SCORE_TO_RATE) return SCORE_TO_RATE[score]!;
		if (score > 12) return SCORE_TO_RATE[12]!;
		if (score < -1) return 0.05;
		return 0.5;
	}
	function rarityLabel(score: number): string {
		if (score >= 10) return "Very common";
		if (score >= 6) return "Common";
		if (score >= 4) return "Uncommon";
		if (score >= 2) return "Rare";
		if (score >= 0) return "Very rare";
		return "Extremely rare";
	}
	function rarityTint(score: number): string {
		if (score >= 10) return "#4a8c3a";
		if (score >= 6)  return "#3a6ea5";
		if (score >= 4)  return "#7f4bb0";
		if (score >= 2)  return "#c17817";
		if (score >= 0)  return "#b8342b";
		return "#6b6b6b";
	}

	// ------- Types matching drop-index.ts projections -------
	interface MobDrop { itemId: number; itemName: string; itemType: string; score: number; }
	interface MobCat { id: number; name: string; level: number; isBoss: boolean; drops: MobDrop[]; }
	interface DropSrc { mobId: number; mobName: string; mobLevel: number; isBoss: boolean; score: number; }
	interface ItemSrc { itemId: number; itemName: string; itemType: string; sources: DropSrc[]; }

	const mobs: MobCat[] = JSON.parse(document.getElementById("mobs-data")!.textContent ?? "[]");
	const items: ItemSrc[] = JSON.parse(document.getElementById("items-data")!.textContent ?? "[]");

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const $mobSearch = $<HTMLInputElement>("input-mob-search");
	const $mobSel = $<HTMLSelectElement>("input-mob-sel");
	const $itemSearch = $<HTMLInputElement>("input-item-search");
	const $itemSel = $<HTMLSelectElement>("input-item-sel");
	const $kpm = $<HTMLInputElement>("input-kpm");
	const $target = $<HTMLInputElement>("input-target-drops");
	const $mult = $<HTMLInputElement>("input-drop-mult");
	const $customRate = $<HTMLInputElement>("input-custom-rate");
	const $selectedPanel = $("selected-panel");
	const $selectedTitle = $("selected-title");
	const $selectedMeta = $("selected-meta");
	const $dropsTableWrap = $("drops-table-wrap");
	const $dropsTable = $("drops-table");
	const $sourcesWrap = $("sources-wrap");
	const $sourcesTable = $("sources-table");
	const $probs = $("drops-probs");
	const $probsItemName = $("probs-item-name");
	const $resultsHeader = $("results-header");
	const $modeLabel = $("mode-label");

	type Mode = "mob" | "item";
	let mode: Mode = "mob";
	let focusedMob: MobCat | null = null;
	let focusedItem: ItemSrc | null = null;
	let focusedSourceOrDrop: { score: number; itemName: string } | null = null;

	// ============================================================
	// Mode switching
	// ============================================================
	document.querySelectorAll<HTMLButtonElement>(".drops-mode-tab").forEach((btn) => {
		btn.addEventListener("click", () => {
			mode = (btn.dataset.mode as Mode) ?? "mob";
			document.querySelectorAll<HTMLButtonElement>(".drops-mode-tab").forEach((b) => {
				const active = b === btn;
				b.classList.toggle("drops-mode-tab--active", active);
				b.setAttribute("aria-selected", active ? "true" : "false");
			});
			// Sprint 74 fix: use classList + explicit querySelector
			// against the outer <label> instead of relying on data-*
			// attribute alone. Astro's SSR occasionally emits scoped
			// styles that lose track of dynamically-changing `hidden`
			// bindings when the attribute is set on a nested element;
			// forcing display via a class avoids the churn.
			document.querySelectorAll<HTMLElement>(".drops-mode-scope").forEach((el) => {
				const scope = el.dataset.modeScope;
				const active = scope === mode;
				el.hidden = !active;
				el.style.display = active ? "" : "none";
			});
			$modeLabel.textContent = mode === "mob" ? "Pick a mob" : "Pick an item";
			// Clear focus state on mode switch so stale UI doesn't
			// pollute the new mode's flow.
			focusedMob = null;
			focusedItem = null;
			focusedSourceOrDrop = null;
			$selectedPanel.hidden = true;
			$dropsTableWrap.hidden = true;
			$sourcesWrap.hidden = true;
			$probs.hidden = true;
			$resultsHeader.textContent = mode === "mob" ? "Pick a mob to start" : "Pick an item to start";
		});
	});

	// ============================================================
	// List populators + focus handlers
	// ============================================================
	function populateMobList(filter: string): void {
		const f = filter.trim().toLowerCase();
		const filtered = f ? mobs.filter((m) => m.name.toLowerCase().includes(f)) : mobs;
		$mobSel.innerHTML = "";
		for (const m of filtered.slice(0, 300)) {
			const opt = document.createElement("option");
			opt.value = String(m.id);
			opt.textContent = `Lv ${m.level} - ${m.name}${m.isBoss ? " (boss)" : ""}`;
			$mobSel.appendChild(opt);
		}
	}

	function populateItemList(filter: string): void {
		const f = filter.trim().toLowerCase();
		const filtered = f ? items.filter((i) => i.itemName.toLowerCase().includes(f)) : items;
		$itemSel.innerHTML = "";
		for (const i of filtered.slice(0, 300)) {
			const opt = document.createElement("option");
			opt.value = String(i.itemId);
			opt.textContent = `${i.itemName} (${i.itemType})`;
			$itemSel.appendChild(opt);
		}
	}

	function focusMob(mobId: number): void {
		const m = mobs.find((x) => x.id === mobId);
		if (!m) return;
		focusedMob = m;
		focusedItem = null;
		focusedSourceOrDrop = null;
		$resultsHeader.textContent = m.name;
		$selectedPanel.hidden = false;
		$selectedTitle.textContent = m.name;
		$selectedMeta.textContent = `Lv ${m.level}${m.isBoss ? " - Boss" : ""} - ${m.drops.length} drop${m.drops.length === 1 ? "" : "s"}`;
		renderDropTable(m);
		$dropsTableWrap.hidden = false;
		$sourcesWrap.hidden = true;
		$probs.hidden = true;
	}

	function focusItem(itemId: number): void {
		const i = items.find((x) => x.itemId === itemId);
		if (!i) return;
		focusedItem = i;
		focusedMob = null;
		focusedSourceOrDrop = null;
		$resultsHeader.textContent = i.itemName;
		$selectedPanel.hidden = false;
		$selectedTitle.textContent = i.itemName;
		$selectedMeta.textContent = `${i.itemType} - drops from ${i.sources.length} mob${i.sources.length === 1 ? "" : "s"}`;
		renderSourceTable(i);
		$sourcesWrap.hidden = false;
		$dropsTableWrap.hidden = true;
		$probs.hidden = true;
	}

	function renderDropTable(m: MobCat): void {
		$dropsTable.innerHTML = "";
		for (const d of m.drops) {
			const rate = estimatedRate(d.score);
			const li = document.createElement("li");
			li.className = "drops-row";
			li.dataset.score = String(d.score);
			li.dataset.itemName = d.itemName;
			li.innerHTML = `
				<span class="drops-row__tint" style="background:${rarityTint(d.score)}"></span>
				<span class="drops-row__name">${escapeHtml(d.itemName)}</span>
				<span class="drops-row__type">${escapeHtml(d.itemType)}</span>
				<span class="drops-row__rarity" title="Datamine score: ${d.score}">${rarityLabel(d.score)}</span>
				<span class="drops-row__rate">${rate.toFixed(2)}%</span>
			`;
			li.addEventListener("click", () => {
				focusedSourceOrDrop = { score: d.score, itemName: d.itemName };
				document.querySelectorAll<HTMLElement>(".drops-row").forEach((r) =>
					r.classList.toggle("drops-row--active", r === li)
				);
				renderProbabilities();
			});
			$dropsTable.appendChild(li);
		}
	}

	function renderSourceTable(i: ItemSrc): void {
		$sourcesTable.innerHTML = "";
		for (const s of i.sources.slice(0, 25)) {
			const rate = estimatedRate(s.score);
			const li = document.createElement("li");
			li.className = "drops-row";
			li.dataset.mobId = String(s.mobId);
			li.innerHTML = `
				<span class="drops-row__tint" style="background:${rarityTint(s.score)}"></span>
				<a class="drops-row__name" href="/mobs/${s.mobId}" onclick="event.stopPropagation()">${escapeHtml(s.mobName)}</a>
				<span class="drops-row__type">Lv ${s.mobLevel}${s.isBoss ? " boss" : ""}</span>
				<span class="drops-row__rarity" title="Datamine score: ${s.score}">${rarityLabel(s.score)}</span>
				<span class="drops-row__rate">${rate.toFixed(2)}%</span>
			`;
			li.addEventListener("click", () => {
				focusedSourceOrDrop = { score: s.score, itemName: i.itemName };
				document.querySelectorAll<HTMLElement>(".drops-row").forEach((r) =>
					r.classList.toggle("drops-row--active", r === li)
				);
				renderProbabilities();
			});
			$sourcesTable.appendChild(li);
		}
	}

	// ============================================================
	// Probability math
	// ============================================================
	// Sprint 74.1 fix: kills-for-probability tiles now scale with
	// target drops. For target=1 this is the geometric CDF (fast
	// closed form). For target>1 it's the negative binomial - we
	// use lgamma-based binomial CDF + bisection. Accurate up to
	// target ~ 500 without precision loss.

	// Lanczos approximation of log Gamma. Standard 9-coefficient
	// implementation, works for x > 0.5 (we only ever call with
	// positive integers so we're safe).
	function lgamma(x: number): number {
		const p = [
			0.99999999999980993, 676.5203681218851, -1259.1392167224028,
			771.32342877765313, -176.61502916214059, 12.507343278686905,
			-0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7,
		];
		x -= 1;
		let a = p[0]!;
		for (let i = 1; i < 9; i++) a += p[i]! / (x + i);
		const t = x + 7.5;
		return 0.5 * Math.log(2 * Math.PI) + (x + 0.5) * Math.log(t) - t + Math.log(a);
	}

	// P(Y >= k) where Y ~ Binomial(n, p). Computed as 1 - CDF(k-1).
	function binomialTailGe(k: number, n: number, p: number): number {
		if (k <= 0) return 1;
		if (k > n) return 0;
		if (p >= 1) return 1;
		if (p <= 0) return 0;
		const logP = Math.log(p);
		const log1mP = Math.log(1 - p);
		const logNfact = lgamma(n + 1);
		let cdf = 0;
		for (let i = 0; i < k; i++) {
			const logC = logNfact - lgamma(i + 1) - lgamma(n - i + 1);
			cdf += Math.exp(logC + i * logP + (n - i) * log1mP);
		}
		return Math.max(0, 1 - cdf);
	}

	// Smallest n such that P(Y >= k | Y ~ Binomial(n,p)) >= target.
	// Bisection between n=k and n= 20 * k/p (generous upper bound).
	function killsForProbAndTarget(p: number, target: number, k: number): number {
		if (p <= 0) return Infinity;
		if (target <= 0) return 0;
		if (target >= 1) return Infinity;
		// Fast path: target = 1 uses closed-form geometric CDF.
		if (k === 1) return Math.log(1 - target) / Math.log(1 - p);
		let lo = k;
		let hi = Math.ceil((k / p) * 20);
		// Safety cap: if even our generous upper bound doesn't hit
		// the target, return it - user will see a huge number and
		// know the grind is nasty.
		if (binomialTailGe(k, hi, p) < target) return hi;
		while (lo < hi) {
			const mid = Math.floor((lo + hi) / 2);
			if (binomialTailGe(k, mid, p) >= target) hi = mid;
			else lo = mid + 1;
		}
		return lo;
	}

	function renderProbabilities(): void {
		if (!focusedSourceOrDrop) { $probs.hidden = true; return; }
		const score = focusedSourceOrDrop.score;
		const custom = Number($customRate.value);
		// User's custom override wins if they set anything > 0.
		const base = (isFinite(custom) && custom > 0) ? custom : estimatedRate(score);
		const mult = Math.max(0.1, Number($mult.value) || 1);
		const effective = Math.min(100, base * mult);
		const p = effective / 100;
		const kpm = Math.max(1, Number($kpm.value) || 30);
		const target = Math.max(1, Math.floor(Number($target.value) || 1));

		const expected = target / p;
		const k50 = killsForProbAndTarget(p, 0.5, target);
		const k90 = killsForProbAndTarget(p, 0.9, target);
		const k99 = killsForProbAndTarget(p, 0.99, target);

		$probsItemName.textContent = focusedSourceOrDrop.itemName;
		$("out-eff-rate").textContent = effective.toFixed(3) + "%";
		$("out-expected").textContent = fmtKills(expected);
		$("out-expected-time").textContent = fmtTime(expected / kpm);
		$("out-p50").textContent = fmtKills(k50);
		$("out-p90").textContent = fmtKills(k90);
		$("out-p99").textContent = fmtKills(k99);
		$probs.hidden = false;
	}

	function fmtKills(n: number): string {
		if (!isFinite(n) || n <= 0) return "-";
		if (n >= 1e6) return (n / 1e6).toFixed(2) + "M";
		if (n >= 1e3) return (n / 1e3).toFixed(1) + "k";
		return String(Math.ceil(n));
	}

	function fmtTime(mins: number): string {
		if (!isFinite(mins) || mins <= 0) return "-";
		if (mins < 60) return mins.toFixed(1) + "m";
		const hrs = mins / 60;
		if (hrs < 48) return hrs.toFixed(1) + "h";
		return (hrs / 24).toFixed(1) + "d";
	}

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) => ({
			"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
		}[c] ?? c));
	}

	// ============================================================
	// Wire up
	// ============================================================
	populateMobList("");
	populateItemList("");
	$mobSearch.addEventListener("input", () => populateMobList($mobSearch.value));
	$mobSel.addEventListener("change", () => focusMob(Number($mobSel.value)));
	$itemSearch.addEventListener("input", () => populateItemList($itemSearch.value));
	$itemSel.addEventListener("change", () => focusItem(Number($itemSel.value)));
	for (const el of [$kpm, $target, $mult, $customRate]) {
		el.addEventListener("input", renderProbabilities);
	}
});
</script>

