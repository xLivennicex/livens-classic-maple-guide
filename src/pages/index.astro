---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import JobCard from "../components/JobCard.astro";
import SystemCard from "../components/SystemCard.astro";
import LaunchTimeline from "../components/LaunchTimeline.astro";
import InfoCard from "../components/InfoCard.astro";
import AccuracyLedger, { type LedgerEntry } from "../components/AccuracyLedger.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Countdown from "../components/Countdown.astro";
import { jobs } from "../data/jobs";
import { countdownTargets } from "../data/launch";

// System guides come straight from the content collection so this
// section auto-updates the moment a new .md is added. Sorted alpha
// by heading for now - swap for `lastUpdated` desc if we want
// recency-first later.
const systemGuides = (await getCollection("guides")).sort((a, b) =>
	a.data.heading.localeCompare(b.data.heading)
);

// The Nexon 'Ossyria Exploration Report' post is the primary
// launch-timeline source. Archived via the Internet Archive so the
// citation survives if Nexon rotates the URL.
const NEXON_ANNOUNCEMENT =
	"https://www.nexon.com/maplestory/news/general/44359/ossyria-exploration-report";
const NEXON_ANNOUNCEMENT_ARCHIVE =
	"https://web.archive.org/web/20260821205944/https://www.nexon.com/maplestory/news/general/44359/ossyria-exploration-report";

const ledgerEntries: LedgerEntry[] = [
	{
		label: "Official announcement",
		status: "officially-confirmed",
		sourceUrl: NEXON_ANNOUNCEMENT,
		archiveUrl: NEXON_ANNOUNCEMENT_ARCHIVE,
	},
	{
		label: "Closed Online Test",
		status: "closed-test",
		complete: true,
	},
	{
		label: "Founder's Access",
		status: "needs-reverification",
		note: "verify Oct. 6",
	},
	{
		label: "Mark of Beta Quest",
		status: "needs-reverification",
		note: "limited-time; ends late November",
	},
];

const prepChecklist = [
	"Choosing your first character",
	"Mark of Beta Quest (limited-time, ends late November)",
	"Items worth keeping",
	"Beginner Island walkthrough",
	"Early mesos and equipment",
	"Party and quest preparation",
];
---

<BaseLayout
	title="Liven's Classic Maple Guide"
	currentPath="/"
	theme="henesys"
	decorations={true}
>
	<section class="hero">
		<div class="hero-copy">
			<span class="badge">Classic World field manual</span>
			<h1>Every quest. Every map. Every drop.</h1>
			<p>
				A community-built guide to Global MapleStory Classic World - every
				quest line, every corner of every map, every item and where it comes
				from. Built for players returning after twenty years and players
				stepping in for the first time, with sources you can check and honest
				blank spots where the answers aren't in yet.
			</p>

			<div class="hero-actions">
				<a class="primary-button" href="/jobs">Choose your job</a>
				<a class="secondary-button" href="/launch">Launch checklist</a>
			</div>
		</div>

		<LaunchTimeline />
	</section>

	<section class="section countdown-section" aria-labelledby="countdown-heading">
		<div class="section-heading">
			<div>
				<span class="eyebrow">Countdown</span>
				<h2 id="countdown-heading">How long until launch?</h2>
			</div>
			<span class="countdown-note">Times estimated - awaiting Nexon confirmation</span>
		</div>

		<div class="countdown-grid">
			<Countdown
				targetIso={countdownTargets.foundersAccess.iso}
				label={countdownTargets.foundersAccess.label}
				sublabel={countdownTargets.foundersAccess.sublabel}
				tone="amber"
			/>
			<Countdown
				targetIso={countdownTargets.officialLaunch.iso}
				label={countdownTargets.officialLaunch.label}
				sublabel={countdownTargets.officialLaunch.sublabel}
				tone="green"
			/>
		</div>
	</section>

	<section class="section" id="jobs">
		<div class="section-heading">
			<div>
				<span class="eyebrow">Class guides</span>
				<h2>Choose your path</h2>
			</div>
			<StatusBadge status="closed-test" />
		</div>

		<div class="job-grid">
			{jobs.map((job) => <JobCard job={job} />)}
		</div>
	</section>

	<!-- Systems section: surfaces every guide in the content collection.
	     Grows automatically as new .md files ship. -->
	{systemGuides.length > 0 && (
		<section class="section" id="systems">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Systems guides</span>
					<h2>Classic World systems</h2>
				</div>
				<span class="countdown-note">
					{systemGuides.length} guide{systemGuides.length === 1 ? "" : "s"} - more shipping soon
				</span>
			</div>

			<div class="system-grid">
				{systemGuides.map((g) => (
					<SystemCard
						href={`/${g.id}`}
						eyebrow={g.data.eyebrow}
						heading={g.data.heading}
						description={g.data.description}
						verificationStatus={g.data.verificationStatus}
					/>
				))}
			</div>
		</section>
	)}

	<section class="guide-grid" id="prepare">
		<InfoCard eyebrow="Start here" heading="Prepare for launch">
			<ul>
				{prepChecklist.map((item) => <li>{item}</li>)}
			</ul>
		</InfoCard>

		<InfoCard eyebrow="Accuracy ledger" heading="Know what is confirmed">
			<AccuracyLedger entries={ledgerEntries} />
			<p class="see-all">
				<a href="/launch#sources">See all sources on the Launch Hub &rarr;</a>
			</p>
		</InfoCard>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.5fr 0.75fr;
		gap: 1.5rem;
		padding: 2.5rem;
		background: rgba(255, 255, 255, 0.94);
		border: 3px solid #8caf73;
		border-radius: 1.25rem;
		box-shadow: 0 10px 30px rgba(49, 75, 50, 0.15);
	}

	.hero-copy {
		align-self: center;
	}

	.hero-copy p {
		max-width: 42rem;
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.4rem;
	}

	.section {
		margin-top: 3rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.section-heading h2 {
		margin-bottom: 0;
	}

	.job-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	/* Systems section: same rhythm as job-grid but sized for cards with
	 * more prose. Two per row on desktop, one on narrow screens. */
	.system-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1rem;
	}

	.guide-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}

	.countdown-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.countdown-note {
		font-size: 0.78rem;
		color: #5d665d;
		font-style: italic;
	}

	@media (max-width: 800px) {
		.countdown-grid {
			grid-template-columns: 1fr;
		}
	}

	.see-all {
		margin: 1rem 0 0;
		font-size: 0.9rem;
	}

	.see-all a {
		color: #365c3a;
		text-decoration: underline;
		text-underline-offset: 2px;
		font-weight: bold;
	}

	@media (max-width: 800px) {
		.hero,
		.guide-grid {
			grid-template-columns: 1fr;
		}

		.section-heading {
			align-items: stretch;
			flex-direction: column;
		}

		.job-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 500px) {
		.hero {
			padding: 1.3rem;
		}

		.job-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
