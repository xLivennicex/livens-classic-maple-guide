---
/**
 * /npcs - full NPC catalog.
 *
 * 266 NPCs from lookups.npc_names, cross-referenced with map
 * residency and quest handouts. Filter by 'has quests' /
 * 'has maps' / 'unmapped' so a researcher can zero in on
 * either quest-active NPCs or the ambient population.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import indexData from "../../data/db/index.json";
import generatedAt from "../../data/db/generated-at.json";
import { npcSpriteUrl } from "../../lib/maplestory-cdn";

// Prefer sort by name (alpha) since NPC IDs cluster by region in
// a way that isn't reader-friendly for a flat catalog.
const npcs = [...indexData.npcs].sort((a, b) =>
	a.name.localeCompare(b.name),
);

const withQuests = npcs.filter((n) => n.questCount > 0).length;
const withMaps = npcs.filter((n) => n.mapCount > 0).length;
const orphans = npcs.filter((n) => n.mapCount === 0 && n.questCount === 0).length;

const buildDate = new Date(generatedAt.timestamp).toISOString().slice(0, 10);
---

<BaseLayout
	title="NPCs - Liven's Classic Maple Guide"
	description="Complete NPC catalog - which maps they live on, which quests they give. Cross-referenced from CoT 2 datamine."
	currentPath="/npcs"
	theme="henesys"
>
	<section class="section-heading">
		<div>
			<span class="eyebrow">Reference catalog</span>
			<h1>NPCs</h1>
			<p class="lede">
				{npcs.length} NPCs from the CoT 2 datamine.
				{withQuests} hand out quests. {withMaps} are stationed
				on at least one map. {orphans} are unmapped/uncredited
				(often scripted or event-spawned NPCs).
			</p>
			<p class="build-meta">
				Catalog regenerated <strong>{buildDate}</strong>.
				Rerun <code>npm run db</code> to refresh.
			</p>
		</div>
		<StatusBadge status="closed-test" verifiedOn="pre-launch" />
	</section>

	<div class="controls">
		<label class="search-label">
			<span>Search</span>
			<input
				id="npc-search"
				type="search"
				placeholder="NPC name or ID..."
				autocomplete="off"
			/>
		</label>

		<div class="filter-row">
			<span class="filter-row__label">Filter:</span>
			<div class="filter-chips" id="npc-filter-chips">
				<button class="chip chip--active" data-filter="">All ({npcs.length})</button>
				<button class="chip" data-filter="quests">Gives quests ({withQuests})</button>
				<button class="chip" data-filter="maps">Has map placement ({withMaps})</button>
				<button class="chip" data-filter="orphan">Unmapped ({orphans})</button>
			</div>
		</div>
	</div>

	<div class="result-count" id="result-count">
		Showing all {npcs.length} NPCs
	</div>

	<div class="npc-grid">
		{npcs.map((n) => (
			<a
				class="npc-card"
				href={`/npcs/${n.id}`}
				data-name={n.name.toLowerCase()}
				data-id={n.id}
				data-has-quests={n.questCount > 0 ? "1" : "0"}
				data-has-maps={n.mapCount > 0 ? "1" : "0"}
			>
				{npcSpriteUrl(n.wzId, n.name) && (
					<img
						class="npc-card__sprite"
						src={npcSpriteUrl(n.wzId, n.name)}
						alt=""
						loading="lazy"
						onerror="this.style.visibility='hidden'"
					/>
				)}
				<div class="npc-card__body">
					<span class="npc-card__name">{n.name}</span>
					<span class="npc-card__id">NPC {n.id}</span>
					<div class="npc-card__pills">
						{n.mapCount > 0 && (
							<span class="pill">{n.mapCount} map{n.mapCount === 1 ? "" : "s"}</span>
						)}
						{n.questCount > 0 && (
							<span class="pill pill--quest">{n.questCount} quest{n.questCount === 1 ? "" : "s"}</span>
						)}
						{n.mapCount === 0 && n.questCount === 0 && (
							<span class="pill pill--muted">unmapped</span>
						)}
					</div>
				</div>
			</a>
		))}
	</div>

	<script is:inline>
		(function () {
			const search = document.getElementById("npc-search");
			const chips = document.getElementById("npc-filter-chips");
			const resultCount = document.getElementById("result-count");
			const cards = Array.from(document.querySelectorAll(".npc-card"));

			let activeFilter = "";
			let searchTerm = "";

			function applyFilters() {
				let visible = 0;
				for (const card of cards) {
					let matchesFilter = true;
					if (activeFilter === "quests") matchesFilter = card.dataset.hasQuests === "1";
					else if (activeFilter === "maps") matchesFilter = card.dataset.hasMaps === "1";
					else if (activeFilter === "orphan")
						matchesFilter = card.dataset.hasQuests === "0" && card.dataset.hasMaps === "0";
					const matchesSearch =
						!searchTerm ||
						card.dataset.name.includes(searchTerm) ||
						card.dataset.id.includes(searchTerm);
					const show = matchesFilter && matchesSearch;
					card.hidden = !show;
					if (show) visible++;
				}
				resultCount.textContent = `Showing ${visible} NPC${visible === 1 ? "" : "s"}`;
			}

			search.addEventListener("input", (e) => {
				searchTerm = e.target.value.toLowerCase().trim();
				applyFilters();
			});

			chips.addEventListener("click", (e) => {
				const chip = e.target.closest(".chip");
				if (!chip) return;
				chips.querySelectorAll(".chip").forEach((c) =>
					c.classList.remove("chip--active"),
				);
				chip.classList.add("chip--active");
				activeFilter = chip.dataset.filter || "";
				applyFilters();
			});
		})();
	</script>
</BaseLayout>

<style>
	.eyebrow {
		display: inline-block; font-size: 0.75rem; font-weight: bold;
		text-transform: uppercase; letter-spacing: 0.1em;
		color: var(--accent-primary);
	}
	h1 { margin: 0.3rem 0 0.5rem; }
	.lede { max-width: 48rem; line-height: 1.6; color: var(--text-body); margin: 0; }
	.build-meta { margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-muted); }
	.build-meta code {
		padding: 0.1rem 0.4rem; background: var(--surface-nav);
		color: var(--text-on-nav); border-radius: 0.25rem; font-size: 0.9em;
	}

	.controls {
		display: flex; flex-direction: column; gap: 0.9rem;
		margin-bottom: 1rem; padding: 1rem;
		background: var(--surface-card); border: 2px solid var(--border-card);
		border-radius: 0.75rem;
	}
	.search-label {
		display: flex; flex-direction: column; gap: 0.3rem;
		font-size: 0.85rem; font-weight: bold;
	}
	.search-label input {
		padding: 0.5rem 0.75rem; border: 1px solid var(--border-card);
		border-radius: 0.4rem; font-size: 1rem; background: var(--bg-cloud);
	}
	.filter-row { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; }
	.filter-row__label {
		font-size: 0.85rem; font-weight: bold;
		color: var(--text-muted); min-width: 4rem;
	}
	.filter-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.chip {
		padding: 0.35rem 0.7rem; font-size: 0.8rem;
		background: var(--surface-nav); color: var(--text-on-nav);
		border: 1px solid var(--border-card); border-radius: 999px;
		cursor: pointer; transition: background 120ms ease, color 120ms ease;
	}
	.chip:hover { background: var(--accent-primary); color: white; }
	.chip--active {
		background: var(--accent-primary); color: white;
		border-color: var(--accent-primary);
	}

	.result-count { margin: 0.5rem 0 0.8rem; font-size: 0.85rem; color: var(--text-muted); }

	.npc-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 0.6rem;
	}
	.npc-card {
		display: flex; align-items: center; gap: 0.7rem;
		padding: 0.7rem 0.9rem;
		background: var(--surface-card);
		border: 1px solid var(--border-card);
		border-radius: 0.5rem;
		text-decoration: none; color: inherit;
		transition: transform 100ms ease, border-color 100ms ease;
	}
	.npc-card:hover {
		transform: translateY(-1px);
		border-color: var(--accent-primary);
	}
	.npc-card__sprite {
		width: 40px; height: 40px;
		object-fit: contain;
		image-rendering: pixelated;
	}
	.npc-card__body {
		display: flex; flex-direction: column;
		min-width: 0; gap: 0.15rem;
	}
	.npc-card__name {
		font-weight: 500; color: var(--accent-primary);
		font-size: 0.95rem;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.npc-card__id { font-size: 0.75rem; color: var(--text-muted); font-family: monospace; }
	.npc-card__pills { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.2rem; }
	.pill {
		display: inline-block; padding: 0.1rem 0.45rem;
		font-size: 0.78rem; font-weight: bold;
		background: var(--bg-cloud); color: var(--text-muted);
		border: 1px solid var(--border-card); border-radius: 999px;
	}
	.pill--quest {
		background: var(--accent-secondary);
		color: var(--text-on-nav);
		border-color: var(--accent-secondary-border);
	}
	.pill--muted { opacity: 0.6; font-style: italic; }
</style>
