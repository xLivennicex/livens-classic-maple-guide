---
/**
 * /search - full-text search across every page of the site.
 *
 * Implementation: Pagefind (https://pagefind.app) runs at BUILD time
 * as a post-step in `npm run build` (see package.json). It scans
 * every HTML file in `dist/` for elements marked `data-pagefind-body`
 * and emits a static search index + UI assets at `dist/pagefind/`.
 *
 * At runtime this page loads Pagefind's default UI script from
 * `/pagefind/pagefind-ui.js`. Everything runs client-side against the
 * pre-built index - no server, no API calls, nothing sent anywhere.
 *
 * Reader flow:
 * 1. Anything can link here with `?q=<query>` (search forms, the
 *    command palette, "see all results" links) - often via a
 *    ClientRouter soft navigation, hence the astro:page-load hook.
 * 2. This page reads `q` from the URL and pre-populates the widget.
 * 3. Widget updates results as the reader types (Pagefind handles the
 *    debounce internally).
 *
 * DEV WARNING: search will 404 on the /pagefind assets during
 * `astro dev` because pagefind runs AFTER astro build. To test
 * locally, run `npm run build && npm run preview`. This is called
 * out inline in the UI's empty state so devs don't get confused.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Search - Liven's Classic Maple Guide"
	description="Search across every guide, job page, quest, and item in the reference database."
	currentPath="/search"
	theme="henesys"
>
	<section class="section-heading">
		<div>
			<span class="eyebrow">Reference database</span>
			<h1>Search</h1>
			<p class="lede">
				Full-text search across every page. Indexes guides, class
				pages, quests, items, and reference systems. Powered by
				<a href="https://pagefind.app" target="_blank" rel="noopener">Pagefind</a>
				- runs entirely in your browser against a pre-built static
				index, so results are instant and nothing you type is sent
				to a server.
			</p>
			<p class="dev-warning" hidden data-search-unavailable>
				<strong>Dev note:</strong> if you're seeing 404s for
				<code>/pagefind/*</code> below, that's because Pagefind
				only indexes at build time. Run
				<code>npm run build &amp;&amp; npm run preview</code>
				to try search locally.
			</p>
		</div>
	</section>

	<!-- Pagefind mounts its UI inside this container. -->
	<div id="search" class="search-container"></div>

	<!-- Pagefind's default stylesheet. Plain URL (not an import): the
	     /pagefind/ output only exists after the post-build index step. -->
	<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	<script>
		// The site uses Astro's ClientRouter, so arriving here is often a
		// SOFT navigation (form submit, "see all results" links). The old
		// DOMContentLoaded hook never fires on a soft nav - the page came
		// up empty. astro:page-load fires on the initial load AND after
		// every soft nav, same as the site's other interactive components.
		let uiScript: Promise<void> | null = null;

		// Load Pagefind's UI runtime once per full page lifetime, shared
		// across soft navs back to /search.
		function loadPagefindUi(): Promise<void> {
			if ((window as any).PagefindUI) return Promise.resolve();
			uiScript ??= new Promise<void>((resolve, reject) => {
				const tag = document.createElement("script");
				tag.src = "/pagefind/pagefind-ui.js";
				tag.onload = () => resolve();
				tag.onerror = () => {
					uiScript = null; // allow a retry on the next visit
					reject(new Error("pagefind-ui.js failed to load"));
				};
				document.head.appendChild(tag);
			});
			return uiScript;
		}

		document.addEventListener("astro:page-load", async () => {
			const mount = document.getElementById("search");
			if (!mount || mount.dataset.ready) return; // not /search, or already mounted
			mount.dataset.ready = "true";

			try {
				await loadPagefindUi();
			} catch {
				// Expected under `astro dev` (Pagefind indexes post-build).
				// Only now is the explanatory note relevant, so only now show it.
				document.querySelector("[data-search-unavailable]")?.removeAttribute("hidden");
				return;
			}

			const ui = new (window as any).PagefindUI({
				element: "#search",
				showSubResults: true,
				showImages: false,
				resetStyles: false,
				debounceTimeoutMs: 150,
			});

			// Pre-populate from ?q=... so a reader arriving from a search
			// form or "see all results" link immediately sees results.
			const initialQuery = new URLSearchParams(location.search).get("q");
			if (initialQuery) ui.triggerSearch(initialQuery);
		});
	</script>
</BaseLayout>

<style>
	.section-heading {
		margin-bottom: 1.5rem;
	}

	.lede {
		max-width: 46rem;
		margin-top: 0.5rem;
		line-height: 1.6;
		color: var(--text-body);
	}

	.lede a {
		font-weight: bold;
	}

	/* Dev warning: rendered `hidden`; the script un-hides it only if
	 * /pagefind/pagefind-ui.js fails to load (i.e. `astro dev` before a
	 * production build). It used to show unconditionally, including on
	 * the live site. */
	.dev-warning {
		margin-top: 0.75rem;
		padding: 0.55rem 0.75rem;
		background: var(--surface-card);
		border-left: 3px solid var(--accent-primary);
		border-radius: 0.4rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.dev-warning code {
		padding: 0.1rem 0.35rem;
		background: var(--surface-nav);
		color: var(--text-on-nav);
		border-radius: 0.25rem;
		font-size: 0.9em;
	}

	/* Pagefind ships with its own themable UI - we just constrain
	 * the width and give it breathing room. */
	.search-container {
		max-width: 46rem;
		margin: 0 auto;
	}

	/* Tighten a few Pagefind default styles so they blend better with
	 * our card-and-panel aesthetic. Prefixed selectors so we don't
	 * accidentally clobber anything outside the search widget. */
	.search-container :global(.pagefind-ui__search-input) {
		border-radius: 0.6rem;
		border: 2px solid var(--border-card);
		padding: 0.7rem 0.9rem;
	}

	.search-container :global(.pagefind-ui__result) {
		border: 2px solid var(--border-card);
		border-radius: 0.75rem;
		background: var(--surface-card);
		margin-bottom: 0.7rem;
		padding: 0.9rem 1.1rem;
	}

	.search-container :global(.pagefind-ui__result-link) {
		color: var(--accent-primary);
		font-weight: bold;
	}
</style>
