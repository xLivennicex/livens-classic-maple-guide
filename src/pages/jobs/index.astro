---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JobCard from "../../components/JobCard.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { jobs } from "../../data/jobs";
---

<BaseLayout
	title="Jobs - Liven's Classic Maple Guide"
	description="Pick a Classic World job and read its full guide."
	currentPath="/jobs"
	theme="henesys"
>
	<section class="section-heading">
		<div>
			<span class="eyebrow">Class guides</span>
			<h1>Jobs directory</h1>
			<p class="lede">
				Every Classic World base class, its early-game feel, and where to go
				for the full write-up. Guides are added in vertical slices - Warrior
				lands first, the rest follow.
			</p>
		</div>
		<StatusBadge status="closed-test" verifiedOn="pre-launch" />
	</section>

	<div class="job-grid">
		{jobs.map((job) => <JobCard job={job} />)}
	</div>
</BaseLayout>

<style>
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.lede {
		max-width: 42rem;
		margin-top: 0.5rem;
		line-height: 1.6;
		color: #4f6653;
	}

	.job-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	@media (max-width: 800px) {
		.section-heading {
			align-items: stretch;
			flex-direction: column;
		}

		.job-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 500px) {
		.job-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
