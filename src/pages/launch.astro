---
import BaseLayout from "../layouts/BaseLayout.astro";
import LaunchTimeline from "../components/LaunchTimeline.astro";
import FoundersPackagesCard from "../components/FoundersPackagesCard.astro";
import SourceBadge from "../components/SourceBadge.astro";
import SourceCard from "../components/SourceCard.astro";
import VerificationNotice from "../components/VerificationNotice.astro";
import LastUpdated from "../components/LastUpdated.astro";
import { sources } from "../data/sources";
import { openQuestions, type QuestionCategory } from "../data/openQuestions";
import { inkwellInterviewUrl } from "../data/launch";

// Date the human editor last reviewed every claim on this page against
// its cited sources. Change this whenever content is verified again.
const LAST_CHECKED = "2026-10-21";

// Table of contents. Labels are phrased as visitor questions so the
// navigation itself answers "what can I learn here?" at a glance.
const jumpNav = [
	{ href: "#timeline", label: "When can I play?" },
	{ href: "#founders", label: "Founder's Access" },
	{ href: "#grand-launch", label: "Grand Launch" },
	{ href: "#mark-of-beta", label: "Mark of Beta" },
	{ href: "#events", label: "Launch events" },
	{ href: "#confirmed", label: "Confirmed features" },
	{ href: "#developer-vision", label: "Developer vision" },
	{ href: "#open-questions", label: "Not yet announced" },
	{ href: "#sources", label: "Sources" },
];

// Page-specific "what we know is coming" list. Kept small on purpose -
// this section grows as Nexon announces more. Every entry cites the
// source it came from (via slug).
const confirmedFeatures: {
	feature: string;
	detail: string;
	sourceSlug: string;
}[] = [
	// Removed 2026-10-21: "Ossyria region content" - inferred from the
	// Ossyria Exploration Report's TITLE, never stated in its text, and
	// contradicted by the Grand Launch release notes (Victoria Island,
	// Lv. 100 cap, no 3rd Job).
	{
		feature: "Grand Launch on October 21 at 6:00 PM UTC",
		detail: "11:00 AM Pacific. The game opens to all players. The Classic World client can only be downloaded on launch day (Nexon Launcher toggle); Steam players can pre-install the base game to shrink the patch.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Founder's Access early-play period (ended)",
		detail: "Two weeks of pre-launch play, October 6 through October 20, for Founder's Package holders. Progress carries into Grand Launch.",
		sourceSlug: "nexon-founders-access-release-notes",
	},
	{
		feature: "Mark of the Beta quest",
		detail: "'[Event] The Marks We Leave Behind' - Lv. 25+, start with Jay in Henesys, follow clues around Victoria Island to the Mark of the Beta. Runs October 21 through November 18.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Lv. 100 cap and two job advancements at Grand Launch",
		detail: "Maximum level stays Lv. 100. Only 1st Job (Lv. 10) and 2nd Job (Lv. 30) are documented - there is no 3rd Job at Grand Launch.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Six bosses at Grand Launch",
		detail: "Mano, Stumpy, Mushmom, Shade, Zombie Mushmom, and Jr. Balrog, all on Victoria Island. Stumpy is new versus the Founder's Access five. King Slime is fought at the end of the Kerning City Party Quest.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "New area: Perion Excavation Site",
		detail: "Eight listed monsters: Ghost Stump, Wooden Mask, Rocky Mask, Skeledog, Mummydog, Skeleton Soldier, Officer Skeleton, Commander Skeleton.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Housing",
		detail: "One home at a time in Henesys or Kerning City, bought with mesos from Bianca (Henesys) or Scarlett (Kerning City). Needs Citizenship grade Visitor or higher; shared across the account.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Lie Detector Test",
		detail: "Sold at the Citizen General Store (account-bound, 7 days). Use it on a character that seems to be behaving abnormally; a failed check sends them to the Truth Booth, where they must stay logged in for a set time with all normal play blocked.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Trading unlocks after Lv. 15",
		detail: "New accounts start trade-restricted. Trading unlocks 24 hours after a character on the account reaches Lv. 15.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Windows, macOS, and three languages",
		detail: "English, plus Spanish (Beta) and Korean (Beta) using machine translation; the UI, class names, cash items, and pets stay in English.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Forgotten Hollow opens in November",
		detail: "Not open at Grand Launch. The release notes give the month only, no exact date.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Cosmetics-only Cash Shop commitment",
		detail: "Inkwell has stated Classic World's Cash Shop will focus on cosmetics and 'appropriate convenience items', explicitly avoiding items that directly affect character stats or growth.",
		sourceSlug: "nexon-inkwell-future-of-classic-world",
	},
	{
		feature: "New boss in development (post-launch)",
		detail: "A new boss is being built for Classic World. It is NOT part of the Grand Launch content; it arrives in a later update. Full post-launch roadmap preview is scheduled for MapleStory Fest in October 2026.",
		sourceSlug: "nexon-inkwell-future-of-classic-world",
	},
	{
		feature: "Dedicated Classic World team with MapleStory veterans",
		detail: "Classic World has its own development team (built WITHOUT reducing Global MapleStory's team) led by Inkwell, with original MapleStory veterans Nemi (game design) and Dr. Lim (art direction) directly involved.",
		sourceSlug: "nexon-inkwell-future-of-classic-world",
	},
	{
		feature: "Deliberately slower update cadence",
		detail: "Content order will NOT follow original MapleStory's historical release sequence. 3rd Job and some regions release where it makes sense; some content is adapted; some is completely new. Internal design principle: 'the beauty of taking it slow.'",
		sourceSlug: "nexon-inkwell-future-of-classic-world",
	},
	{
		feature: "Three character slots per account",
		detail: "Up to 3 characters can be created per account. Deleting a character triggers an unspecified waiting period before removal from the account.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
	{
		feature: "Beauty Album system",
		detail: "A new Classic World system that lets you save hairstyles, face styles, and skin colors so you can return to a saved look without re-earning the cosmetics.",
		sourceSlug: "nexon-grand-launch-release-notes",
	},
];

// Group open questions by category for the "Not yet announced" section.
// Doing this in the frontmatter keeps the markup clean.
const questionsByCategory = openQuestions.reduce<
	Record<QuestionCategory, typeof openQuestions>
>((acc, q) => {
	(acc[q.category] ||= []).push(q);
	return acc;
}, {} as Record<QuestionCategory, typeof openQuestions>);
---

<BaseLayout
	title="Launch Hub - Liven's Classic Maple Guide"
	description="Everything confirmed about the Global MapleStory Classic World launch - and everything that is not - with every claim linked to its source."
	currentPath="/launch"
	theme="henesys"
	decorations={true}
>
	<header class="launch-hero">
		<span class="eyebrow">Launch Hub</span>
		<h1>When can I play, and what should I expect?</h1>
		<p>
			The launch-day corner of the field manual. Sourced answers for every
			Classic World launch question, plus the unknowns we're honest about -
			so you know exactly what is confirmed before the servers open.
		</p>
		<LastUpdated date={LAST_CHECKED} />
	</header>

	<nav class="jump-nav" aria-label="On this page">
		{jumpNav.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
	</nav>

	<!-- ============================================================ -->
	<section id="timeline" class="launch-section">
		<h2 class="section-panel-title">Launch timeline</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={["nexon-ossyria-exploration-report", "nexon-grand-launch-release-notes"]}
		/>
		<LaunchTimeline />
	</section>

	<!-- ============================================================ -->
	<section id="founders" class="launch-section">
		<h2 class="section-panel-title">Founder's Packages</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={[
				"nexon-founders-packages-on-sale",
				"nexon-founders-package-purchase-guide",
				"nexon-founders-access-release-notes",
			]}
		/>

		<FoundersPackagesCard />

		<div class="card prose">
			<p>
				<strong>Founder's Access</strong> began <strong>October 6 at
				6:00 PM UTC</strong> (= 11 AM Pacific) for the Orange Mushroom
				and Zakum tiers, giving those buyers roughly two weeks of early
				play before <strong>Grand Launch on October 21</strong>. Nexon
				has confirmed that all progression made during Founder's Access
				<em>carries into Grand Launch</em> - characters, levels, items,
				and mesos persist.
			</p>
			<p>
				One purchase per account per platform. Steam only sells the
				Zakum tier - if you want Snail or Orange Mushroom, buy through
				the Nexon webstore. Upgrade paths are available on the Nexon
				webstore only, and both new purchases and upgrades stopped at
				<strong>11:59 PM PDT on October 14</strong>.
			</p>
		</div>

		<p class="fa-ended-note">
			<strong>Founder's Access ended October 20.</strong> What it
			included (and the full Oct 3 manifest) is archived on
			<a href="/fa-access-status">FA Content Access Status</a>.
		</p>
	</section>

	<!-- ============================================================ -->
	<section id="grand-launch" class="launch-section">
		<h2 class="section-panel-title">Grand Launch</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={["nexon-grand-launch-release-notes", "nexon-classic-world-faq"]}
		/>

		<div class="card prose">
			<p>
				Servers open <strong>October 21, 2026 at 6:00 PM UTC</strong>
				(11:00 AM Pacific, 2 PM Eastern, 8 PM CEST, 4 AM AEST
				October 22). Founder's Access characters carry over.
			</p>
			<p>
				<strong>Getting in:</strong> the Classic World client can only
				be downloaded on launch day - in the Nexon Launcher, open
				MapleStory and switch on the <em>MapleStory Classic World</em>
				toggle. On Steam the games are bundled, so installing and
				updating the base MapleStory game ahead of time makes the
				launch-day patch much smaller.
			</p>
			<ul>
				<li><strong>Level cap stays Lv. 100.</strong> Job advancements at Lv. 10 and Lv. 30 only - no 3rd Job at Grand Launch.</li>
				<li><strong>Six bosses</strong> on Victoria Island: Mano, <strong>Stumpy</strong> (new), Mushmom, Shade, Zombie Mushmom, Jr. Balrog. See <a href="/bosses">Bosses</a>.</li>
				<li><strong>New area:</strong> the Excavation Site in Perion, with eight listed monsters.</li>
				<li><strong>New systems:</strong> Housing and the Lie Detector Test, both tied to <a href="/citizenship">Citizenship</a>.</li>
				<li><strong>Trading</strong> unlocks 24 hours after a character on the account reaches Lv. 15.</li>
				<li><strong>Kerning City Party Quest</strong> runs on Channels 3 - 12 only.</li>
				<li><strong>Not yet:</strong> Forgotten Hollow opens in November.</li>
			</ul>
			<p>
				Full breakdown, plus corrections to earlier versions of this
				site: <a href="/grand-launch-prep">What's in Grand Launch</a>.
			</p>
		</div>
	</section>

	<!-- ============================================================ -->
	<section id="mark-of-beta" class="launch-section">
		<h2 class="section-panel-title">Mark of Beta</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={["nexon-grand-launch-release-notes"]}
			note="Requirements and window are confirmed by the Grand Launch release notes. Whether the Mark is per character or per account is not stated."
		/>

		<div class="card prose">
			<p>
				The quest is <strong>'[Event] The Marks We Leave Behind'</strong>.
				Characters <strong>Lv. 25 and above</strong> accept it from
				<strong>Jay in Henesys</strong>, then follow its clues around
				Victoria Island to a hidden treasure: the <strong>Mark of the
				Beta</strong>.
			</p>
			<p>
				It runs <strong>October 21, 12:00 AM UTC through November 18,
				11:59 PM UTC</strong> - about four weeks, ending earlier than
				the "late November" we published from earlier announcements.
			</p>
		</div>
	</section>

	<!-- ============================================================ -->
	<section id="events" class="launch-section">
		<h2 class="section-panel-title">Launch events</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={["nexon-grand-launch-release-notes"]}
		/>

		<div class="card prose">
			<ul>
				<li><strong>The Journey Begins</strong> (Oct 21 - Nov 18): Lv. 10+ daily check-in. Trade 30 Maple Leaves to Maple Administrator for a 14-day reward ladder, once per day per account.</li>
				<li><strong>To Classic Beginners</strong>: Closed Online Test players who finished the event quests get Classic Beginnings rings by mail.</li>
				<li><strong>Halloween Candies</strong> and <strong>Slime Attack</strong> (Oct 28 - Nov 18): candy collection for Malady, with the Pumpkin Basket sword from a hidden mission.</li>
				<li><strong>GM events</strong>: jump-quest challenge Oct 22, Coconut Harvest Nov 6, Up And Up Dec 19 - each 12:00 to 2:00 AM UTC.</li>
			</ul>
			<p>
				Dates, reward tables, and the Magic Box item list:
				<a href="/launch-events">Grand Launch Event Calendar</a>.
			</p>
		</div>
	</section>

	<!-- ============================================================ -->
	<section id="confirmed" class="launch-section">
		<h2 class="section-panel-title">Confirmed launch features</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={[
				"nexon-grand-launch-release-notes",
				"nexon-founders-access-release-notes",
				"nexon-inkwell-future-of-classic-world",
			]}
			note="Only features currently backed by an official announcement appear here. The list will grow as Nexon publishes more."
		/>

		<ul class="confirmed-list">
			{confirmedFeatures.map((item) => (
				<li class="card confirmed-list__item">
					<div class="confirmed-list__body">
						<h3>{item.feature}</h3>
						<p>{item.detail}</p>
					</div>
					<a class="confirmed-list__source" href={`#sources-${item.sourceSlug}`}>
						<SourceBadge type="official-announcement" compact />
					</a>
				</li>
			))}
		</ul>
	</section>

	<!-- ============================================================ -->
	{/* Sprint 101: Developer vision section seeded from Inkwell's
	   Oct 2 2026 interview. These three pull quotes are the
	   editorially highest-signal moments from a 19-question
	   article - the monetization commitment (resolves a long-
	   standing community anxiety), the "beauty of taking it slow"
	   design intent (sets realistic expectations for update cadence),
	   and the long-term framing (reframes Classic World from a
	   nostalgia project into a 10-year investment). We quote
	   verbatim so the editorial responsibility stays with Nexon,
	   and link out to the full interview for context. */}
	<section id="developer-vision" class="launch-section">
		<h2 class="section-panel-title">Developer vision</h2>
		<VerificationNotice
			type="official-announcement"
			checkedOn={LAST_CHECKED}
			sourceSlugs={["nexon-inkwell-future-of-classic-world"]}
			note="Direct quotes from CPO Hanbyeol Oh ('Inkwell'), head of Global MapleStory, in Nexon's Oct 2 2026 interview. Links to the full 19-question article for context."
		/>

		<div class="card prose">
			<p>
				On October 2, 2026, Nexon published a long-form interview with
				<strong>Hanbyeol Oh (Inkwell)</strong>, CPO of Nexon America and
				head of Global MapleStory, covering the design philosophy, team
				structure, and long-term direction of Classic World. The three
				commitments below are the most consequential for players
				deciding whether to buy in. Each is quoted verbatim.
			</p>
		</div>

		<figure class="inkwell-pullquote">
			<blockquote>
				<p>
					In an experience like Classic World, the time players invest is
					itself a fundamental part of progression - the progression should
					feel earned through time and effort. Because of that, we want to
					avoid selling Cash Shop items that directly affect character stats
					or growth. Our basic approach is to focus primarily on cosmetics
					and appropriate convenience items.
				</p>
			</blockquote>
			<figcaption>
				<strong>Inkwell</strong> on monetization &middot;
				<span class="inkwell-pullquote__meaning">
					The clearest public commitment yet that Classic World will not
					become a stat-gated Cash Shop grind.
				</span>
			</figcaption>
		</figure>

		<figure class="inkwell-pullquote">
			<blockquote>
				<p>
					Internally, we sometimes talk about "the beauty of taking it
					slow." A lot of online games today are built around very fast
					progression, constant updates, and competition. We intentionally
					want Classic World to feel somewhat different. We want players to
					be able to step away for a while and come back without feeling,
					"I am hopelessly behind."
				</p>
			</blockquote>
			<figcaption>
				<strong>Inkwell</strong> on update cadence &middot;
				<span class="inkwell-pullquote__meaning">
					Sets expectations that Classic World will update slower than
					regular Global MapleStory - by design, not by neglect.
				</span>
			</figcaption>
		</figure>

		<figure class="inkwell-pullquote">
			<blockquote>
				<p>
					Classic World may look back toward the past, but ironically, I
					think of it as a project designed to help prepare MapleStory for
					the future.
				</p>
			</blockquote>
			<figcaption>
				<strong>Inkwell</strong> on the long-term framing &middot;
				<span class="inkwell-pullquote__meaning">
					The planning horizon Inkwell names explicitly in the interview is
					"3, 5, and 10 years from now" - not just the launch window.
				</span>
			</figcaption>
		</figure>

		<div class="card prose inkwell-footer">
			<p>
				Inkwell also confirmed the full post-launch roadmap preview is
				scheduled for <strong>MapleStory Fest in October 2026</strong>,
				including a new boss in development. Read the complete 19-question
				interview on
				<a
					href={inkwellInterviewUrl}
					rel="noopener external"
					target="_blank"
				>nexon.com</a>.
			</p>
		</div>
	</section>

	<!-- ============================================================ -->
	<section id="open-questions" class="launch-section">
		<h2 class="section-panel-title">Not yet announced</h2>
		<VerificationNotice
			type="awaiting-confirmation"
			checkedOn={LAST_CHECKED}
			note="These items are deliberately unresolved. When answers arrive from an official source, they move into a Confirmed section and are archived under Sources."
		/>

		{Object.entries(questionsByCategory).map(([category, questions]) => (
			<div class="open-questions__group">
				<h3 class="section-panel-subtitle">{category}</h3>
				<ul class="open-questions__list">
					{questions.map((q) => (
						<li class="card open-question">
							<div class="open-question__header">
								<h4>{q.question}</h4>
								<SourceBadge type="awaiting-confirmation" compact />
							</div>
							{q.detail && <p class="open-question__detail">{q.detail}</p>}
							{q.expectedFrom && (
								<p class="open-question__expected">
									<strong>Expected from:</strong> {q.expectedFrom}
								</p>
							)}
						</li>
					))}
				</ul>
			</div>
		))}
	</section>

	<!-- ============================================================ -->
	<section id="sources" class="launch-section">
		<h2 class="section-panel-title">Official sources</h2>
		<p class="section-lede">
			Every claim on this page traces back to one of these entries. Each
			card includes a summary, the confirmed facts we draw from it, and
			links to the original page and an archive snapshot.
		</p>

		<ul class="source-list">
			{sources.map((source) => (
				<li>
					<SourceCard source={source} />
				</li>
			))}
		</ul>
	</section>

	<footer class="page-footer">
		<LastUpdated date={LAST_CHECKED} label="Page last reviewed" />
	</footer>
</BaseLayout>

<style>
	/* Themed via CSS vars so this page picks up whatever theme
	   BaseLayout hands it. Today that's Henesys (green), but a
	   future Ossyria launch page could reuse this markup with
	   theme="lith" or similar - all colors would remap for free. */
	.launch-hero {
		padding: 2rem;
		background: var(--surface-hero-panel);
		border: 3px solid var(--border-hero);
		border-radius: 1.25rem;
		box-shadow: var(--shadow-panel);
	}

	.launch-hero h1 {
		font-size: clamp(2rem, 5vw, 3.4rem);
		margin: 0.4rem 0 0.8rem;
	}

	.launch-hero p {
		max-width: 46rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.jump-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.5rem 0;
		padding: 0.65rem;
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.75rem;
	}

	.jump-nav a {
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		background: var(--bg-ground);
		color: var(--accent-primary);
		font-size: 0.85rem;
		font-weight: bold;
		text-decoration: none;
	}

	.jump-nav a:hover,
	.jump-nav a:focus-visible {
		background: var(--surface-nav-hover);
		color: var(--text-on-nav);
	}

	.launch-section {
		margin-top: 2.5rem;
		scroll-margin-top: 1rem;
	}

	/* .launch-section > h2 typography is now handled by the shared
	   .section-panel-title class in global.css. This scoped rule is
	   intentionally omitted so the global styles win. */

	.section-lede {
		max-width: 46rem;
		margin-bottom: 1rem;
		line-height: 1.55;
		color: var(--text-brand-tagline);
	}

	.prose p {
		margin: 0 0 0.75rem;
		line-height: 1.65;
	}

	.prose p:last-child {
		margin-bottom: 0;
	}

	.prose a {
		color: var(--accent-primary-strong);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.fa-ended-note {
		margin: 1rem 0 0;
		padding: 0.7rem 1rem;
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.6rem;
	}

	.callout {
		margin-top: 1rem;
		padding: 0.8rem 1rem;
		border-radius: 0.5rem;
		border-left: 4px solid var(--accent-secondary-border);
		background: var(--accent-secondary);
		color: var(--text-on-nav);
		line-height: 1.55;
	}

	.callout--heads-up {
		border-left-color: var(--accent-secondary-border);
	}

	.confirmed-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.confirmed-list__item {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.confirmed-list__body {
		flex: 1;
		min-width: 16rem;
	}

	.confirmed-list__body h3 {
		margin: 0 0 0.25rem;
		font-size: 1.05rem;
		color: var(--text-heading);
	}

	.confirmed-list__body p {
		margin: 0;
		color: var(--text-brand-tagline);
		line-height: 1.5;
	}

	.confirmed-list__source {
		text-decoration: none;
	}

	/* Sprint 101: Inkwell pullquote styling. Figure/blockquote pair
	   intentionally OUTSIDE .card so pullquotes read as editorial
	   emphasis rather than another cardboard panel. Theme-shifting
	   via existing CSS vars so the quote picks up whatever theme
	   BaseLayout hands this page (Henesys today, something else
	   if we ever reskin /launch). Left border weight > top/right/
	   bottom to echo the hero FAQ callout on the homepage without
