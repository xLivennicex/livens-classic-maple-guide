---
// Citizenship page - imports the markdown guide as an Astro component
// and wraps it in GuideLayout. This is a mini-preview of Phase 3
// (proper content collections + MDX). Once that ships, this file
// becomes redundant and the .md moves into a collection.

import GuideLayout from "../layouts/GuideLayout.astro";
import { Content, frontmatter } from "../content/guides/citizenship.md";

const toc = [
	{ href: "#citizenship-at-a-glance", label: "At a glance" },
	{ href: "#how-to-unlock-citizenship", label: "Unlock" },
	{ href: "#choosing-henesys-or-kerning-city", label: "Choose your town" },
	{ href: "#how-contribution-works", label: "Contribution" },
	{ href: "#all-ten-citizenship-grades", label: "All 10 grades" },
	{ href: "#citizenship-shop-progression", label: "Shops" },
	{ href: "#citizenship-story-quests", label: "Story quests" },
	{ href: "#switching-towns", label: "Switching towns" },
	{ href: "#confirmed-town-benefits", label: "Confirmed rewards" },
	{ href: "#frequently-asked-questions", label: "FAQ" },
];

// Highlight rewards - the flagship items unlocked through citizenship,
// captured from COT2. Structured as data so future rewards (Mark of Beta,
// Founder's Access, etc.) can reuse the same visual pattern.
interface TownReward {
	town: "henesys" | "kerning";
	name: string;
	description: string;
}

interface BenefitCategory {
	heading: string;
	subtitle: string;
	icon: "earring" | "chair";
	items: TownReward[];
}

const confirmedBenefits: BenefitCategory[] = [
	{
		heading: "Citizen of Honor earrings",
		subtitle: "Town-specific equipment (Grade 10)",
		icon: "earring",
		items: [
			{
				town: "henesys",
				name: "Henesys Earrings",
				description:
					"Required level 57. 42 Magic Defense, +2% Critical Damage, +2 Avoidability. Five upgrade slots. Untradeable.",
			},
			{
				town: "kerning",
				name: "Kerning City Earrings",
				description:
					"Required level 57. 42 Magic Defense, +2% Critical Damage, +2 Avoidability. Five upgrade slots. Untradeable.",
			},
		],
	},
	{
		heading: "Resident chairs",
		subtitle: "Town-specific setup items (Grade 2)",
		icon: "chair",
		items: [
			{
				town: "henesys",
				name: "Henesys Resident's Chair",
				description:
					"Restores 20 HP and 5 MP every 10 seconds while seated. 10,000 mesos. Untradeable. One per town.",
			},
			{
				town: "kerning",
				name: "Kerning City Resident's Chair",
				description:
					"Restores 20 HP and 5 MP every 10 seconds while seated. 10,000 mesos. Untradeable. One per town.",
			},
		],
	},
];

const townLabels: Record<TownReward["town"], string> = {
	henesys: "Henesys Citizenship",
	kerning: "Kerning City Citizenship",
};

const guideSources = [
	"nexon-cot2-release-notes",
	"niameowdb-citizenship",
];
---

<GuideLayout
	title={`${frontmatter.title} - Liven's Classic Maple Guide`}
	description={frontmatter.description}
	currentPath="/citizenship"
	theme="lith"
	decorations={false}
	eyebrow="Systems Guide"
	heading="Citizenship"
	tagline="A new Classic World system: pledge to Henesys or Kerning City at level 12, earn contribution, climb ten grades, and unlock town-specific gear and buffs."
	verificationStatus="closed-test-info"
	lastChecked={frontmatter.lastUpdated}
	sourceSlugs={guideSources}
	verificationNote="All numeric details in this guide were recorded from Closed Online Test 2. Values may change before or during launch. Housing rules, exact contribution reset behavior, and some town-transfer fees were not fully confirmed in COT2."
	toc={toc}
>
	<article class="markdown-content">
		<Content />
	</article>

	<!-- Post-markdown visual summary: confirmed rewards at a glance.
	     Complements the detailed prose above with quick-scan cards. -->
	<section id="confirmed-town-benefits" class="benefits-section">
		<header class="benefits-section__header">
			<h2>Confirmed town benefits</h2>
			<span class="benefits-section__eyebrow">Recorded in COT2</span>
		</header>
		<p class="benefits-section__lede">
			The flagship items unlocked through citizenship progression.
			All figures come from Closed Online Test 2 and should be
			re-verified at launch.
		</p>

		<div class="benefits-grid">
			{confirmedBenefits.map((category) => (
				<article class="benefit-card">
					<header class="benefit-card__header">
						<span class="benefit-card__icon" aria-hidden="true">
							{category.icon === "earring" && (
								<svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="16" cy="9" r="4" fill="currentColor" />
									<path d="M16 13 L16 22" />
									<circle cx="16" cy="25" r="3" fill="currentColor" />
								</svg>
							)}
							{category.icon === "chair" && (
								<svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M8 6 L24 6 L24 18 L8 18 Z" fill="currentColor" fill-opacity="0.25" />
									<path d="M6 18 L26 18" />
									<path d="M9 18 L9 26 M23 18 L23 26" />
								</svg>
							)}
						</span>
						<div class="benefit-card__heading-block">
							<h3>{category.heading}</h3>
							<p class="benefit-card__subtitle">{category.subtitle}</p>
						</div>
					</header>

					<ul class="benefit-card__items">
						{category.items.map((item) => (
							<li class={`benefit-item benefit-item--${item.town}`}>
								<span class="benefit-item__town-label">
									{townLabels[item.town]}
								</span>
								<strong class="benefit-item__name">{item.name}</strong>
								<p class="benefit-item__description">{item.description}</p>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>
</GuideLayout>

<style>
	/* Scoped styles for raw markdown output. The Content component
	 * spits out plain HTML tags (h2, h3, p, ul, table, blockquote),
	 * so we target them inside .markdown-content to avoid leaking
	 * styles into the rest of the site. */

	.markdown-content {
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 1rem;
		padding: 1.5rem 1.75rem;
		line-height: 1.65;
		color: var(--text-body);
	}

	.markdown-content :global(h2) {
		margin: 2rem 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--border-divider);
		color: var(--text-heading);
		font-size: 1.5rem;
		scroll-margin-top: 1rem;
	}

	.markdown-content :global(h2:first-child) {
		margin-top: 0;
	}

	.markdown-content :global(h3) {
		margin: 1.5rem 0 0.5rem;
		color: var(--text-heading);
		font-size: 1.15rem;
	}

	.markdown-content :global(p) {
		margin: 0 0 0.85rem;
	}

	.markdown-content :global(ul),
	.markdown-content :global(ol) {
		margin: 0 0 0.85rem;
		padding-left: 1.5rem;
	}

	.markdown-content :global(li) {
		margin-bottom: 0.3rem;
	}

	.markdown-content :global(strong) {
		color: var(--text-heading);
	}

	.markdown-content :global(a) {
		color: var(--accent-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.markdown-content :global(a:hover) {
		color: var(--accent-primary-strong);
	}

	/* Blockquotes: used for "COT2 information" and "Simple recommendation"
	 * callouts in the guide. Style them as visible callout boxes. */
	.markdown-content :global(blockquote) {
		margin: 1rem 0;
		padding: 0.9rem 1.1rem;
		border-left: 4px solid var(--accent-secondary-border);
		background: var(--accent-secondary);
		color: var(--accent-secondary-text);
		border-radius: 0 0.5rem 0.5rem 0;
	}

	.markdown-content :global(blockquote p) {
		margin-bottom: 0.5rem;
	}

	.markdown-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	/* Tables: guide has multiple wide tables. Wrap in scroll on mobile
	 * so they don't blow out the layout. Style rows with alternating
	 * shading for scannability. */
	.markdown-content :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 1rem 0 1.25rem;
		border-collapse: collapse;
		font-size: 0.92rem;
	}

	.markdown-content :global(thead) {
		background: var(--surface-nav);
		color: var(--text-on-nav);
	}

	.markdown-content :global(th) {
		padding: 0.55rem 0.75rem;
		text-align: left;
		font-weight: bold;
		border: 1px solid var(--border-card-strong);
		white-space: nowrap;
	}

	.markdown-content :global(td) {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border-card);
		vertical-align: top;
	}

	.markdown-content :global(tbody tr:nth-child(even)) {
		background: rgba(0, 0, 0, 0.03);
	}

	/* Inline code and code blocks - not heavy in this guide but good
	 * to have styled for future ones. */
	.markdown-content :global(code) {
		padding: 0.1rem 0.35rem;
		background: rgba(0, 0, 0, 0.06);
		border-radius: 0.25rem;
		font-size: 0.9em;
	}

	.markdown-content :global(pre) {
		margin: 1rem 0;
		padding: 1rem;
		background: rgba(0, 0, 0, 0.05);
		border-radius: 0.5rem;
		overflow-x: auto;
	}

	.markdown-content :global(pre code) {
		padding: 0;
		background: none;
	}

	.markdown-content :global(hr) {
		margin: 2rem 0;
		border: none;
		border-top: 2px dashed var(--border-divider);
	}

	/* ---------- Confirmed town benefits section ---------- */

	.benefits-section {
		margin-top: 2.5rem;
		scroll-margin-top: 1rem;
	}

	.benefits-section__header {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: space-between;
		margin-bottom: 0.4rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--border-divider);
	}

	.benefits-section__header h2 {
		margin: 0;
		color: var(--text-heading);
	}

	.benefits-section__eyebrow {
		font-size: 0.72rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
	}

	.benefits-section__lede {
		max-width: 46rem;
		margin: 0 0 1rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1rem;
	}

	.benefit-card {
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.9rem;
		padding: 1.1rem 1.15rem 0.6rem;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
	}

	.benefit-card__header {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px dashed var(--border-divider);
		margin-bottom: 0.7rem;
	}

	.benefit-card__icon {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.6rem;
		background: var(--accent-secondary);
		border: 2px solid var(--accent-secondary-border);
		color: var(--accent-secondary-text);
	}

	.benefit-card__heading-block h3 {
		margin: 0 0 0.2rem;
		font-size: 1.1rem;
		color: var(--text-heading);
	}

	.benefit-card__subtitle {
		margin: 0;
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	.benefit-card__items {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.benefit-item {
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		/* Warm cream tint slightly lighter than the parent card so it
		 * reads as a nested surface without going gray/muddy. */
		background: rgba(255, 245, 220, 0.55);
		border-left: 4px solid var(--border-divider);
	}

	/* Per-town accent stripes so a scanner can spot which town they
	 * care about at a glance. Colors are intentionally not the exact
	 * theme colors to keep the section readable on the Lith palette. */
	.benefit-item--henesys {
		border-left-color: #7a9a4a; /* Henesys olive/prairie green */
	}

	.benefit-item--kerning {
		border-left-color: #8b3a3a; /* Kerning City deep rust/red */
	}

	.benefit-item__town-label {
		display: block;
		font-size: 0.7rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.15rem;
	}

	.benefit-item--henesys .benefit-item__town-label {
		color: #5a7a2a;
	}

	.benefit-item--kerning .benefit-item__town-label {
		color: #6b2a2a;
	}

	.benefit-item__name {
		display: block;
		color: var(--text-heading);
		font-size: 0.95rem;
		margin-bottom: 0.15rem;
	}

	.benefit-item__description {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--text-body);
	}
</style>
