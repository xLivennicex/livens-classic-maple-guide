---
/**
 * /party-quests/kerning-pq - the Kerning Party Quest walkthrough.
 *
 * Editorial content grounded against the datamine (Lakelis, quest
 * 10311, mob dossiers). KPQ maps themselves are instanced and not
 * present in the client-file dump, so stage layouts are described
 * narratively rather than shown as minimaps.
 *
 * Interactive: per-stage progress checkboxes persisted to
 * localStorage (so a returning player picks up mid-run), plus
 * copy-to-clipboard shout templates for LFG.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Sprite from "../../components/Sprite.astro";
import {
	KPQ_META, KPQ_REWARDS, KPQ_BONUS_ROOM_DROPS, KPQ_ENTRY_REQUIREMENTS,
	KPQ_STAGE1_QUESTIONS, KPQ_LFG_SHORTHAND, KPQ_MAGIC_BOX_POOL,
	kpqStages, partyCompositions,
} from "../../data/party-quests/kerning-pq";
import mobDossiers from "../../data/db/mobs.json";
import { mobHref } from "../../lib/mob-dedup";
import npcDossiers from "../../data/db/npcs.json";
import questDossiers from "../../data/db/quests.json";
import itemDossiers from "../../data/db/items.json";
import {
	mobSpriteSrcs, npcSpriteSrcs, itemIconUrl, themePlaceholderUrl,
} from "../../lib/maplestory-cdn";

// ==================== Cross-references ====================
// Look up once, use many times. Faster than scanning arrays per stage.
const mobByName = new Map(mobDossiers.map((m) => [m.name, m]));
const npcById = new Map(npcDossiers.map((n) => [n.id, n]));
const questById = new Map(questDossiers.map((q) => [String(q.id), q]));
const itemById = new Map(itemDossiers.map((i) => [i.id, i]));

const lakelis = npcById.get(KPQ_META.entryNpcId);
const kpqQuest = questById.get(KPQ_META.questId);

// Compact table of iconic mobs shown near the top of the page.
const iconicMobs = KPQ_META.iconicMobs
	.map((name) => mobByName.get(name))
	.filter(Boolean);

// Scroll rewards from the FIRST-RUN quest turn-in (Proof of
// Companionship) - resolve to real item dossiers so the sprites render.
const rewardScrolls = KPQ_REWARDS.firstRunQuest.itemChance.map((r) => ({
	...r,
	item: itemById.get(r.id),
}));

// Companion's Magic Box item (per-run reward for every member).
const magicBoxItem = itemById.get(KPQ_REWARDS.magicBox.itemId);

// Bonus Room 'chest' drops - resolve each mushroom's drop table to
// real item dossiers so sprites + hrefs render without template logic.
const bonusTables = [
	KPQ_BONUS_ROOM_DROPS.greenMushroom,
	KPQ_BONUS_ROOM_DROPS.hornyMushroom,
].map((table) => ({
	...table,
	drops: table.drops.map((d) => ({ ...d, item: itemById.get(d.itemId) })),
}));
---

<BaseLayout
	title="Kerning Party Quest (KPQ) Walkthrough - Liven's Classic Maple Guide"
	description={`Complete Classic Kerning Party Quest walkthrough. Levels ${KPQ_META.levelMin}-${KPQ_META.levelMax}, 6-person party. Stage-by-stage strategy for the 4 puzzle stages, Bonus Room, and King Slime boss. Grounded in the datamine: Lakelis, quest ${KPQ_META.questId}, ${iconicMobs.length} iconic mobs.`}
	currentPath="/world"
	theme="kerning"
	decorations={true}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/world">World Map</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<a href="/world/victoria-island">Victoria Island</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<a href="/world/victoria-island/kerning-city">Kerning City</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<span aria-current="page">Kerning Party Quest</span>
	</nav>

	<!-- ============================================================ -->
	<header class="kpq-hero">
		<div class="kpq-hero__body">
			<span class="eyebrow eyebrow--card">Party Quest walkthrough</span>
			<h1>{KPQ_META.name}</h1>
			<p class="tagline">{KPQ_META.tagline}</p>
			<div class="kpq-hero__facts">
				<div class="fact">
					<span class="fact__label">Level range</span>
					<strong>{KPQ_META.levelMin}-{KPQ_META.levelMax}</strong>
				</div>
				<div class="fact">
					<span class="fact__label">Party size</span>
					<strong>{KPQ_META.partySizeMin}-{KPQ_META.partySize}</strong>
				</div>
				<div class="fact">
					<span class="fact__label">Entry NPC</span>
					{lakelis
						? <a href={`/npcs/${lakelis.id}`}><strong>{lakelis.name}</strong></a>
						: <strong>{KPQ_META.entryNpc}</strong>}
				</div>
				<div class="fact">
					<span class="fact__label">Location</span>
					<a href={`/maps/${KPQ_META.entryMapId}`}><strong>{KPQ_META.town}</strong></a>
				</div>
				<div class="fact">
					<span class="fact__label">Run time</span>
					<strong>{KPQ_META.estimatedRunTime}</strong>
				</div>
			</div>
		</div>
		<div class="kpq-hero__lakelis">
			{lakelis?.name && (
				<Sprite
					srcs={npcSpriteSrcs(lakelis.wzId, lakelis.name)}
					alt={`${lakelis.name}, KPQ entry NPC`}
					placeholder={themePlaceholderUrl("kerning")}
					loading="eager"
				/>
			)}
			<span class="kpq-hero__lakelis-caption">
				Talk to {lakelis?.name ?? KPQ_META.entryNpc}
			</span>
		</div>
	</header>

	<!-- ============================================================ -->
	<!-- Entry requirements - what you need to walk through Lakelis's -->
	<!-- portal. Datamine-grounded (quests.json id 10311: no items, no -->
	<!-- fee, no prerequisite quest). Explicitly calls out the common -->
	<!-- 'do I need a ticket?' question with the answer: NO. -->
	<section class="entry-reqs" aria-labelledby="entry-heading">
		<h2 id="entry-heading" class="section-title">Entry requirements</h2>
		<p class="section-lede">
			KPQ's gate is social, not economic. The datamine confirms zero
			items consumed, zero mesos, no prerequisite quest - just a
			party of {KPQ_ENTRY_REQUIREMENTS.partySizeMin}+ at Lv{KPQ_ENTRY_REQUIREMENTS.levelMin}+ talking to
			<strong>{KPQ_ENTRY_REQUIREMENTS.entryNpc}</strong> at the
			<a href={`/maps/${KPQ_ENTRY_REQUIREMENTS.entryMapId}`}>{KPQ_ENTRY_REQUIREMENTS.entryMapName}</a> entrance.
		</p>
		<div class="entry-grid">
			<div class="entry-card">
				<span class="entry-card__label">Level</span>
				<strong>Lv {KPQ_ENTRY_REQUIREMENTS.levelMin}-{KPQ_ENTRY_REQUIREMENTS.levelMax}</strong>
				<span class="entry-card__meta">
					Lv {KPQ_ENTRY_REQUIREMENTS.levelMin}-{KPQ_ENTRY_REQUIREMENTS.levelMax} enforced in Classic World per community sources (Oct 9, 2026). Lv 31+ characters cannot enter.
				</span>
			</div>
			<div class="entry-card">
				<span class="entry-card__label">Party size</span>
				<strong>{KPQ_ENTRY_REQUIREMENTS.partySizeMin}-{KPQ_ENTRY_REQUIREMENTS.partySizeMax}</strong>
				<span class="entry-card__meta">
					Per CW community sources: at least {KPQ_ENTRY_REQUIREMENTS.partySizeMin} members required. Solo and duo parties cannot start the PQ.
				</span>
			</div>
			<div class="entry-card entry-card--highlight">
				<span class="entry-card__label">Ticket / item required</span>
				<strong>NONE</strong>
				<span class="entry-card__meta">
					Datamine-verified: zero items in <code>items.json</code> have
					<code>requiredByQuests[].questId === "10311"</code>. Unlike
					LPQ which requires Tickets to Construction Site, KPQ is
					walk-in.
				</span>
			</div>
			<div class="entry-card">
				<span class="entry-card__label">Entry fee</span>
				<strong>0 mesos</strong>
				<span class="entry-card__meta">Lakelis takes you in free.</span>
			</div>
			<div class="entry-card">
				<span class="entry-card__label">Prerequisite quest</span>
				<strong>None</strong>
				<span class="entry-card__meta">
					Fresh Lv{KPQ_ENTRY_REQUIREMENTS.levelMin} characters can enter
					immediately. No chain gating.
				</span>
			</div>
			<div class="entry-card">
				<span class="entry-card__label">Cooldown</span>
				<strong>None</strong>
				<span class="entry-card__meta">
					Farm back-to-back. Clear King Slime, turn in to Lakelis,
					re-queue.
				</span>
			</div>
		</div>
		<aside class="entry-footnote">
			<h3>Verification notes</h3>
			<ul>
				{KPQ_ENTRY_REQUIREMENTS.notes.map((note) => <li>{note}</li>)}
			</ul>
		</aside>
	</section>

	<!-- ============================================================ -->
	<section class="progress-panel" aria-labelledby="progress-heading">
		<h2 id="progress-heading" class="section-title">Your run tracker</h2>
		<p class="section-lede">
			Tick each stage as your party clears it. Progress saves to this
			browser only - no accounts, no server, no tracking. Click "Reset run"
			to start fresh.
		</p>
		<div class="progress-controls">
			<button type="button" class="btn" data-kpq-reset>Reset run</button>
			<span class="progress-summary" data-kpq-summary>0 / {kpqStages.length} stages cleared</span>
		</div>
	</section>

	<!-- ============================================================ -->
	<section class="mobs-strip" aria-labelledby="mobs-heading">
		<h2 id="mobs-heading" class="section-title">Mobs you'll fight</h2>
		<p class="section-lede">
			Only four mob types appear across Classic World KPQ, concentrated
			in Stage 1 and the boss stage. Stages 2-4 are pure puzzles with
			zero mobs. Click any card for the full dossier.
		</p>
		<div class="mobs-grid">
			{iconicMobs.map((m) => (
				<a class="mob-card" href={mobHref(m!.id)}>
					<Sprite
						srcs={mobSpriteSrcs(m!.id, m!.wzId)}
						alt=""
						placeholder={themePlaceholderUrl("kerning")}
					/>
					<span>{m!.name}</span>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="lfg-heading">
		<h2 id="lfg-heading" class="section-title">LFG shout templates</h2>
		<p class="section-lede">
			Classic World shouts use the <code>J&gt;</code> prefix for <strong>Joining</strong>
			(looking to join) and <code>S&gt;</code> for <strong>Selling</strong>.
			Don't mix them up - <code>S&gt;KPQ</code> reads as "selling a KPQ
			carry service", not "looking for a group".
		</p>

		<aside class="lfg-key">
			<div>
				<code class="lfg-key__prefix lfg-key__prefix--join">{KPQ_LFG_SHORTHAND.joining.prefix}</code>
				<strong>{KPQ_LFG_SHORTHAND.joining.meaning}</strong>
				<ul>
					{KPQ_LFG_SHORTHAND.joining.examples.map((e) => (
						<li><code>{e.shout}</code> — {e.meaning}</li>
					))}
				</ul>
			</div>
			<div>
				<code class="lfg-key__prefix lfg-key__prefix--sell">{KPQ_LFG_SHORTHAND.selling.prefix}</code>
				<strong>{KPQ_LFG_SHORTHAND.selling.meaning}</strong>
				<ul>
					{KPQ_LFG_SHORTHAND.selling.examples.map((e) => (
						<li><code>{e.shout}</code> — {e.meaning}</li>
					))}
				</ul>
			</div>
			<p class="lfg-key__note">{KPQ_LFG_SHORTHAND.note}</p>
		</aside>

		<div class="shout-grid">
			<button type="button" class="shout" data-kpq-copy="J>KPQ any @@@ (Lv21-30)">
				<code>J&gt;KPQ any @@@ (Lv21-30)</code>
				<span>Generic - looking to join, any 3 more</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="J>KPQ cleric slot open">
				<code>J&gt;KPQ cleric slot open</code>
				<span>Cleric priority (if that's you)</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="J>KPQ starting Lakelis now">
				<code>J&gt;KPQ starting Lakelis now</code>
				<span>Leader has party, needs one more</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="J>PQ any">
				<code>J&gt;PQ any</code>
				<span>Open to any party quest</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="J>Party any Lv25">
				<code>J&gt;Party any Lv25</code>
				<span>Looking for any party at your level</span>
			</button>
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="stage1-questions-heading">
		<h2 id="stage1-questions-heading" class="section-title">Stage 1 question pool - Cloto's trivia</h2>
		<p class="section-lede">
			Every non-leader party member gets one of these questions from
			Cloto in Stage 1. The answer is a number - that's how many
			Coupons you must hold when turning in. Collect <em>exactly</em>
			that count from Ligator kills, drop extras, talk to Cloto.
			Confirmed questions below are from MapleClassic Wiki + MeowDB
			(both Oct 9, 2026).
		</p>
		<table class="question-pool">
			<thead>
				<tr>
					<th>Cloto's question</th>
					<th>Answer</th>
					<th>Confidence</th>
				</tr>
			</thead>
			<tbody>
				{KPQ_STAGE1_QUESTIONS.map((q) => (
					<tr class={`question-pool__row question-pool__row--${q.confidence}`}>
						<td>
							<strong>{q.question}</strong>
							{"notes" in q && q.notes && <p class="question-pool__note">{q.notes}</p>}
						</td>
						<td class="question-pool__answer"><strong>{q.answer}</strong></td>
						<td>
							<span class={`conf conf--${q.confidence}`}>{q.confidence}</span>
						</td>
					</tr>
				))}
			</tbody>
		</table>
		<aside class="question-tip">
			<strong>Leader trick:</strong> the party leader never gets a question.
			If someone draws a harder question (35-coupon, say), swap party
			leader - old leader drops to member, re-talks to Cloto, draws a
			fresh question.
		</aside>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="stages-heading">
		<h2 id="stages-heading" class="section-title">Stage-by-stage walkthrough</h2>
		<p class="section-lede">
			Four puzzle stages, one boss stage (King Slime), and a bonus
			mushroom room. <strong>No waiting room in Classic World</strong> -
			you go from Lakelis in Kerning City straight to Stage 1. Inside
			the PQ, Cloto is the NPC you interact with for every stage check;
			Nella sits in the Bonus Room / Exit.
		</p>
		<div class="stages">
			{kpqStages.map((stage) => (
				<article class="stage" id={`stage-${stage.slug}`} data-kpq-stage={stage.slug}>
					<header class="stage__head">
						<label class="stage__check">
							<input type="checkbox" data-kpq-check />
							<span class="stage__check-label">
								{typeof stage.number === "number"
									? `Stage ${stage.number}`
									: stage.number === "bonus" ? "Bonus" : "Boss"}
							</span>
						</label>
						<div class="stage__title-row">
							<h3>{stage.title}</h3>
							{stage.timeLimit && <span class="stage__timer">{stage.timeLimit}</span>}
						</div>
						<p class="stage__subtitle">{stage.subtitle}</p>
					</header>

					<p class="stage__objective"><strong>Objective:</strong> {stage.objective}</p>

					{stage.mobs && stage.mobs.length > 0 && (
						<div class="stage__mobs">
							{stage.mobs.map((name) => {
								const m = mobByName.get(name);
								if (!m) return <span class="stage__mob-name">{name}</span>;
								return (
									<a class="stage__mob" href={mobHref(m.id)} title={name}>
										<Sprite
											srcs={mobSpriteSrcs(m.id, m.wzId)}
											alt=""
											placeholder={themePlaceholderUrl("kerning")}
										/>
										<span>{m.name}</span>
									</a>
								);
							})}
						</div>
					)}

					<div class="stage__columns">
						<div>
							<h4 class="stage__col-title">Strategy</h4>
							<ol class="stage__list">
								{stage.strategy.map((s) => <li>{s}</li>)}
							</ol>
						</div>
						<div>
							<h4 class="stage__col-title">Gotchas</h4>
							<ul class="stage__list stage__list--gotchas">
								{stage.gotchas.map((g) => <li>{g}</li>)}
							</ul>
						</div>
					</div>

					{stage.partyRoleTip && (
						<p class="stage__role-tip">
							<strong>Party role:</strong> {stage.partyRoleTip}
						</p>
					)}
				</article>
			))}
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="rewards-heading">
		<h2 id="rewards-heading" class="section-title">Rewards</h2>
		<p class="section-lede">
			Three reward tiers in Classic World KPQ: a per-run Magic Box
			for every member, a one-time quest reward for your first ever
			clear, and a chance drop from King Slime himself.
		</p>

		<div class="reward-grid">
			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">Per-run reward (every member, every clear)</span>
				<div class="magic-box">
					{magicBoxItem && (
						<Sprite
							srcs={[itemIconUrl(KPQ_REWARDS.magicBox.itemId)]}
							alt=""
							placeholder={themePlaceholderUrl("kerning")}
						/>
					)}
					<div>
						<strong>
							<a href={`/items/${KPQ_REWARDS.magicBox.itemId}`}>{KPQ_REWARDS.magicBox.name}</a>
						</strong>
						<p class="magic-box__note">{KPQ_REWARDS.magicBox.note}</p>
						<p class="magic-box__source">
							<em>Obtained:</em> {KPQ_REWARDS.magicBox.obtainedFrom}
						</p>
					</div>
				</div>
			</div>

			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">First-ever clear only - Proof of Companionship quest</span>
				<p class="reward-card__meta">
					Turn in to <strong>{KPQ_REWARDS.firstRunQuest.turnInNpc}</strong> at {KPQ_REWARDS.firstRunQuest.turnInMap}
					{kpqQuest && <> (<a href={`/quests/${KPQ_META.questId}`}>quest {KPQ_META.questId}</a>)</>}.
				</p>
				<div class="first-run-grid">
					<div><strong>{KPQ_REWARDS.firstRunQuest.exp.toLocaleString()}</strong><span>EXP</span></div>
					<div><strong>{KPQ_REWARDS.firstRunQuest.mesos}</strong><span>mesos</span></div>
					<div><strong>+{KPQ_REWARDS.firstRunQuest.fame}</strong><span>fame</span></div>
				</div>
				<p class="reward-card__meta">Plus one Intermediate Earring scroll (25% each):</p>
				<div class="scroll-grid">
					{rewardScrolls.map((r) => (
						<a class="scroll" href={r.item ? `/items/${r.item.id}` : "#"}>
							{r.item && (
								<Sprite
									srcs={[itemIconUrl(r.id)]}
									alt=""
									placeholder={themePlaceholderUrl("kerning")}
								/>
							)}
							<span>{r.name}</span>
							<em>{r.chance}</em>
						</a>
					))}
				</div>
				<p class="reward-card__meta"><em>{KPQ_REWARDS.firstRunQuest.note}</em></p>
			</div>

			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">Boss drop (chance from King Slime)</span>
				<ul class="reward-card__list">
					{KPQ_REWARDS.bossDrops.map((d) => (
						<li>
							<a href={`/items/${d.itemId}`}><strong>{d.name}</strong></a>
							{" — "}{d.note}
						</li>
					))}
				</ul>
			</div>

			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">Companion's Magic Box possible contents <em>(community-sourced, not weighted)</em></span>
				<p class="reward-card__meta">{KPQ_MAGIC_BOX_POOL.note}</p>
				<details class="magic-pool">
					<summary>Equipment ({KPQ_MAGIC_BOX_POOL.equipment.length})</summary>
					<ul>{KPQ_MAGIC_BOX_POOL.equipment.map((e) => <li>{e}</li>)}</ul>
				</details>
				<details class="magic-pool">
					<summary>Scrolls ({KPQ_MAGIC_BOX_POOL.scrolls.length})</summary>
					<ul>{KPQ_MAGIC_BOX_POOL.scrolls.map((s) => <li>{s}</li>)}</ul>
				</details>
				<details class="magic-pool">
					<summary>Potions ({KPQ_MAGIC_BOX_POOL.potions.length})</summary>
					<ul>{KPQ_MAGIC_BOX_POOL.potions.map((p) => <li>{p}</li>)}</ul>
				</details>
				<details class="magic-pool">
					<summary>Materials ({KPQ_MAGIC_BOX_POOL.materials.length})</summary>
					<ul>{KPQ_MAGIC_BOX_POOL.materials.map((m) => <li>{m}</li>)}</ul>
				</details>
			</div>
		</div>

		{KPQ_META.notableChanges && (
			<aside class="cw-callout" aria-labelledby="cw-changes-heading">
				<h3 id="cw-changes-heading" class="cw-callout__title">
					Classic World changes vs v83
				</h3>
				<ul class="cw-callout__list">
					{KPQ_META.notableChanges.map((change) => <li>{change}</li>)}
				</ul>
				<p class="cw-callout__source">
					Sourced from Classic World community (MapleClassic Wiki,
					MeowDB, MMOJUGG, Henesys.gg, MapleStory Quest - all dated
					Oct 8-9, 2026) + Founder's Access client datamine. Full
					rewrite 2026-10-12.
				</p>
			</aside>
		)}
	</section>

	<!-- ============================================================ -->
	<!-- Bonus Room 'chest' rewards - the mushroom pinata that follows -->
	<!-- the boss. Full drop tables sourced from mobs.json (Green Mushroom -->
	<!-- id 13, Horny Mushroom id 19), rendered as side-by-side tables -->
	<!-- sorted by datamine score (weighted drop rate, higher = more common). -->
	<section aria-labelledby="bonus-heading">
		<h2 id="bonus-heading" class="section-title">Bonus Room chest rewards</h2>
		<p class="section-lede">
			After King Slime dies the party teleports to a time-limited
			bonus room (map 80000500) with 36 passive mushroom reactors.
			Whack them for drops. These two tables are the complete
			datamined loot pool - scores are the raw drop weights from
			<code>mobs.json</code>; higher = more common.
		</p>
		<div class="bonus-grid">
			{bonusTables.map((t) => (
				<article class="bonus-card">
					<header class="bonus-card__head">
