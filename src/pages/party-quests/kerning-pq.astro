---
/**
 * /party-quests/kerning-pq - the Kerning Party Quest walkthrough.
 *
 * Editorial content grounded against the datamine (Lakelis, quest
 * 10311, mob dossiers). KPQ maps themselves are instanced and not
 * present in the client-file dump, so stage layouts are described
 * narratively rather than shown as minimaps.
 *
 * Interactive: per-stage progress checkboxes persisted to
 * localStorage (so a returning player picks up mid-run), plus
 * copy-to-clipboard shout templates for LFG.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Sprite from "../../components/Sprite.astro";
import {
	KPQ_META, KPQ_REWARDS,
	kpqStages, partyCompositions,
} from "../../data/party-quests/kerning-pq";
import mobDossiers from "../../data/db/mobs.json";
import npcDossiers from "../../data/db/npcs.json";
import questDossiers from "../../data/db/quests.json";
import itemDossiers from "../../data/db/items.json";
import {
	mobSpriteSrcs, npcSpriteSrcs, itemIconUrl, themePlaceholderUrl,
} from "../../lib/maplestory-cdn";

// ==================== Cross-references ====================
// Look up once, use many times. Faster than scanning arrays per stage.
const mobByName = new Map(mobDossiers.map((m) => [m.name, m]));
const npcById = new Map(npcDossiers.map((n) => [n.id, n]));
const questById = new Map(questDossiers.map((q) => [String(q.id), q]));
const itemById = new Map(itemDossiers.map((i) => [i.id, i]));

const lakelis = npcById.get(KPQ_META.entryNpcId);
const kpqQuest = questById.get(KPQ_META.questId);

// Compact table of iconic mobs shown near the top of the page.
const iconicMobs = KPQ_META.iconicMobs
	.map((name) => mobByName.get(name))
	.filter(Boolean);

// Scroll rewards from quest turn-in - resolve to real item dossiers
// so the sprites render.
const rewardScrolls = KPQ_REWARDS.itemChance.map((r) => ({
	...r,
	item: itemById.get(r.id),
}));
---

<BaseLayout
	title="Kerning Party Quest (KPQ) Walkthrough - Liven's Classic Maple Guide"
	description={`Complete Classic Kerning Party Quest walkthrough. Levels ${KPQ_META.levelMin}-${KPQ_META.levelMax}, 6-person party. Stage-by-stage strategy for the 4 puzzle stages, Bonus Room, and King Slime boss. Grounded in the datamine: Lakelis, quest ${KPQ_META.questId}, ${iconicMobs.length} iconic mobs.`}
	currentPath="/world"
	theme="kerning"
	decorations={true}
>
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href="/world">World Map</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<a href="/world/victoria-island">Victoria Island</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<a href="/world/victoria-island/kerning-city">Kerning City</a>
		<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
		<span aria-current="page">Kerning Party Quest</span>
	</nav>

	<!-- ============================================================ -->
	<header class="kpq-hero">
		<div class="kpq-hero__body">
			<span class="eyebrow">Party Quest walkthrough</span>
			<h1>{KPQ_META.name}</h1>
			<p class="tagline">{KPQ_META.tagline}</p>
			<div class="kpq-hero__facts">
				<div class="fact">
					<span class="fact__label">Level range</span>
					<strong>{KPQ_META.levelMin}-{KPQ_META.levelMax}</strong>
				</div>
				<div class="fact">
					<span class="fact__label">Party size</span>
					<strong>{KPQ_META.partySizeMin}-{KPQ_META.partySize}</strong>
				</div>
				<div class="fact">
					<span class="fact__label">Entry NPC</span>
					{lakelis
						? <a href={`/npcs/${lakelis.id}`}><strong>{lakelis.name}</strong></a>
						: <strong>{KPQ_META.entryNpc}</strong>}
				</div>
				<div class="fact">
					<span class="fact__label">Location</span>
					<a href={`/maps/${KPQ_META.entryMapId}`}><strong>{KPQ_META.town}</strong></a>
				</div>
				<div class="fact">
					<span class="fact__label">Run time</span>
					<strong>{KPQ_META.estimatedRunTime}</strong>
				</div>
			</div>
		</div>
		<div class="kpq-hero__lakelis">
			{lakelis?.name && (
				<Sprite
					srcs={npcSpriteSrcs(lakelis.wzId, lakelis.name)}
					alt={`${lakelis.name}, KPQ entry NPC`}
					placeholder={themePlaceholderUrl("kerning")}
					loading="eager"
				/>
			)}
			<span class="kpq-hero__lakelis-caption">
				Talk to {lakelis?.name ?? KPQ_META.entryNpc}
			</span>
		</div>
	</header>

	<!-- ============================================================ -->
	<section class="progress-panel" aria-labelledby="progress-heading">
		<h2 id="progress-heading" class="section-title">Your run tracker</h2>
		<p class="section-lede">
			Tick each stage as your party clears it. Progress saves to this
			browser only - no accounts, no server, no tracking. Click "Reset run"
			to start fresh.
		</p>
		<div class="progress-controls">
			<button type="button" class="btn" data-kpq-reset>Reset run</button>
			<span class="progress-summary" data-kpq-summary>0 / {kpqStages.length} stages cleared</span>
		</div>
	</section>

	<!-- ============================================================ -->
	<section class="mobs-strip" aria-labelledby="mobs-heading">
		<h2 id="mobs-heading" class="section-title">Mobs you'll fight</h2>
		<p class="section-lede">
			Six iconic Classic-era mobs appear across the KPQ. Click any card
			for the full dossier: drops, spawn maps, quest cross-refs.
		</p>
		<div class="mobs-grid">
			{iconicMobs.map((m) => (
				<a class="mob-card" href={`/mobs/${m!.id}`}>
					<Sprite
						srcs={mobSpriteSrcs(m!.id, m!.wzId)}
						alt=""
						placeholder={themePlaceholderUrl("kerning")}
					/>
					<span>{m!.name}</span>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="lfg-heading">
		<h2 id="lfg-heading" class="section-title">LFG shout templates</h2>
		<p class="section-lede">
			Copy any of these to your clipboard for the standard Kerning-town
			shouts. Adjust to taste; "S&gt;" means "seeking".
		</p>
		<div class="shout-grid">
			<button type="button" class="shout" data-kpq-copy="S> KPQ Any @@@@ (Lv 21-30)">
				<code>S&gt; KPQ Any @@@@ (Lv 21-30)</code>
				<span>Generic - any 4 more</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="S> KPQ Cleric + 3 more @@@@ Lv 21+">
				<code>S&gt; KPQ Cleric + 3 more @@@@ Lv 21+</code>
				<span>Needs a Cleric priority</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="LF> KPQ party - starting Lakelis now">
				<code>LF&gt; KPQ party - starting Lakelis now</code>
				<span>Looking for one - leader ready</span>
			</button>
			<button type="button" class="shout" data-kpq-copy="S> KPQ Bowman/Mage ranged DPS @@@@">
				<code>S&gt; KPQ Bowman/Mage ranged DPS @@@@</code>
				<span>Ranged rush comp</span>
			</button>
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="stages-heading">
		<h2 id="stages-heading" class="section-title">Stage-by-stage walkthrough</h2>
		<p class="section-lede">
			Six stages plus the Bonus Room and boss. Time limit resets per
			stage; if the party runs out of time, you're all sent back to
			Lakelis with no reward.
		</p>
		<div class="stages">
			{kpqStages.map((stage) => (
				<article class="stage" id={`stage-${stage.slug}`} data-kpq-stage={stage.slug}>
					<header class="stage__head">
						<label class="stage__check">
							<input type="checkbox" data-kpq-check />
							<span class="stage__check-label">
								{typeof stage.number === "number"
									? `Stage ${stage.number}`
									: stage.number === "bonus" ? "Bonus" : "Boss"}
							</span>
						</label>
						<div class="stage__title-row">
							<h3>{stage.title}</h3>
							{stage.timeLimit && <span class="stage__timer">{stage.timeLimit}</span>}
						</div>
						<p class="stage__subtitle">{stage.subtitle}</p>
					</header>

					<p class="stage__objective"><strong>Objective:</strong> {stage.objective}</p>

					{stage.mobs && stage.mobs.length > 0 && (
						<div class="stage__mobs">
							{stage.mobs.map((name) => {
								const m = mobByName.get(name);
								if (!m) return <span class="stage__mob-name">{name}</span>;
								return (
									<a class="stage__mob" href={`/mobs/${m.id}`} title={name}>
										<Sprite
											srcs={mobSpriteSrcs(m.id, m.wzId)}
											alt=""
											placeholder={themePlaceholderUrl("kerning")}
										/>
										<span>{m.name}</span>
									</a>
								);
							})}
						</div>
					)}

					<div class="stage__columns">
						<div>
							<h4 class="stage__col-title">Strategy</h4>
							<ol class="stage__list">
								{stage.strategy.map((s) => <li>{s}</li>)}
							</ol>
						</div>
						<div>
							<h4 class="stage__col-title">Gotchas</h4>
							<ul class="stage__list stage__list--gotchas">
								{stage.gotchas.map((g) => <li>{g}</li>)}
							</ul>
						</div>
					</div>

					{stage.partyRoleTip && (
						<p class="stage__role-tip">
							<strong>Party role:</strong> {stage.partyRoleTip}
						</p>
					)}
				</article>
			))}
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="rewards-heading">
		<h2 id="rewards-heading" class="section-title">Rewards</h2>
		<p class="section-lede">
			Payout from turning in <em>{KPQ_META.questName}</em>
			{kpqQuest && <> (<a href={`/quests/${KPQ_META.questId}`}>quest {KPQ_META.questId}</a>)</>}
			once you defeat King Slime.
		</p>
		<div class="reward-grid">
			<div class="reward-card">
				<span class="reward-card__label">Base EXP</span>
				<strong>{KPQ_REWARDS.exp.toLocaleString()}</strong>
				<span class="reward-card__meta">plus {KPQ_REWARDS.stageExp}</span>
			</div>
			<div class="reward-card">
				<span class="reward-card__label">Mesos</span>
				<strong>{KPQ_REWARDS.mesos}</strong>
			</div>
			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">Scroll drops (random)</span>
				<div class="scroll-grid">
					{rewardScrolls.map((r) => (
						<a class="scroll" href={r.item ? `/items/${r.item.id}` : "#"}>
							{r.item && (
								<Sprite
									srcs={[itemIconUrl(r.id)]}
									alt=""
									placeholder={themePlaceholderUrl("kerning")}
								/>
							)}
							<span>{r.name}</span>
							<em>{r.chance}</em>
						</a>
					))}
				</div>
			</div>
			<div class="reward-card reward-card--wide">
				<span class="reward-card__label">King Slime drop pool (per Classic-era experience)</span>
				<ul class="reward-card__list">
					{KPQ_REWARDS.bossDrops.map((d) => <li>{d}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- ============================================================ -->
	<section aria-labelledby="comps-heading">
		<h2 id="comps-heading" class="section-title">Party compositions</h2>
		<p class="section-lede">
			The KPQ doesn't enforce a specific class mix, but some comps run
			smoother than others. Advice below, not law.
		</p>
		<div class="comp-grid">
			{partyCompositions.map((c) => (
				<article class="comp-card">
					<h3>{c.name}</h3>
					<ul class="comp-card__classes">
						{c.classes.map((cls) => <li>{cls}</li>)}
					</ul>
					<p class="comp-card__strength"><strong>Strengths:</strong> {c.strengths}</p>
					<p class="comp-card__weakness"><strong>Weaknesses:</strong> {c.weaknesses}</p>
				</article>
			))}
		</div>
	</section>

	<!-- ============================================================ -->
	<section class="continue">
		<h2 class="section-title">Continue exploring</h2>
		<div class="continue-grid">
			<a class="continue-card" href={`/world/victoria-island/${KPQ_META.townSlug}`}>
				<span class="continue-card__dir">Back to</span>
				<strong>{KPQ_META.town} dossier</strong>
				<span>Every NPC, quest, and hunting map</span>
			</a>
			{lakelis && (
				<a class="continue-card" href={`/npcs/${lakelis.id}`}>
					<span class="continue-card__dir">NPC dossier</span>
					<strong>{lakelis.name}</strong>
					<span>Full quest list, spawn maps, source data</span>
				</a>
			)}
			{kpqQuest && (
				<a class="continue-card" href={`/quests/${KPQ_META.questId}`}>
					<span class="continue-card__dir">Quest dossier</span>
					<strong>{KPQ_META.questName}</strong>
					<span>Full quest data with rewards + chain info</span>
				</a>
			)}
			<a class="continue-card" href="/world/victoria-island">
				<span class="continue-card__dir">Region overview</span>
				<strong>Victoria Island</strong>
				<span>All 8 towns + the leveling arc</span>
			</a>
		</div>
	</section>
</BaseLayout>

<!-- Progress tracker + clipboard actions. Small enough to inline
     (~40 LOC); if we add a second PQ page it becomes worth
     extracting to a component. -->
<script is:inline>
(function () {
	const STORAGE_KEY = "livens-kpq-progress";
	const stageIds = Array.from(document.querySelectorAll("[data-kpq-stage]"))
		.map((el) => el.getAttribute("data-kpq-stage"));

	function load() {
		try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}"); }
		catch { return {}; }
	}
	function save(state) { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
	function updateSummary(state) {
		const done = stageIds.filter((id) => state[id]).length;
		const el = document.querySelector("[data-kpq-summary]");
		if (el) el.textContent = `${done} / ${stageIds.length} stages cleared`;
	}

	const state = load();
	for (const stage of document.querySelectorAll("[data-kpq-stage]")) {
		const id = stage.getAttribute("data-kpq-stage");
		const cb = stage.querySelector("[data-kpq-check]");
		if (!cb) continue;
		cb.checked = Boolean(state[id]);
		stage.classList.toggle("stage--done", Boolean(state[id]));
		cb.addEventListener("change", () => {
			state[id] = cb.checked;
			save(state);
			stage.classList.toggle("stage--done", cb.checked);
			updateSummary(state);
		});
	}
	updateSummary(state);

	document.querySelector("[data-kpq-reset]")?.addEventListener("click", () => {
		localStorage.removeItem(STORAGE_KEY);
		for (const cb of document.querySelectorAll("[data-kpq-check]")) cb.checked = false;
		for (const s of document.querySelectorAll("[data-kpq-stage]")) s.classList.remove("stage--done");
		updateSummary({});
	});

	// Clipboard buttons
	for (const btn of document.querySelectorAll("[data-kpq-copy]")) {
		btn.addEventListener("click", async () => {
			const text = btn.getAttribute("data-kpq-copy") ?? "";
			try {
				await navigator.clipboard.writeText(text);
				const orig = btn.querySelector("span")?.textContent ?? "";
				const s = btn.querySelector("span");
				if (s) s.textContent = "Copied!";
				setTimeout(() => { if (s) s.textContent = orig; }, 1200);
			} catch {
				alert("Copy failed - your browser blocked clipboard access.");
			}
		});
	}
})();
</script>

<style>
	.crumbs { margin: 1rem 0 0.5rem; font-size: 0.9rem; color: var(--text-secondary); }
	.crumbs__sep { margin: 0 0.4rem; color: var(--text-muted); }

	.eyebrow {
		display: inline-block; font-size: 0.75rem; font-weight: 700;
		letter-spacing: 0.08em; text-transform: uppercase;
		color: var(--accent-primary);
	}

	/* -------- Hero -------- */
	.kpq-hero {
		display: grid;
		grid-template-columns: 1fr minmax(auto, 14rem);
		gap: 1.5rem;
		padding: 1.75rem 2rem 1.5rem;
		background: linear-gradient(135deg,
			color-mix(in srgb, var(--accent-primary) 10%, #fefaf0),
			color-mix(in srgb, var(--accent-primary) 4%, #f5efd8));
		border: 2px solid var(--accent-primary);
		border-radius: 14px;
		margin: 0 0 1.5rem;
		align-items: start;
	}
	.kpq-hero h1 {
		font-size: 2.4rem; margin: 0.3rem 0 0.5rem;
		color: var(--accent-primary);
	}
	.tagline {
		font-style: italic; font-size: 1.05rem;
		margin: 0 0 1rem; color: var(--text-primary);
	}
	.kpq-hero__facts {
		display: flex; flex-wrap: wrap; gap: 0.75rem;
	}
	.fact {
		display: flex; flex-direction: column;
		padding: 0.5rem 0.9rem;
		background: rgba(255,255,255,0.75);
		border: 1px solid var(--border-card);
		border-left: 3px solid var(--accent-primary);
		border-radius: 6px;
		min-width: 6rem;
	}
	.fact__label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
	.fact strong { font-size: 1rem; color: var(--accent-primary); margin-top: 0.15rem; }
	.fact a { text-decoration: none; }
	.fact a strong { color: var(--accent-primary); }
	.kpq-hero__lakelis {
		display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
	}
	.kpq-hero__lakelis img {
		width: 100%; max-width: 8rem; height: auto;
		image-rendering: pixelated;
		background: rgba(0,0,0,0.03);
		border-radius: 6px; border: 2px solid var(--accent-primary);
		padding: 0.5rem;
	}
	.kpq-hero__lakelis-caption {
		font-size: 0.85rem; color: var(--accent-primary); font-weight: 600;
	}

	/* -------- Sections -------- */
	.section-title {
		font-size: 1.35rem; margin: 0 0 0.4rem;
		color: var(--accent-primary);
		border-left: 4px solid var(--accent-primary);
		padding-left: 0.75rem;
	}
	.section-lede { color: var(--text-secondary); margin: 0 0 1rem; max-width: 44rem; line-height: 1.55; }
	section { margin: 2rem 0; }

	/* -------- Progress panel -------- */
	.progress-panel { background: var(--surface-card); border: 1px solid var(--border-card); padding: 1rem 1.25rem; border-radius: 10px; }
	.progress-controls { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
	.btn {
		background: var(--accent-primary); color: #fff;
		border: none; padding: 0.4rem 0.9rem; border-radius: 6px;
		font-weight: 600; cursor: pointer;
	}
	.btn:hover { filter: brightness(0.92); }
	.progress-summary { font-size: 0.9rem; color: var(--text-secondary); font-weight: 600; }

	/* -------- Mob strip -------- */
	.mobs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 0.5rem;
	}
	.mob-card {
		display: flex; align-items: center; gap: 0.5rem;
		padding: 0.5rem 0.7rem;
		background: var(--surface-card); border: 1px solid var(--border-card);
		border-left: 3px solid var(--accent-primary);
		border-radius: 6px;
		text-decoration: none; color: var(--accent-primary); font-weight: 500;
		transition: transform 0.1s, border-color 0.1s;
	}
	.mob-card:hover { transform: translateY(-1px); border-color: var(--accent-primary); }
	.mob-card img { width: 32px; height: 32px; object-fit: contain; image-rendering: pixelated; }

	/* -------- Shout buttons -------- */
	.shout-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 0.5rem;
	}
	.shout {
		display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem;
		padding: 0.7rem 0.9rem;
		background: var(--surface-card); border: 1px solid var(--border-card);
		border-radius: 8px;
		font-family: inherit; text-align: left; cursor: pointer;
		transition: transform 0.1s, border-color 0.1s;
	}
	.shout:hover { transform: translateY(-1px); border-color: var(--accent-primary); }
	.shout code { font-size: 0.9rem; color: var(--accent-primary); font-weight: 600; }
	.shout span { font-size: 0.78rem; color: var(--text-muted); }

	/* -------- Stages -------- */
	.stages { display: flex; flex-direction: column; gap: 1rem; }
	.stage {
		background: var(--surface-card);
		border: 1px solid var(--border-card);
		border-left: 4px solid var(--accent-primary);
		border-radius: 10px;
		padding: 1rem 1.25rem;
		transition: opacity 0.15s, background 0.15s;
	}
	.stage--done {
		opacity: 0.6;
		background: color-mix(in srgb, var(--accent-primary) 6%, var(--surface-card));
	}
	.stage__head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
	.stage__check {
		display: inline-flex; align-items: center; gap: 0.4rem;
		font-size: 0.75rem; font-weight: 700;
		color: var(--accent-primary);
		text-transform: uppercase; letter-spacing: 0.05em;
		cursor: pointer;
	}
	.stage__check input {
		width: 1.1rem; height: 1.1rem;
		accent-color: var(--accent-primary);
		cursor: pointer;
	}
	.stage__title-row { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
	.stage__title-row h3 { margin: 0; color: var(--accent-primary); font-size: 1.15rem; }
	.stage__timer {
		font-size: 0.78rem; color: var(--text-muted);
		background: rgba(0,0,0,0.06); padding: 0.15rem 0.5rem; border-radius: 4px;
	}
