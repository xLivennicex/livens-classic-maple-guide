<!-- Progress tracker + clipboard actions. Small enough to inline
     (~40 LOC); if we add a second PQ page it becomes worth
     extracting to a component. -->
<script is:inline>
(function () {
	const STORAGE_KEY = "livens-kpq-progress";
	const stageIds = Array.from(document.querySelectorAll("[data-kpq-stage]"))
		.map((el) => el.getAttribute("data-kpq-stage"));

	function load() {
		try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}"); }
		catch { return {}; }
	}
	function save(state) { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
	function updateSummary(state) {
		const done = stageIds.filter((id) => state[id]).length;
		const el = document.querySelector("[data-kpq-summary]");
		if (el) el.textContent = `${done} / ${stageIds.length} stages cleared`;
	}

	const state = load();
	for (const stage of document.querySelectorAll("[data-kpq-stage]")) {
		const id = stage.getAttribute("data-kpq-stage");
		const cb = stage.querySelector("[data-kpq-check]");
		if (!cb) continue;
		cb.checked = Boolean(state[id]);
		stage.classList.toggle("stage--done", Boolean(state[id]));
		cb.addEventListener("change", () => {
			state[id] = cb.checked;
			save(state);
			stage.classList.toggle("stage--done", cb.checked);
			updateSummary(state);
		});
	}
	updateSummary(state);

	document.querySelector("[data-kpq-reset]")?.addEventListener("click", () => {
		localStorage.removeItem(STORAGE_KEY);
		for (const cb of document.querySelectorAll("[data-kpq-check]")) cb.checked = false;
		for (const s of document.querySelectorAll("[data-kpq-stage]")) s.classList.remove("stage--done");
		updateSummary({});
	});

	// Clipboard buttons
	for (const btn of document.querySelectorAll("[data-kpq-copy]")) {
		btn.addEventListener("click", async () => {
			const text = btn.getAttribute("data-kpq-copy") ?? "";
			try {
				await navigator.clipboard.writeText(text);
				const orig = btn.querySelector("span")?.textContent ?? "";
				const s = btn.querySelector("span");
				if (s) s.textContent = "Copied!";
				setTimeout(() => { if (s) s.textContent = orig; }, 1200);
			} catch {
				alert("Copy failed - your browser blocked clipboard access.");
			}
		});
	}
})();
</script>

