---
/**
 * /blog/[slug] - individual blog post page.
 *
 * Renders one entry from the `blog` content collection via BaseLayout
 * (not GuideLayout - blog posts are editorial and don't need the
 * TOC/verification apparatus that guides do). Comments render at the
 * bottom via the shared <Comments> component; per-post opt-out is
 * controlled by frontmatter's `commentsEnabled` flag.
 *
 * SEO: each post drives its own title + description via frontmatter.
 * If a post cites an external source (news commentary), the sourceUrl
 * gets a prominent "read the source" link near the top.
 */

import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import "../../styles/markdown-body.css";

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
};

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

// timeZone: "UTC" locks the format to the frontmatter's declared
// date. Without it, ISO date-only strings render as previous day in
// west-of-UTC build environments. See src/pages/blog/index.astro for
// the same guard.
function formatDate(iso: string): string {
	return new Date(iso).toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
		timeZone: "UTC",
	});
}
---

<BaseLayout
	title={`${d.title} - Liven's Classic Maple Guide`}
	description={d.description}
	currentPath="/blog"
	theme={d.theme}
	decorations={d.decorations}
>
	<article class="post post--card">
		<header class="post-header">
			<div class="post-header__meta">
				<a href="/blog" class="post-header__back">&larr; All posts</a>
				<span class={`post-header__category post-header__category--${d.category}`}>
					{d.category}
				</span>
			</div>
			<h1 class="post-header__title">{d.title}</h1>
			<div class="post-header__byline">
				<span>By <strong>{d.author}</strong></span>
				<span class="post-header__dot" aria-hidden="true">&middot;</span>
				<time datetime={d.publishedAt}>{formatDate(d.publishedAt)}</time>
				{d.updatedAt && (
					<>
						<span class="post-header__dot" aria-hidden="true">&middot;</span>
						<span class="post-header__updated">
							updated {formatDate(d.updatedAt)}
						</span>
					</>
				)}
			</div>
			{d.tags.length > 0 && (
				<div class="post-header__tags">
					{d.tags.map((t) => (
						<span class="post-header__tag">#{t}</span>
					))}
				</div>
			)}
		</header>

		{d.sourceUrl && (
			<aside class="source-cite" aria-label="Source article">
				<div class="source-cite__body">
					<span class="source-cite__label">Source article</span>
					<a
						class="source-cite__link"
						href={d.sourceUrl}
						target="_blank"
						rel="noopener noreferrer external"
					>
						{d.sourceLabel ?? d.sourceUrl} &rarr;
					</a>
				</div>
			</aside>
		)}

		<div class="markdown-body post-body">
			<Content />
		</div>

		<footer class="post-footer">
			<a class="post-footer__back" href="/blog">
				&larr; Back to all posts
			</a>
		</footer>

		{d.commentsEnabled && <Comments />}
	</article>
</BaseLayout>

<style>
	.post {
		max-width: 72ch;
		margin: 0 auto;
	}

	/* Blog posts sit inside a semi-opaque card so long-form editorial
	   text stays readable on top of busy themed backgrounds (Kerning
	   City's cityscape especially). Uses color-mix so a single rule
	   works across every theme's --surface-card value.

	   backdrop-filter is a progressive enhancement: browsers that
	   don't support it still get the semi-opaque background layer,
	   which is 92% of the readability win on its own.

	   Soft box-shadow provides the "glow" separation from the
	   background - low blur + high spread for a diffuse edge, not
	   a hard drop-shadow. */
	.post--card {
		background: color-mix(in srgb, var(--surface-card) 94%, transparent);
		backdrop-filter: blur(8px) saturate(1.05);
		-webkit-backdrop-filter: blur(8px) saturate(1.05);
		border: 1px solid var(--border-card);
		border-radius: 0.75rem;
		padding: 2rem 2.3rem 2.5rem;
		/* Shared design token - see --shadow-content-card in global.css.
		   Same soft theme-tinted glow as .prose in guides. */
		box-shadow: var(--shadow-content-card);
	}

	@media (max-width: 640px) {
		.post--card {
			padding: 1.3rem 1.15rem 1.6rem;
			border-radius: 0.6rem;
		}
	}

	.post-header {
		margin-bottom: 1.6rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-card);
	}
	.post-header__meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.9rem;
	}
	.post-header__back {
		font-size: 0.85rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.post-header__back:hover {
		color: var(--accent-primary);
	}
	.post-header__category {
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.18rem 0.55rem;
		background: var(--bg-cloud);
		border-radius: 999px;
		color: var(--text-heading);
	}
	.post-header__category--news { color: #2662c9; }
	.post-header__category--opinion { color: #b8730e; }
	.post-header__category--changelog { color: #158a4d; }
	.post-header__category--community { color: #7d3fb8; }

	.post-header__title {
		font-size: 2.1rem;
		line-height: 1.15;
		color: var(--text-heading);
		margin: 0 0 0.6rem;
		letter-spacing: -0.01em;
	}

	.post-header__byline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.post-header__byline strong {
		color: var(--text-heading);
	}
	.post-header__updated {
		font-style: italic;
	}

	.post-header__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.7rem;
	}
	.post-header__tag {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.source-cite {
		margin: 1rem 0 1.5rem;
		padding: 0.9rem 1.1rem;
		background: var(--bg-cloud);
		border: 1px solid var(--border-card);
		border-left: 4px solid var(--accent-primary);
		border-radius: 0.5rem;
	}
	.source-cite__body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.source-cite__label {
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}
	.source-cite__link {
		font-size: 1rem;
		font-weight: 600;
		color: var(--accent-primary);
		text-decoration: none;
		word-break: break-word;
	}
	.source-cite__link:hover {
		text-decoration: underline;
	}

	.post-body {
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.post-footer {
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-card);
	}
	.post-footer__back {
		font-size: 0.9rem;
		color: var(--accent-primary);
		text-decoration: none;
		font-weight: 600;
	}
	.post-footer__back:hover {
		text-decoration: underline;
	}
</style>
