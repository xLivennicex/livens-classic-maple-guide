---
/**
 * /blog - the blog index. Chronological (newest first) list of all
 * posts in the `blog` content collection.
 *
 * SEO target: 'liven maplestory classic blog', 'MSCW news commentary',
 * plus per-post SEO from each post's own metadata.
 *
 * Structure: featured posts (if any) get a hero card up top, everything
 * else lands in a chronological grid below. Category badges + tag
 * hints on every card so readers can scan by topic.
 */

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);

// Format an ISO date string as "Month Day, Year". Kept dead simple -
// no need to pull in a full i18n date lib for one presentation format.
// timeZone: "UTC" is CRITICAL - without it, `new Date("2026-09-12")`
// parses as UTC midnight, and toLocaleDateString in any west-of-UTC
// build environment renders the previous day. Locked to UTC for
// consistent, timezone-independent output.
function formatDate(iso: string): string {
	return new Date(iso).toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
		timeZone: "UTC",
	});
}
---

<BaseLayout
	title="Blog - Liven's Classic Maple Guide"
	description="News, opinion, and commentary from Liven on MapleStory Classic World. Editorial coverage of Nexon announcements, community reaction pieces, and site changelog updates."
	currentPath="/blog"
	theme="kerning"
	decorations={false}
>
	<section class="section-heading">
		<div>
			<span class="eyebrow">Editorial</span>
			<h1>Blog</h1>
			<p class="lede">
				News summaries, opinion pieces, and community commentary from
				Liven. Longer-form and more personal than the reference
				guides - and unlike the guides, blog posts are dated and can
				age. Comments are open on every post.
			</p>
		</div>
	</section>

	{featured.length > 0 && (
		<section class="featured-section">
			<h2 class="section-title">Featured</h2>
			<div class="featured-grid">
				{featured.map((p) => (
					<a class={`post-card post-card--featured post-card--${p.data.category}`} href={`/blog/${p.id}`}>
						<div class="post-card__head">
							<span class={`post-card__category post-card__category--${p.data.category}`}>
								{p.data.category}
							</span>
							<time class="post-card__date" datetime={p.data.publishedAt}>
								{formatDate(p.data.publishedAt)}
							</time>
						</div>
						<h3 class="post-card__title">{p.data.title}</h3>
						<p class="post-card__excerpt">
							{p.data.excerpt ?? p.data.description}
						</p>
						{p.data.tags.length > 0 && (
							<div class="post-card__tags">
								{/* Featured cards get the whole tag set - they're rarer and have more visual room */}
								{p.data.tags.map((t) => (
									<span class="post-card__tag">#{t}</span>
								))}
							</div>
						)}
						<span class="post-card__cta">Read the post -&gt;</span>
					</a>
				))}
			</div>
		</section>
	)}

	<section class="all-section">
		<h2 class="section-title">
			{featured.length > 0 ? "All posts" : "Latest posts"}
		</h2>
		{rest.length === 0 && featured.length === 0 ? (
			<p class="empty-state">
				No blog posts yet. Check back soon - the first editorial is
				on its way.
			</p>
		) : (
			<div class="posts-grid">
				{rest.map((p) => (
					<a class={`post-card post-card--${p.data.category}`} href={`/blog/${p.id}`}>
						<div class="post-card__head">
							<span class={`post-card__category post-card__category--${p.data.category}`}>
								{p.data.category}
							</span>
							<time class="post-card__date" datetime={p.data.publishedAt}>
								{formatDate(p.data.publishedAt)}
							</time>
						</div>
						<h3 class="post-card__title">{p.data.title}</h3>
						<p class="post-card__excerpt">
							{p.data.excerpt ?? p.data.description}
						</p>
						{p.data.tags.length > 0 && (
							<div class="post-card__tags">
								{p.data.tags.slice(0, 3).map((t) => (
									<span class="post-card__tag">#{t}</span>
								))}
							</div>
						)}
						<span class="post-card__cta">Read the post -&gt;</span>
					</a>
				))}
			</div>
		)}
	</section>
</BaseLayout>

<style>
	.section-heading {
		max-width: 68ch;
		margin-bottom: 2rem;
	}
	.eyebrow {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-primary);
		margin-bottom: 0.4rem;
	}
	.lede {
		font-size: 1.05rem;
		color: var(--text-body);
		margin-top: 0.5rem;
		line-height: 1.55;
	}

	.section-title {
		font-size: 1.4rem;
		color: var(--text-heading);
		margin: 1.6rem 0 0.9rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border-card);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
		margin-bottom: 1.5rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1rem;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.1rem 1.2rem;
		background: var(--surface-card);
		border: 1px solid var(--border-card);
		border-left: 4px solid var(--text-muted);
		border-radius: 0.6rem;
		text-decoration: none;
		color: inherit;
		transition: transform 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease;
	}
	.post-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px color-mix(in srgb, var(--accent-primary) 18%, transparent);
	}
	.post-card--featured {
		border-left-width: 6px;
		background: linear-gradient(
			to bottom right,
			var(--surface-card),
			color-mix(in srgb, var(--accent-primary) 6%, var(--surface-card))
		);
	}
	.post-card--news { border-left-color: #2662c9; }
	.post-card--opinion { border-left-color: #b8730e; }
	.post-card--changelog { border-left-color: #158a4d; }
	.post-card--community { border-left-color: #7d3fb8; }

	.post-card__head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
	}
	.post-card__category {
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.18rem 0.5rem;
		background: var(--bg-cloud);
		border-radius: 999px;
		color: var(--text-heading);
	}
	.post-card__category--news { color: #2662c9; }
	.post-card__category--opinion { color: #b8730e; }
	.post-card__category--changelog { color: #158a4d; }
	.post-card__category--community { color: #7d3fb8; }

	.post-card__date {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.post-card__title {
		font-size: 1.15rem;
		color: var(--text-heading);
		margin: 0.1rem 0 0.15rem;
		line-height: 1.3;
	}
	.post-card--featured .post-card__title {
		font-size: 1.4rem;
	}
	.post-card__excerpt {
		font-size: 0.92rem;
		color: var(--text-body);
		line-height: 1.5;
		margin: 0;
	}
	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.2rem;
	}
	.post-card__tag {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}
	.post-card__cta {
		margin-top: auto;
		font-size: 0.86rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.empty-state {
		background: var(--bg-cloud);
		border: 1px dashed var(--border-card);
		padding: 1.5rem;
		text-align: center;
		border-radius: 0.5rem;
		color: var(--text-muted);
	}
</style>
