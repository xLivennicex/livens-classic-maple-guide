---
/**
 * /items - the comprehensive item catalog, GROUPED by
 * (category, subcategory) into collapsible <details> sections.
 *
 * Filter dimensions:
 *   1. Category chips: Equipment / Consumable / Etc / Setup +
 *      "Has editorial"
 *   2. Class chips: Warrior / Mage / Bowman / Thief - includes
 *      universal items (blank reqJob), "All", and combos.
 *   3. Weapon-type chips (1H Sword / Bow / Wand / etc): appear
 *      as a secondary row and filter WEAPON rows only. Rows
 *      in non-weapon subcategories are unaffected.
 *   4. Text search: matches name or WZ ID.
 *
 * DOM strategy:
 *   - Pre-render one <details class="cat-section"> per group.
 *   - Filters set `hidden` on rows client-side.
 *   - After each filter pass, JS hides any section whose rows
 *     are all hidden. Zero <details>-with-empty-content flicker.
 *
 * Zen of Python: "flat is better than nested, but grouped is
 * better than a 4000-row wall of undifferentiated rows."
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import indexData from "../../data/db/index.json";
import generatedAt from "../../data/db/generated-at.json";
import { itemIconUrl } from "../../lib/maplestory-cdn";

const { items } = indexData;

// Group items by (category, subCategory). Use "Uncategorized" as
// the fallback bucket for items with no subCategory (mostly rare
// Setup entries). The GROUP_ORDER controls visual ordering - a
// player scans Equipment first, then Consumable, then materials.
const GROUP_ORDER: Array<[string, string[]]> = [
	["Equipment", ["Weapon", "Overall", "Top", "Bottom", "Shoes", "Glove", "Hat", "Cape", "Shield", "Earring", "Face Accessory", "Eye Accessory", "Pendant", "Belt", "Ring"]],
	["Consumable", ["Consumable"]],
	["Etc", ["Etc"]],
	["Setup", ["Setup"]],
];

// Bucket items by category+sub. Preserves item.id sort within each.
const groups: Record<string, Record<string, typeof items>> = {};
for (const item of items.sort((a, b) => a.id - b.id)) {
	const cat = item.category ?? "Unknown";
	const sub = item.sub ?? "Uncategorized";
	if (!groups[cat]) groups[cat] = {};
	if (!groups[cat][sub]) groups[cat][sub] = [];
	groups[cat][sub].push(item);
}

// Flatten to an ordered array of { category, sub, items[] } sections
// so the template can just .map() them. Any subcategory not in the
// explicit GROUP_ORDER is appended alpha at the end of its category.
const sections: Array<{ category: string; sub: string; items: typeof items }> = [];
for (const [cat, subOrder] of GROUP_ORDER) {
	const catGroups = groups[cat];
	if (!catGroups) continue;
	const seen = new Set<string>();
	for (const sub of subOrder) {
		if (catGroups[sub]) {
			sections.push({ category: cat, sub, items: catGroups[sub] });
			seen.add(sub);
		}
	}
	// Trailing "unknown subs" for this category, alpha order.
	for (const sub of Object.keys(catGroups).sort()) {
		if (!seen.has(sub)) {
			sections.push({ category: cat, sub, items: catGroups[sub] });
		}
	}
}
// Catch categories not in GROUP_ORDER (defensive).
for (const cat of Object.keys(groups).sort()) {
	if (GROUP_ORDER.some(([c]) => c === cat)) continue;
	for (const sub of Object.keys(groups[cat]).sort()) {
		sections.push({ category: cat, sub, items: groups[cat][sub] });
	}
}

const categories = [...new Set(items.map((i) => i.category))].sort();
const editorialCount = items.filter((i) => i.hasEditorial).length;

// Class-count helper (unchanged from prior round).
function classItemCount(cls: string): number {
	return items.filter((i) => {
		const j = i.reqJob ?? "";
		return j === "" || j === "All" || j === cls || j.split("/").includes(cls);
	}).length;
}

const CLASSES = [
	{ key: "Warrior", theme: "perion" },
	{ key: "Mage", theme: "ellinia" },
	{ key: "Bowman", theme: "henesys" },
	{ key: "Thief", theme: "kerning" },
] as const;

// Weapon-type list built from the datamine. Ordered class-first so
// the chip row reads Warrior weapons -> Mage -> Bowman -> Thief.
const WEAPON_TYPES = [
	"1H Sword", "2H Sword", "1H Axe", "2H Axe",
	"1H Blunt Weapon", "2H Blunt Weapon", "Spear", "Polearm",
	"Wand", "Staff",
	"Bow", "Crossbow",
	"Claw", "Dagger",
];

const buildDate = new Date(generatedAt.timestamp).toISOString().slice(0, 10);
---

<BaseLayout
	title="Items - Liven's Classic Maple Guide"
	description="Complete catalog of every item in MapleStory Classic World - grouped by subcategory, filterable by class and weapon type, with editorial context."
	currentPath="/items"
	theme="henesys"
>
	<section class="section-heading">
		<div>
			<span class="eyebrow">Reference catalog</span>
			<h1>Items</h1>
			<p class="lede">
				{items.length.toLocaleString()} items grouped into
				{sections.length} category / subcategory sections.
				{editorialCount} have hand-written editorial pages.
				Filter by category, class, or weapon type - collapse
				sections you're not browsing.
			</p>
			<p class="build-meta">
				Catalog regenerated <strong>{buildDate}</strong>.
				Rerun <code>npm run db</code> to refresh from
				<a href="https://osmsdataexplorer.com" target="_blank" rel="noopener">osmsdataexplorer.com</a>.
			</p>
		</div>
		<StatusBadge status="closed-test" verifiedOn="pre-launch" />
	</section>

	<section class="class-strip">
		<h2 class="class-strip__title">Browse by class</h2>
		<p class="class-strip__lede">
			Show only items your class can equip. Consumables and
			shared items are included automatically.
		</p>
		<div class="class-strip__grid">
			{CLASSES.map((c) => (
				<a
					class={`class-tile class-tile--${c.theme} interactive-card`}
					href={`/items/?class=${c.key}`}
				>
					<span class="class-tile__name">{c.key}</span>
					<span class="class-tile__count">
						{classItemCount(c.key).toLocaleString()} items
					</span>
				</a>
			))}
		</div>
	</section>

	<div class="controls">
		<label class="search-label">
			<span>Search</span>
			<input
				id="item-search"
				type="search"
				placeholder="Item name or WZ ID..."
				autocomplete="off"
			/>
		</label>

		<div class="filter-row">
			<span class="filter-row__label">Category:</span>
			<div class="filter-chips" id="category-chips">
				<button class="chip chip--active" data-category="">All ({items.length})</button>
				{categories.map((cat) => (
					<button class="chip" data-category={cat}>
						{cat} ({items.filter((i) => i.category === cat).length})
					</button>
				))}
				<button class="chip" data-editorial="true">
					With editorial ({editorialCount})
				</button>
			</div>
		</div>

		<div class="filter-row">
			<span class="filter-row__label">Class:</span>
			<div class="filter-chips" id="class-chips">
				<button class="chip chip--active" data-class="">Any</button>
				{CLASSES.map((c) => (
					<button class="chip" data-class={c.key}>
						{c.key} ({classItemCount(c.key).toLocaleString()})
					</button>
				))}
			</div>
		</div>

		<div class="filter-row filter-row--weapon-type" id="weapon-type-row">
			<span class="filter-row__label">Weapon type:</span>
			<div class="filter-chips" id="weapon-chips">
				<button class="chip chip--active" data-weapon="">Any</button>
				{WEAPON_TYPES.map((wt) => (
					<button class="chip" data-weapon={wt}>{wt}</button>
				))}
			</div>
		</div>

		<div class="expand-controls">
			<button type="button" class="expand-btn" data-action="expand-all">
				Expand all sections
			</button>
			<button type="button" class="expand-btn" data-action="collapse-all">
				Collapse all sections
			</button>
		</div>
	</div>

	<div class="result-count" id="result-count">
		Showing all {items.length.toLocaleString()} items across {sections.length} sections
	</div>

	<div class="catalog">
		{sections.map((sec) => (
			<details
				class="cat-section"
				data-category={sec.category}
				data-sub={sec.sub}
				open
			>
				<summary class="cat-header">
					<span class="cat-header__chevron" aria-hidden="true">&rsaquo;</span>
					<h2 class="cat-header__title">
						{sec.category} <span class="cat-header__sep">/</span> {sec.sub}
					</h2>
					<span class="cat-header__count">
						<span class="cat-header__visible-count">{sec.items.length}</span>
						<span class="cat-header__total">/ {sec.items.length}</span>
					</span>
				</summary>
				<div class="cat-table-wrap">
					<table class="item-table">
						<thead>
							<tr>
								<th>Icon</th>
								<th>WZ ID</th>
								<th>Name</th>
								<th>Weapon type</th>
								<th>Req Lv</th>
								<th>Job</th>
								<th>NPC price</th>
								<th>Sources</th>
								<th>Ed.</th>
							</tr>
						</thead>
						<tbody>
							{sec.items.map((item) => (
								<tr
									class="item-row"
									data-name={item.name.toLowerCase()}
									data-id={item.id}
									data-category={item.category}
									data-sub={item.sub ?? ""}
									data-job={item.reqJob ?? ""}
									data-weapon-type={item.weaponType ?? ""}
									data-editorial={item.hasEditorial ? "1" : "0"}
								>
									<td class="col-icon">
										<img
											src={itemIconUrl(item.id)}
											alt=""
											width="24"
											height="24"
											loading="lazy"
											onerror="this.style.visibility='hidden'"
										/>
									</td>
									<td class="col-id">
										<a href={`/items/${item.id}`}>{item.id}</a>
									</td>
									<td class="col-name">
										<a href={`/items/${item.id}`}>{item.name}</a>
									</td>
									<td class="col-wt">{item.weaponType ?? "-"}</td>
									<td class="col-lv">{item.reqLevel ?? "-"}</td>
									<td class="col-job">{item.reqJob || "-"}</td>
									<td class="col-price">
										{item.price != null ? item.price.toLocaleString() : "-"}
									</td>
									<td class="col-sources">
										{item.acquisitionCount > 0 ? item.acquisitionCount : "-"}
									</td>
									<td class="col-editorial">
										{item.hasEditorial ? "yes" : ""}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</details>
		))}
	</div>

	<script is:inline>
		(function () {
			const search = document.getElementById("item-search");
			const catChips = document.getElementById("category-chips");
			const clsChips = document.getElementById("class-chips");
			const wtChips = document.getElementById("weapon-chips");
			const weaponRow = document.getElementById("weapon-type-row");
			const resultCount = document.getElementById("result-count");
			const catSections = Array.from(document.querySelectorAll(".cat-section"));

			// Four orthogonal filter axes.
			let activeCategory = "";
			let editorialOnly = false;
			let activeClass = "";
			let activeWeaponType = "";
			let searchTerm = "";

			// Class-match rule (docstring in prior round). Empty selection
			// or blank/"All"/direct/combo/split all count as match.
			function classMatches(itemJob, sel) {
				if (!sel) return true;
				if (!itemJob) return true;
				if (itemJob === "All" || itemJob === sel) return true;
				return itemJob.split("/").includes(sel);
			}

			function applyFilters() {
				let totalVisible = 0;
				let visibleSections = 0;

				for (const section of catSections) {
					const secCategory = section.dataset.category;
					const secSub = section.dataset.sub;
					// Category chip hides whole sections.
					const catAllows = !activeCategory || secCategory === activeCategory;

					if (!catAllows) {
						section.hidden = true;
						continue;
					}

					const rows = section.querySelectorAll(".item-row");
					let sectionVisible = 0;
					for (const row of rows) {
						const matchesEditorial =
							!editorialOnly || row.dataset.editorial === "1";
						const matchesClass = classMatches(row.dataset.job, activeClass);
						// Weapon-type filter only affects weapon rows.
						// Non-weapon rows are unaffected.
						const isWeapon = secSub === "Weapon";
						const matchesWeaponType =
							!activeWeaponType ||
							!isWeapon ||
							row.dataset.weaponType === activeWeaponType;
						const matchesSearch =
							!searchTerm ||
							row.dataset.name.includes(searchTerm) ||
							row.dataset.id.includes(searchTerm);
						const show =
							matchesEditorial && matchesClass && matchesWeaponType && matchesSearch;
						row.hidden = !show;
						if (show) sectionVisible++;
					}

					// Update per-section visible count.
					const visSpan = section.querySelector(".cat-header__visible-count");
					if (visSpan) visSpan.textContent = sectionVisible.toString();

					if (sectionVisible === 0) {
						section.hidden = true;
					} else {
						section.hidden = false;
						visibleSections++;
						totalVisible += sectionVisible;
					}
				}

				resultCount.textContent = `Showing ${totalVisible.toLocaleString()} items across ${visibleSections} sections`;
			}

			function syncUrl() {
				const params = new URLSearchParams(window.location.search);
				if (activeClass) params.set("class", activeClass);
				else params.delete("class");
				if (activeWeaponType) params.set("weapon", activeWeaponType);
				else params.delete("weapon");
				const newUrl =
					window.location.pathname +
					(params.toString() ? "?" + params.toString() : "") +
					window.location.hash;
				window.history.replaceState({}, "", newUrl);
			}

			search.addEventListener("input", (e) => {
				searchTerm = e.target.value.toLowerCase().trim();
				applyFilters();
			});

			catChips.addEventListener("click", (e) => {
				const chip = e.target.closest(".chip");
				if (!chip) return;
				catChips.querySelectorAll(".chip").forEach((c) =>
					c.classList.remove("chip--active"),
				);
				chip.classList.add("chip--active");
				if (chip.dataset.editorial === "true") {
					editorialOnly = true;
					activeCategory = "";
				} else {
					editorialOnly = false;
					activeCategory = chip.dataset.category || "";
				}
				applyFilters();
			});

			clsChips.addEventListener("click", (e) => {
				const chip = e.target.closest(".chip");
				if (!chip) return;
				clsChips.querySelectorAll(".chip").forEach((c) =>
					c.classList.remove("chip--active"),
				);
				chip.classList.add("chip--active");
				activeClass = chip.dataset.class || "";
				syncUrl();
				applyFilters();
			});

			wtChips.addEventListener("click", (e) => {
				const chip = e.target.closest(".chip");
				if (!chip) return;
				wtChips.querySelectorAll(".chip").forEach((c) =>
					c.classList.remove("chip--active"),
				);
				chip.classList.add("chip--active");
				activeWeaponType = chip.dataset.weapon || "";
				syncUrl();
				applyFilters();
			});

			// Expand-all / collapse-all controls.
			document.addEventListener("click", (e) => {
				const btn = e.target.closest(".expand-btn");
				if (!btn) return;
				const open = btn.dataset.action === "expand-all";
				catSections.forEach((d) => (d.open = open));
			});

			// URL-driven initial state (share-friendly filters).
			const params = new URLSearchParams(window.location.search);
			const initialCat = params.get("category");
			if (initialCat) {
				const chip = catChips.querySelector(
					`.chip[data-category="${initialCat}"]`,
				);
				if (chip) chip.click();
			}
			const initialCls = params.get("class");
			if (initialCls) {
				const chip = clsChips.querySelector(
					`.chip[data-class="${initialCls}"]`,
				);
				if (chip) chip.click();
			}
			const initialWt = params.get("weapon");
			if (initialWt) {
				const chip = wtChips.querySelector(
					`.chip[data-weapon="${initialWt}"]`,
				);
				if (chip) chip.click();
			}
		})();
	</script>
</BaseLayout>

<style>
	.eyebrow {
		display: inline-block; font-size: 0.75rem; font-weight: bold;
		text-transform: uppercase; letter-spacing: 0.1em;
		color: var(--accent-primary);
	}
	h1 { margin: 0.3rem 0 0.5rem; }
	.lede {
		max-width: 48rem; line-height: 1.6;
		color: var(--text-body); margin: 0;
	}
	.build-meta {
		margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-muted);
	}
	.build-meta code {
		padding: 0.1rem 0.4rem; background: var(--surface-nav);
		color: var(--text-on-nav); border-radius: 0.25rem; font-size: 0.9em;
	}

	.class-strip {
		margin: 1.5rem 0;
		padding: 1.2rem 1.4rem;
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.75rem;
	}
	.class-strip__title { margin: 0 0 0.3rem; font-size: 1.15rem; }
	.class-strip__lede {
		margin: 0 0 1rem; font-size: 0.9rem;
		color: var(--text-muted); line-height: 1.5;
	}
	.class-strip__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.75rem;
	}
	.class-tile {
		display: flex; flex-direction: column;
		gap: 0.3rem; padding: 1rem 1.2rem;
		border-radius: 0.6rem;
		text-decoration: none;
		background: var(--surface-nav);
		color: var(--text-on-nav);
		transition: transform 120ms ease;
	}
	/* Sprint 86: hover lift comes from .interactive-card utility. */
	.class-tile--perion    { background: #d67a99; color: white; }
	.class-tile--ellinia   { background: #7a99d6; color: white; }
	.class-tile--henesys   { background: #7cc4a0; color: white; }
	.class-tile--kerning   { background: #a07cc4; color: white; }
	.class-tile__name { font-size: 1.1rem; font-weight: bold; }
	.class-tile__count { font-size: 0.85rem; opacity: 0.9; }

	.controls {
		display: flex; flex-direction: column; gap: 0.9rem;
		margin-bottom: 1rem; padding: 1rem;
		background: var(--surface-card); border: 2px solid var(--border-card);
		border-radius: 0.75rem;
	}
	.search-label {
		display: flex; flex-direction: column; gap: 0.3rem;
		font-size: 0.85rem; font-weight: bold;
	}
	.search-label input {
		padding: 0.5rem 0.75rem; border: 1px solid var(--border-card);
		border-radius: 0.4rem; font-size: 1rem; background: var(--bg-cloud);
	}
	.filter-row {
		display: flex; align-items: baseline; gap: 0.7rem;
		flex-wrap: wrap;
	}
	.filter-row__label {
		font-size: 0.85rem; font-weight: bold;
		color: var(--text-muted); min-width: 5.5rem;
	}
	.filter-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

	.chip--active {
		background: var(--accent-primary); color: white;
		border-color: var(--accent-primary);
	}

	.expand-controls {
		display: flex; gap: 0.5rem; padding-top: 0.5rem;
		border-top: 1px dashed var(--border-card);
	}

	.result-count {
		margin: 0.5rem 0 0.8rem;
		font-size: 0.85rem; color: var(--text-muted);
	}

	.catalog { display: flex; flex-direction: column; gap: 0.8rem; }

	/* Collapsible section header - native <details><summary>. */
	.cat-section {
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.75rem;
		overflow: hidden;
	}
	.cat-header {
		display: flex; align-items: center; gap: 0.8rem;
		padding: 0.85rem 1.2rem;
		cursor: pointer;
		list-style: none;
		transition: background 120ms ease;
		border-left: 5px solid var(--accent-primary);
	}
	.cat-header::-webkit-details-marker { display: none; }
	.cat-header:hover { background: var(--bg-cloud); }
	.cat-header__chevron {
		display: inline-block;
		font-size: 1.3rem; line-height: 1;
		color: var(--accent-primary);
		transition: transform 150ms ease;
	}
	.cat-section[open] .cat-header__chevron { transform: rotate(90deg); }
	.cat-header__title { margin: 0; font-size: 1.1rem; }
	.cat-header__sep { color: var(--text-muted); font-weight: normal; }
	.cat-header__count {
		margin-left: auto; font-size: 0.85rem;
		color: var(--text-muted); font-family: monospace;
	}
	.cat-header__total { opacity: 0.6; margin-left: 0.2rem; }

	/* Sprint 66 mobile fix: right-edge gradient signals "more columns
	   -> scroll right" on narrow viewports. Without it users just see
	   3 of 8 columns and have no idea more content exists. Uses a
	   sticky pseudo-element that only appears when overflow is
	   actually present (via mask). */
	.cat-table-wrap {
		overflow-x: auto;
		border-top: 1px solid var(--border-card);
		position: relative;
		background:
			linear-gradient(90deg, transparent 90%, color-mix(in srgb, var(--border-card) 55%, transparent)) right center / 24px 100% no-repeat local;
	}
	.item-table {
		width: 100%; border-collapse: collapse; min-width: 800px;
	}
	.item-table th, .item-table td {
		padding: 0.5rem 0.75rem; text-align: left;
		border-bottom: 1px solid var(--border-card);
		font-size: 0.85rem; white-space: nowrap;
	}
	.item-table th {
		background: var(--surface-nav); color: var(--text-on-nav);
		font-weight: bold; font-size: 0.78rem;
		text-transform: uppercase; letter-spacing: 0.05em;
	}
	.item-row:hover { background: var(--bg-cloud); }
	.col-icon { width: 32px; text-align: center; }
	.col-icon img { image-rendering: pixelated; }
	.col-id, .col-price {
		font-family: monospace; font-size: 0.8rem;
		color: var(--text-muted);
	}
	.col-id a, .col-name a {
		text-decoration: none; color: var(--accent-primary);
	}
	.col-id a:hover, .col-name a:hover { text-decoration: underline; }
	.col-lv { text-align: right; font-family: monospace; }
	.col-wt { font-size: 0.78rem; color: var(--text-muted); }
	.col-editorial {
		font-size: 0.75rem; color: var(--accent-primary); font-weight: bold;
	}
</style>
