---
/**
 * 404 - Themed not-found page.
 *
 * Astro auto-uses src/pages/404.astro for any unmatched route on
 * static-hosted deployments. Cloudflare Pages serves this file
 * with a real 404 status by convention (it's built as
 * dist/404.html and CF looks for it on catch-all failures).
 *
 * The vibe: an original illustrated hero (`404-hero.jpg`) carries
 * the moment - autumn Maple sky-islands, a tiny explorer squinting
 * at his map, a confused Slime and Mushroom, and a shimmering portal
 * to nowhere. The title text ("404 / Path is a Dead End") is baked
 * INTO the artwork, so the visible <h1> is SR-only: screen readers,
 * search crawlers, and social-preview scrapers still get semantic
 * text while sighted users get the art uncluttered.
 *
 * Sprint 82 shipped a sprite-trio version of this page (Orange
 * Mushroom + Slime + Ribbon Pig damage sprites with speech bubbles).
 * The illustrated hero replaces that whole treatment - the art
 * already contains a slime and mushroom, so duplicating them below
 * was busy. Sprite trio removed in Sprint 99.
 *
 * Theme: henesys - matches the autumn palette in the hero art.
 * The old lith (ocean-blue) treatment fought the warm reds/oranges.
 *
 * The `image` prop overrides BaseLayout's default og:image so a
 * shared broken link shows the themed 404 art on Discord/Twitter/etc
 * instead of the generic Henesys backdrop.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="404 - Page not found - Liven's Classic Maple Guide"
	description="This page doesn't exist in the Classic World datamine. Our explorer can't find it on his map either."
	currentPath="/404"
	theme="henesys"
	decorations={false}
	image="/images/404-hero.jpg"
>
	<section class="not-found">
		{/* SR-only h1: the art carries the visual title ("404 / Path
		    is a Dead End") but screen readers and crawlers can't OCR
		    an image, so keep the semantic heading available in the
		    accessibility tree. */}
		<h1 class="sr-only">404 - Path is a dead end</h1>

		<img
			class="not-found__hero"
			src="/images/404-hero.jpg"
			alt="A tiny explorer stands on an autumn floating-island cliff, puzzling over a map next to a green Slime and a red Mushroom. A shimmering purple portal glows nearby. Overhead: '404 - Path is a Dead End' in gold lettering."
			width="1672"
			height="941"
			loading="eager"
			fetchpriority="high"
		/>

		<div class="not-found__copy">
			<p class="not-found__lede">
				The URL you followed doesn't exist in Classic World, v83 GMS,
				or any other build we've catalogued. Might have been moved,
				might have been a typo in Nexon's dev branch, might just be
				a haunted link. Our explorer's just as confused as you are.
			</p>
			<p class="not-found__lede not-found__lede--secondary">
				Let's get you back somewhere useful:
			</p>

			<ul class="not-found__cta-list">
				<li>
					<a class="not-found__cta not-found__cta--primary" href="/">
						<span class="not-found__cta-title">Back to Home</span>
						<span class="not-found__cta-sub">Latest news + featured guides</span>
					</a>
				</li>
				<li>
					<a class="not-found__cta" href="/guides">
						<span class="not-found__cta-title">Guides</span>
						<span class="not-found__cta-sub">CoT2 vs v83, jobs, glossary, more</span>
					</a>
				</li>
				<li>
					<a class="not-found__cta" href="/calculators">
						<span class="not-found__cta-title">Calculators</span>
						<span class="not-found__cta-sub">Damage, mesos, drops, EXP</span>
					</a>
				</li>
				<li>
					<a class="not-found__cta" href="/jukebox">
						<span class="not-found__cta-title">Jukebox</span>
						<span class="not-found__cta-sub">Every BGM on the site</span>
					</a>
				</li>
			</ul>

			<p class="not-found__hint">
				Or press <kbd>Ctrl</kbd>+<kbd>K</kbd> to search across every
				page on the site.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		padding: 3rem 1rem 4rem;
		max-width: 780px;
		margin: 0 auto;
		text-align: center;
	}

	/* Hero illustration. The art is 1672x941 (~16:9) with the title
	   text baked in, so we let it flex to container width and cap
	   at a comfortable reading size. Rounded corners + shadow to
	   match the site's card treatment; border-color follows the
	   active theme for coherence. */
	.not-found__hero {
		display: block;
		width: 100%;
		max-width: 720px;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid var(--border-card);
		box-shadow: var(--shadow-content-card);
	}

	/* Copy block */
	.not-found__copy {
		width: 100%;
	}
	.not-found__lede {
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--text-body);
		margin: 0 auto 0.9rem;
		max-width: 62ch;
	}
	.not-found__lede--secondary {
		margin-top: 1.4rem;
		font-weight: 600;
	}

	/* CTA grid */
	.not-found__cta-list {
		list-style: none;
		margin: 0.8rem 0 1.5rem;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.75rem;
		text-align: left;
	}
	.not-found__cta {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.85rem 1rem;
		background: color-mix(in srgb, var(--surface-card) 92%, transparent);
		border: 1px solid var(--border-card);
		border-radius: 0.65rem;
		color: var(--text-body);
		text-decoration: none;
		box-shadow: var(--shadow-content-card);
		transition:
			transform 140ms ease,
			border-color 140ms ease,
			box-shadow 140ms ease;
	}
	.not-found__cta:hover {
		transform: translateY(-2px);
		border-color: var(--accent-primary);
	}
	.not-found__cta:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 2px;
	}
	.not-found__cta--primary {
		border-color: var(--accent-primary);
		background: color-mix(in srgb, var(--accent-primary) 12%, var(--surface-card));
	}
	.not-found__cta-title {
		font-weight: 700;
		color: var(--text-heading);
		font-size: 1rem;
	}
	.not-found__cta-sub {
		font-size: 0.82rem;
		color: var(--text-body);
		opacity: 0.85;
	}

	.not-found__hint {
		font-size: 0.9rem;
		color: var(--text-body);
		opacity: 0.85;
		margin: 0;
	}
	.not-found__hint kbd {
		font-family: inherit;
		font-size: 0.78rem;
		padding: 0.1rem 0.4rem;
		margin: 0 0.05rem;
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--surface-card) 60%, transparent);
		border: 1px solid var(--border-card);
		color: var(--text-heading);
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found__cta {
			transition: none;
		}
	}
</style>
