---
/**
 * /character - the character customizer.
 *
 * Client-side sandbox: users equip items on an idle character
 * sprite and see it composite live via maplestory.io's character
 * render endpoint. State (skin + 13 slots) syncs to URL params
 * for shareable builds, and to localStorage so returning visitors
 * pick up where they left off.
 *
 * Frontmatter's job:
 *   1. Filter every equippable item out of items.json,
 *      group by slot (using slotForItem categorization).
 *   2. Curate the skin list (skins aren't in items.json).
 *   3. Serialize as a JSON blob for the inline script to consume.
 *
 * The heavy interactive lifting all happens in the inline script
 * at the bottom. Kept inline (not a component) because it's a
 * single-page feature and extracting adds indirection without
 * a second consumer. Refactor if we ship a v2.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import characterWhitelist from "../data/character-item-whitelist.json";
import {
	CHARACTER_SLOTS, DEFAULT_BUILD,
} from "../lib/character-slots";

// ==================== Item categorization ====================
// Source: character-item-whitelist.json - a pre-validated subset of
// the raw datamine (items.json) filtered against GMS/83's actual
// asset library via scripts/validate-character-items.mjs. Only
// items that (a) have a valid /item/{id}/icon endpoint OR (b) add
// meaningful bytes to the composited /character render survive.
// This eliminates the "silently invisible item" trap where users
// equipped garbage IDs and got no visual change.
//
// Enriched fields (isCash/desc/category/subCategory) come from the
// maplestory.io feed via fetch-maple-catalog. Older CoT-sourced
// entries may not have them, so they're all optional.
interface PickerItem {
	id: number;
	name: string;
	slot: string;
	isCash?: boolean;
	desc?: string | null;
	category?: string | null;
	subCategory?: string | null;
}
const bySlot: Record<string, PickerItem[]> = {};
for (const s of CHARACTER_SLOTS) bySlot[s.key] = [];

for (const it of characterWhitelist as PickerItem[]) {
	if (bySlot[it.slot]) bySlot[it.slot].push(it);
}

// Curated skins (bodies 2000-2005 aren't in items.json - they live
// in the Character/Body category on maplestory.io). Names match
// GMS v83 conventions.
bySlot.skin = [
	{ id: 2000, name: "Light" },
	{ id: 2001, name: "Tan" },
	{ id: 2002, name: "Dark" },
	{ id: 2003, name: "Pale Pink" },
	{ id: 2004, name: "Ashen" },
	{ id: 2005, name: "Ghost" },
];

// Sort each slot by name for stable browsing.
for (const k of Object.keys(bySlot)) {
	bySlot[k]!.sort((a, b) => a.name.localeCompare(b.name));
}

// Slot totals used to badge tabs in the picker.
const slotTotals: Record<string, number> = {};
for (const [k, v] of Object.entries(bySlot)) slotTotals[k] = v.length;
---

<BaseLayout
	title="Character Customizer - Liven's Classic Maple Guide"
	description="Live character customizer for MapleStory Classic World. Equip any hat, top, weapon, and more; preview the composite sprite; share your build via URL."
	currentPath="/character"
	theme="henesys"
	decorations={false}
>
	{/* Hero plate - frosted-glass panel that groups the breadcrumb
	    + hero heading with enough opacity to rescue text contrast
	    against the Henesys theme's photographic backdrop (tree
	    leaves + sky). Without it, the eyebrow disappears into
	    clouds and the h1 fights the tree silhouette. */}
	<div class="hero-plate">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span class="crumbs__sep" aria-hidden="true">&rsaquo;</span>
			<span aria-current="page">Character Customizer</span>
		</nav>

		<header class="cust-hero">
			<span class="eyebrow">Interactive sandbox</span>
			<h1>Character Customizer</h1>
			<p class="lede">
				Dress a MapleStory character with any equipped item from the
				datamine. Preview updates live via the maplestory.io render
				API. Share your build with a link; it saves to your browser
				too so you can come back to it. Zero backend, zero accounts.
			</p>
		</header>
	</div>

	<div class="cust-layout">
		<!-- =============== Preview panel (left) =============== -->
		<aside class="cust-preview">
			<div class="cust-preview__frame">
				<img
					id="character-preview"
					alt="Your character preview"
					width="180" height="180"
					loading="eager"
				/>
				<div id="preview-loading" class="preview-loading" aria-hidden="true">
					<span>Rendering...</span>
				</div>
			</div>

			<div class="stance-row">
				<label for="stance-select">Pose</label>
				<select id="stance-select">
					<option value="stand1">Stand</option>
					<option value="stand2">Stand (2H weapon)</option>
					<option value="walk1">Walk</option>
					<option value="alert">Alert</option>
					<option value="jump">Jump</option>
					<option value="prone">Prone</option>
					<option value="sit">Sit</option>
				</select>
			</div>

			<div class="cust-actions">
				<button type="button" class="btn btn--primary" data-action="share">
					Share build
				</button>
				<button type="button" class="btn" data-action="randomize">
					Randomize
				</button>
				<button type="button" class="btn" data-action="reset">
					Reset
				</button>
			</div>

			<div class="build-summary" id="build-summary" aria-live="polite">
				<!-- Chips populated by JS -->
			</div>

			<p class="preview-help">
				Cold-cache renders can take ~3s (Cloudflare warm-up).
				If the sprite fails, click Reset then re-equip - the API
				sometimes 502s on obscure item combos.
			</p>
		</aside>

		<!-- =============== Picker panel (right) =============== -->
		<section class="cust-picker">
			<div class="tab-bar" role="tablist">
				{CHARACTER_SLOTS.map((s) => (
					<button
						type="button"
						role="tab"
						class="tab"
						data-slot={s.key}
						aria-controls="item-grid"
					>
						<span class="tab__icon" aria-hidden="true">{s.icon}</span>
						<span class="tab__label">{s.label}</span>
						<span class="tab__count">{slotTotals[s.key]}</span>
					</button>
				))}
			</div>

			<div class="search-row">
				<label class="sr-only" for="item-search">Search items</label>
				<input
					type="search"
					id="item-search"
					placeholder="Search items in this slot..."
					autocomplete="off"
				/>
				<button type="button" class="btn btn--ghost" data-action="unequip">
					Unequip slot
				</button>
			</div>

			{/* Gender toggle - only appears on Face and Hair tabs since
			    those are the only slots with gender-split IDs (male IDs
			    2X000-2X999 / 3X000-3X999, female 2X1000-2X1999 /
			    3X1000-3X1999). Hidden by JS on other tabs. */}
			<div id="gender-row" class="gender-row" hidden>
				<span class="gender-row__label">Gender:</span>
				<div class="gender-toggle" role="group" aria-label="Filter by gender">
					<button type="button" class="gender-btn" data-gender="both" aria-pressed="true">Both</button>
					<button type="button" class="gender-btn" data-gender="male" aria-pressed="false">Male</button>
					<button type="button" class="gender-btn" data-gender="female" aria-pressed="false">Female</button>
				</div>
			</div>

			{/* Cash filter - applies to every slot (all have cash items
			    except skin). Users can browse in-game gear only,
			    cash-shop only, or both. Persisted separately in
			    localStorage. */}
			<div id="cash-row" class="gender-row">
				<span class="gender-row__label">Source:</span>
				<div class="gender-toggle" role="group" aria-label="Filter by item source">
					<button type="button" class="gender-btn" data-cash="all" aria-pressed="true">All</button>
					<button type="button" class="gender-btn" data-cash="ingame" aria-pressed="false">In-game</button>
					<button type="button" class="gender-btn" data-cash="cash" aria-pressed="false">Cash / NX</button>
				</div>
			</div>

			<div id="item-grid" class="item-grid" role="tabpanel" aria-live="polite">
				<!-- Populated by JS -->
			</div>
			<div class="picker-footer">
				<p class="picker-hint" id="picker-hint"></p>
				<button type="button" id="load-more" class="btn btn--ghost" hidden>
					Show more
				</button>
			</div>
		</section>
	</div>
</BaseLayout>

<!-- Item data as JSON blob for the inline script. Astro doesn't
     strip <script type="application/json"> bodies. -->
<script id="items-data" type="application/json" set:html={JSON.stringify(bySlot)}></script>
<script id="defaults-data" type="application/json" set:html={JSON.stringify(DEFAULT_BUILD)}></script>
<script id="slots-data" type="application/json" set:html={JSON.stringify(CHARACTER_SLOTS.map((s) => ({ key: s.key, label: s.label })))}></script>

<script is:inline>
(function () {
	// ---- Config ----
	const STORAGE_KEY = "livens-character-build-v1";
	const RENDER_ROOT = "https://maplestory.io/api/GMS/83/character";
	const ICON_ROOT = "https://maplestory.io/api/GMS/83/item";
	// Fallback chain for picker icons. GMS/83's /item/{id}/icon
	// endpoint is missing entire ID ranges (all 1017xxx Face acc +
	// 1027xxx Eye acc). The character render endpoint always returns
	// 200 for renderable IDs and shows the item AS COMPOSITED ON A
	// CHARACTER, which is more useful than a bare inventory icon.
	//
	// NOTE: KMS fallback was deliberately removed - numeric IDs
	// don't translate across regions/versions. KMS/389 id 30074 is
	// a plush mob; GMS/83 id 30074 is a hairstyle. Cross-region
	// fallback masqueraded wrong items as the requested one, which
	// is worse UX than showing a bald-character placeholder.
	function iconFallbackChain(id) {
		return [
			ICON_ROOT + "/" + id + "/icon",
			"https://maplestory.io/api/GMS/83/character/2000/" + id + "/stand1/0",
		];
	}
	// Pure CSS swatch colors for skin picker cards - the /item/{id}/icon
	// endpoint returns useless 8x14 px stubs for 4 of the 6 skins.
	// Colors sampled from maplestory.io character renders on each body.
	const SKIN_SWATCH_COLORS = {
		2000: "#ffe0bd",  // Light
		2001: "#d7a86e",  // Tan
		2002: "#a06740",  // Dark
		2003: "#ffcfcf",  // Pale Pink
		2004: "#b0b0a0",  // Ashen
		2005: "#cfe8e6",  // Ghost
	};
	const PAGE_SIZE = 60;  // grid pagination increment
	// Slots where a gender toggle makes sense. Male / Female IDs are
	// split within each range (see character-slots.ts for pattern).
	const GENDER_SLOTS = new Set(["face", "hair"]);
	// Detect gender from raw ID. Convention:
	//   face: 20000-20999 male, 21000-21999 female
	//   hair: 30000-30999 male, 31000-31999 female
	// Both use `(id % 10000) / 1000 | 0` -> 0 male, 1 female.
	function genderOf(id) {
		const g = ((id % 10000) / 1000) | 0;
		return g === 0 ? "male" : g === 1 ? "female" : "other";
	}

	// ---- Data blobs ----
	const ITEMS = JSON.parse(document.getElementById("items-data").textContent);
	const DEFAULTS = JSON.parse(document.getElementById("defaults-data").textContent);
	const SLOTS = JSON.parse(document.getElementById("slots-data").textContent);

	// ---- DOM refs ----
	const $preview = document.getElementById("character-preview");
	const $loading = document.getElementById("preview-loading");
	const $stance  = document.getElementById("stance-select");
	const $search  = document.getElementById("item-search");
	const $grid    = document.getElementById("item-grid");
	const $summary = document.getElementById("build-summary");
	const $hint    = document.getElementById("picker-hint");
	const $genderRow = document.getElementById("gender-row");
	const $cashRow   = document.getElementById("cash-row");
	const $loadMore  = document.getElementById("load-more");

	// ---- State ----
	let state = readInitialState();
	let activeSlot = SLOTS[0].key; // "skin"
	let searchQuery = "";
	let renderRetryTimer = null;
	// Persisted gender preference - remembered across sessions +
	// slot switches so a user set on "female" doesn't have to
	// re-toggle every time they change tabs.
	let genderFilter = readGenderPref(); // "both" | "male" | "female"
	// Cash source filter - "all" | "ingame" | "cash". Distinguishes
	// items you can loot/craft/quest for vs items you buy with NX.
	// Great for wishlist-style browsing per the site's editorial goal.
	let cashFilter = readCashPref();
	// Pagination cursor - number of items currently rendered in the
	// grid. Reset to PAGE_SIZE on any slot / search / gender change.
	let pageSize = PAGE_SIZE;

	// ---- Init ----
	renderTabs();
	syncGenderButtons();
	syncCashButtons();
	renderGrid();
	renderSummary();
	renderPreview();
	wireEvents();

	// ---- Functions ----
	function readInitialState() {
		// URL params take precedence (shared links). Fall back to
		// localStorage (returning users), then defaults.
		const params = new URLSearchParams(location.search);
		const fromUrl = {};
		let hasUrl = false;
		for (const s of SLOTS) {
			const v = params.get(s.key);
			if (v && /^\d+$/.test(v)) { fromUrl[s.key] = Number(v); hasUrl = true; }
		}
		if (hasUrl) return { ...DEFAULTS, ...fromUrl };
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved) return { ...DEFAULTS, ...JSON.parse(saved) };
		} catch (e) { /* localStorage disabled - ok */ }
		return { ...DEFAULTS };
	}

	function persist() {
		try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
		catch (e) { /* ok */ }
		const params = new URLSearchParams();
		for (const s of SLOTS) {
			if (state[s.key] != null) params.set(s.key, String(state[s.key]));
		}
		history.replaceState(null, "", "?" + params.toString());
	}

	function renderPreview() {
		const skin = state.skin || DEFAULTS.skin;
		const items = SLOTS.filter((s) => s.key !== "skin")
			.map((s) => state[s.key])
			.filter((id) => typeof id === "number" && id > 0);
		if (items.length === 0) items.push(DEFAULTS.face);
		const stance = $stance.value || "stand1";
		const url = RENDER_ROOT + "/" + skin + "/" + items.join(",") + "/" + stance + "/0";
		$loading.style.opacity = "1";
		$preview.onload = function () { $loading.style.opacity = "0"; };
		$preview.onerror = function () {
			// Cloudflare warm-up 502 retry (once, w/ cache buster)
			if (renderRetryTimer) return;
			renderRetryTimer = setTimeout(function () {
				renderRetryTimer = null;
				$preview.src = url + "?r=" + Date.now();
			}, 1500);
		};
		$preview.src = url;
	}

	function renderTabs() {
		for (const btn of document.querySelectorAll("[data-slot]")) {
			const active = btn.getAttribute("data-slot") === activeSlot;
			btn.classList.toggle("tab--active", active);
			btn.setAttribute("aria-selected", active ? "true" : "false");
		}
	}

	function readGenderPref() {
		try {
			const v = localStorage.getItem(STORAGE_KEY + ":gender");
			if (v === "male" || v === "female" || v === "both") return v;
		} catch (e) { /* ok */ }
		return "both";
	}
	function persistGender() {
		try { localStorage.setItem(STORAGE_KEY + ":gender", genderFilter); }
		catch (e) { /* ok */ }
	}
	function syncGenderButtons() {
		for (const btn of $genderRow.querySelectorAll("[data-gender]")) {
			const active = btn.getAttribute("data-gender") === genderFilter;
			btn.setAttribute("aria-pressed", active ? "true" : "false");
			btn.classList.toggle("gender-btn--active", active);
		}
	}
	function readCashPref() {
		try {
			const v = localStorage.getItem(STORAGE_KEY + ":cash");
			if (v === "all" || v === "ingame" || v === "cash") return v;
		} catch (e) { /* ok */ }
		return "all";
	}
	function persistCash() {
		try { localStorage.setItem(STORAGE_KEY + ":cash", cashFilter); }
		catch (e) { /* ok */ }
	}
	function syncCashButtons() {
		for (const btn of $cashRow.querySelectorAll("[data-cash]")) {
			const active = btn.getAttribute("data-cash") === cashFilter;
			btn.setAttribute("aria-pressed", active ? "true" : "false");
			btn.classList.toggle("gender-btn--active", active);
		}
	}

	function renderGrid() {
		const items = ITEMS[activeSlot] || [];
		const q = searchQuery.toLowerCase().trim();
		// Hide gender toggle on slots that don't have gender variants
		// (skin, hat, top, etc.). Only face/hair split by ID range.
		const genderRelevant = GENDER_SLOTS.has(activeSlot);
		$genderRow.hidden = !genderRelevant;
		// Cash filter hides on skin tab (only 6 hardcoded swatches;
		// no cash concept) - relevant everywhere else.
		$cashRow.hidden = activeSlot === "skin";
		// Apply text search + optional gender filter + cash filter.
		let filtered = q
			? items.filter((i) => i.name.toLowerCase().includes(q))
			: items;
		if (genderRelevant && genderFilter !== "both") {
			filtered = filtered.filter((i) => genderOf(i.id) === genderFilter);
		}
		if (activeSlot !== "skin" && cashFilter !== "all") {
			const wantCash = cashFilter === "cash";
			filtered = filtered.filter((i) => Boolean(i.isCash) === wantCash);
		}
		const shown = filtered.slice(0, pageSize);
		$grid.innerHTML = "";
		if (shown.length === 0) {
			const empty = document.createElement("p");
			empty.className = "empty";
			empty.textContent = q
				? "No items match \u201c" + q + "\u201d in this slot."
				: "No items available in this slot.";
			$grid.appendChild(empty);
		} else {
			for (const it of shown) {
				const card = document.createElement("button");
				card.type = "button";
				card.className = "item-card";
				card.setAttribute("data-item-id", String(it.id));
				const equipped = state[activeSlot] === it.id;
				if (equipped) card.classList.add("item-card--equipped");
				// Skin slot gets a pure-CSS colored swatch (API stubs
				// are unusable). Every other slot gets an <img> with
				// a fallback chain wired via data attributes; the
				// delegated onerror handler below cycles sources.
				let iconHtml;
				if (activeSlot === "skin" && SKIN_SWATCH_COLORS[it.id]) {
					iconHtml =
						'<span class="item-card__swatch" style="background:' +
						SKIN_SWATCH_COLORS[it.id] + '"></span>';
				} else {
					const chain = iconFallbackChain(it.id);
					iconHtml =
						'<img loading="lazy" data-fallbacks="' +
						chain.slice(1).join("|") + '" src="' +
						chain[0] + '" alt="">';
				}
				// CASH badge - visual signal that this item is from the
				// NX shop, not something obtainable in-game. Doubles as
				// the seed for wishlist-style browsing (Sprint 50).
				const cashBadge = it.isCash
					? '<span class="item-card__cash" title="Cash Shop / NX item">NX</span>'
					: "";
				// Tooltip = item description (from maplestory.io). The
				// description often includes formatting codes (#c...#)
				// which we strip for the plain tooltip. HTML title attr
				// only handles plain text anyway.
				if (it.desc) {
					const cleanDesc = String(it.desc).replace(/#[a-z]/gi, "").replace(/#/g, "").trim();
					if (cleanDesc) card.title = cleanDesc;
				}
				card.innerHTML = iconHtml + cashBadge +
					'<span class="item-card__name">' + escapeHtml(it.name) + "</span>" +
					'<span class="item-card__id">' + it.id + "</span>";
				$grid.appendChild(card);
			}
		}
		if (filtered.length > shown.length) {
			const remaining = filtered.length - shown.length;
			$hint.textContent = "Showing " + shown.length + " of " + filtered.length + ".";
			$loadMore.hidden = false;
			$loadMore.textContent = remaining > PAGE_SIZE
				? "Show " + PAGE_SIZE + " more (" + remaining + " remaining)"
				: "Show remaining " + remaining;
		} else if (filtered.length > 0) {
			$hint.textContent = filtered.length + " item" + (filtered.length === 1 ? "" : "s") + ".";
			$loadMore.hidden = true;
		} else {
			$hint.textContent = "";
			$loadMore.hidden = true;
		}
	}

	function renderSummary() {
		const chips = [];
		for (const s of SLOTS) {
			const id = state[s.key];
			if (id != null) {
				const name = findName(s.key, id);
				chips.push(
					'<button type="button" class="chip" data-jump-slot="' + s.key + '">' +
					'<strong>' + s.label + '</strong> ' +
					'<span>' + escapeHtml(name || String(id)) + "</span>" +
					"</button>"
				);
			}
		}
		$summary.innerHTML = chips.join("");
	}

	function findName(slot, id) {
		const list = ITEMS[slot] || [];
		for (const it of list) if (it.id === id) return it.name;
		return null;
	}

	function equipItem(id) {
		state[activeSlot] = id;
		persist();
		renderGrid();
		renderSummary();
		renderPreview();
	}

	function unequipSlot() {
		const s = SLOTS.find((x) => x.key === activeSlot);
		// Skin can't be unequipped - it's structurally required.
		if (!s || s.key === "skin") return;
		state[activeSlot] = null;
		persist();
		renderGrid();
		renderSummary();
		renderPreview();
	}

	function randomize() {
		for (const s of SLOTS) {
			const list = ITEMS[s.key] || [];
			if (list.length === 0) continue;
			// Skin + face + hair always pick something. Optional slots
			// get equipped 60% of the time - keeps builds varied.
			const required = s.key === "skin" || s.key === "face" || s.key === "hair";
			if (!required && Math.random() < 0.4) { state[s.key] = null; continue; }
			state[s.key] = list[Math.floor(Math.random() * list.length)].id;
		}
		persist();
		renderGrid();
		renderSummary();
		renderPreview();
	}

	function reset() {
		state = Object.assign({}, DEFAULTS);
		persist();
		renderGrid();
		renderSummary();
		renderPreview();
	}

	async function share() {
		const url = location.origin + location.pathname + location.search;
		try {
			await navigator.clipboard.writeText(url);
			flashButton("share", "Link copied!");
		} catch (e) {
			// Fallback: select in a textarea
			const ta = document.createElement("textarea");
			ta.value = url; document.body.appendChild(ta);
			ta.select(); document.execCommand("copy"); ta.remove();
			flashButton("share", "Link copied!");
		}
	}

	function flashButton(action, msg) {
		const btn = document.querySelector('[data-action="' + action + '"]');
		if (!btn) return;
		const orig = btn.textContent;
		btn.textContent = msg;
		btn.disabled = true;
		setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 1500);
	}

	function wireEvents() {
		document.querySelector(".tab-bar").addEventListener("click", function (e) {
			const tab = e.target.closest("[data-slot]");
			if (!tab) return;
			activeSlot = tab.getAttribute("data-slot");
			searchQuery = ""; $search.value = "";
			pageSize = PAGE_SIZE;   // reset pagination on tab switch
			renderTabs(); renderGrid(); syncGenderButtons();
		});
		// Gender toggle - reset pagination and re-filter.
		$genderRow.addEventListener("click", function (e) {
			const btn = e.target.closest("[data-gender]");
			if (!btn) return;
			genderFilter = btn.getAttribute("data-gender");
			pageSize = PAGE_SIZE;
			persistGender();
			syncGenderButtons();
			renderGrid();
		});
		// Cash-source toggle - same pattern as gender.
		$cashRow.addEventListener("click", function (e) {
			const btn = e.target.closest("[data-cash]");
			if (!btn) return;
			cashFilter = btn.getAttribute("data-cash");
			pageSize = PAGE_SIZE;
			persistCash();
			syncCashButtons();
			renderGrid();
		});
		// "Show more" pagination.
		$loadMore.addEventListener("click", function () {
			pageSize += PAGE_SIZE;
			renderGrid();
		});
		$grid.addEventListener("click", function (e) {
			const card = e.target.closest("[data-item-id]");
			if (!card) return;
			equipItem(Number(card.getAttribute("data-item-id")));
		});
		// Delegated error handler for the icon fallback chain.
		// Bubble phase doesn't catch <img> errors, so use capture.
		$grid.addEventListener("error", function (e) {
			const img = e.target;
			if (!(img instanceof HTMLImageElement)) return;
			const remaining = (img.dataset.fallbacks || "").split("|").filter(Boolean);
			if (remaining.length === 0) {
				// All fallbacks exhausted - fade the broken glyph.
				img.style.opacity = "0.3";
				return;
			}
			const next = remaining.shift();
			img.dataset.fallbacks = remaining.join("|");
			img.src = next;
		}, true);
		$search.addEventListener("input", function () {
			searchQuery = $search.value;
			pageSize = PAGE_SIZE;   // reset pagination on new search
			renderGrid();
		});
		$stance.addEventListener("change", renderPreview);
		$summary.addEventListener("click", function (e) {
			const chip = e.target.closest("[data-jump-slot]");
			if (!chip) return;
			activeSlot = chip.getAttribute("data-jump-slot");
			searchQuery = ""; $search.value = "";
			pageSize = PAGE_SIZE;
			renderTabs(); renderGrid();
		});
		document.querySelector('[data-action="share"]').addEventListener("click", share);
		document.querySelector('[data-action="randomize"]').addEventListener("click", randomize);
		document.querySelector('[data-action="reset"]').addEventListener("click", reset);
		document.querySelector('[data-action="unequip"]').addEventListener("click", unequipSlot);
	}

	function escapeHtml(s) {
		return String(s).replace(/[&<>"']/g, function (c) {
			return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
		});
	}
})();
</script>

