---
/**
 * /bosses - the boss compendium landing page.
 *
 * Sourced from src/lib/bosses.ts (which joins mobs.json with the
 * hand-curated boss-manifest.json). Shows every boss as a card in
 * level-ascending order so the page reads as a progression ladder
 * from "your first hidden-street mini-boss" (Mano lv 20) to "deep
 * Sleepywood undead terror" (Zombie Mushmom lv 65).
 *
 * Follow-up sprint queued: expand boss coverage to include Zakum,
 * Papulatus, Pianus, Ergoth, Anego, and other traditional MapleStory endgame bosses.
 * Blocked on our CoT feed only pulling mobs referenced by tracked
 * quests/items - endgame bosses need a supplementary maplestory.io
 * mob fetch to make it into mobs.json.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Sprite from "../../components/Sprite.astro";
import DatabaseStrip from "../../components/DatabaseStrip.astro";
import { allBosses, liveRosterBosses, offRosterBosses, pendingDataBosses, threatMeta } from "../../lib/bosses";
import { mobSpriteSrcs, themePlaceholderUrl } from "../../lib/maplestory-cdn";

// Derived from the manifest so the meta description can't go stale.
// The hand-written list it replaced silently omitted Shade after the
// manifest grew to seven entries.
const bossNames = allBosses.map((b) => b.mob.name).join(", ");
---

<BaseLayout
	title="Bosses - Liven's Classic Maple Guide"
	description={`Every boss in the MapleStory Classic datamine - ${bossNames}. Stats, spawn locations, strategy, drops.`}
	currentPath="/bosses"
	theme="sleepywood"
>
	<DatabaseStrip currentPath={Astro.url.pathname} />

	<section class="section-heading">
		<div>
			<span class="eyebrow eyebrow--guide">Field guide</span>
			<h1>Boss compendium</h1>
			<p class="lede">
				Every boss the datamine flags for traditional MapleStory Classic, in level
				order. Cross-referenced with combat stats, spawn maps, and
				drop tables. Each entry pairs the raw dossier data with
				editorial notes on access, strategy, and threat level.
			</p>
			<p class="build-meta">
				<strong>{liveRosterBosses.length + pendingDataBosses.length} live at Grand Launch</strong>
				({pendingDataBosses.length} awaiting data),
				<strong>{allBosses.length} with dossiers</strong>.
				Endgame bosses (Zakum, Papulatus, Pianus) are not part of Grand
				Launch. For a sequential walkthrough of the live bosses in
				level order, see the
				<a href="/bosses-at-30-plus">Bosses at 30+ progression guide</a>.
			</p>
		</div>
	</section>

	<h2 class="roster-heading">
		<span class="roster-heading__dot roster-heading__dot--live" aria-hidden="true"></span>
		Live at Grand Launch
		<span class="roster-heading__sub">
			Nexon's Grand Launch release notes list Mano, Stumpy, Mushmom, Shade,
			Zombie Mushmom, and Jr. Balrog; King Slime is the Kerning City Party
			Quest finale.
		</span>
	</h2>

	<div class="boss-grid">
		{liveRosterBosses.map((b) => {
			const t = threatMeta(b.narrative.threat);
			return (
				<a class="boss-card" href={`/bosses/${b.slug}/`}>
					<div class="boss-card__sprite">
						<Sprite
							srcs={mobSpriteSrcs(b.mob.id, b.mob.wzId)}
							alt={`${b.mob.name} sprite`}
							loading="lazy"
							placeholder={themePlaceholderUrl("sleepywood")}
						/>
					</div>
					<div class="boss-card__body">
						<h3 class="boss-card__name">{b.mob.name}</h3>
						<div class="boss-card__meta">
							<span class="badge badge--lvl">Lv. {b.mob.stats?.level ?? "?"}</span>
							<span class="badge">{b.mob.stats?.maxHP?.toLocaleString() ?? "?"} HP</span>
							<span class={`badge ${t.cls}`}>{t.label}</span>
						</div>
						<p class="boss-card__role">{b.role}</p>
						<p class="boss-card__tldr">
							{b.narrative.tldr ?? "Editorial notes pending."}
						</p>
						<span class="boss-card__cta">
							Read the dossier →
						</span>
					</div>
				</a>
			);
		})}
		{pendingDataBosses.map((p) => (
			<div class="boss-card boss-card--pending-data">
				<div class="boss-card__sprite boss-card__sprite--empty" aria-hidden="true">?</div>
				<div class="boss-card__body">
					<h3 class="boss-card__name">{p.name}</h3>
					<div class="boss-card__meta">
						<span class="badge badge--pending">Data pending</span>
					</div>
					<p class="boss-card__tldr">{p.note}</p>
				</div>
			</div>
		))}
	</div>

	{offRosterBosses.length > 0 && (
		<>
			<h2 class="roster-heading roster-heading--pending">
				<span class="roster-heading__dot roster-heading__dot--pending" aria-hidden="true"></span>
				Not on the live roster
				<span class="roster-heading__sub">
					Catalogued from the datamine but on neither the Founder's Access
					nor the Grand Launch roster. No release date announced.
				</span>
			</h2>

			<div class="boss-grid">
				{offRosterBosses.map((b) => {
					const t = threatMeta(b.narrative.threat);
					return (
						<a class="boss-card boss-card--pending" href={`/bosses/${b.slug}/`}>
							<div class="boss-card__sprite">
								<Sprite
									srcs={mobSpriteSrcs(b.mob.id, b.mob.wzId)}
									alt={`${b.mob.name} sprite`}
									loading="lazy"
									placeholder={themePlaceholderUrl("sleepywood")}
								/>
							</div>
							<div class="boss-card__body">
								<h3 class="boss-card__name">{b.mob.name}</h3>
								<div class="boss-card__meta">
									<span class="badge badge--lvl">Lv. {b.mob.stats?.level ?? "?"}</span>
									<span class="badge">{b.mob.stats?.maxHP?.toLocaleString() ?? "?"} HP</span>
									<span class={`badge ${t.cls}`}>{t.label}</span>
									<span class="badge badge--pending">Not live</span>
								</div>
								<p class="boss-card__role">{b.role}</p>
								<p class="boss-card__tldr">
									{b.narrative.tldr ?? "Editorial notes pending."}
								</p>
								<span class="boss-card__cta">
									Read the dossier →
								</span>
							</div>
						</a>
					);
				})}
			</div>
		</>
	)}
</BaseLayout>

<style>
	/* Wrap intro in same frosted card style used across other index pages
	   so the lede stays legible on any theme's background. Sprint 52 QA
	   caught this: original inline `color: #2c3e50` washed out over the
	   dark sleepywood forest background. */
	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		margin-bottom: 2rem;
		padding: 1.4rem 1.6rem;
		background: var(--surface-card);
		border: 1px solid var(--border-card);
		border-radius: 0.75rem;
	}
	h1 { margin: 0 0 0.7rem; font-size: 2.5rem; color: var(--text-heading); }
	.lede { margin: 0 0 0.6rem; color: var(--text-body); max-width: 65ch; }
	.build-meta { font-size: 0.85rem; color: var(--text-muted); max-width: 65ch; }
	.build-meta a { color: inherit; text-decoration: underline; }

	.roster-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.6rem;
		margin: 0 0 1rem;
		font-size: 1.5rem;
		color: var(--text-heading);
	}
	.roster-heading--pending {
		margin-top: 2.5rem;
	}
	.roster-heading__dot {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		display: inline-block;
	}
	.roster-heading__dot--live {
		background: #16a34a;
		box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
	}
	/* Gentle live-dot pulse. Gated behind reduced-motion so we
	 * don't trigger vestibular responses for sensitive viewers. */
	@media (prefers-reduced-motion: no-preference) {
		.roster-heading__dot--live {
			animation: roster-dot-pulse 2.4s ease-in-out infinite;
		}
	}
	@keyframes roster-dot-pulse {
		0%, 100% {
			box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
		}
		50% {
			box-shadow: 0 0 0 7px rgba(22, 163, 74, 0.05);
		}
	}
	.roster-heading__dot--pending {
		background: var(--text-muted);
	}
	.roster-heading__sub {
		display: block;
		flex-basis: 100%;
		font-size: 0.88rem;
		font-weight: 400;
		color: var(--text-muted);
		margin-top: 0.2rem;
	}

	.boss-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.2rem;
		margin-bottom: 1.5rem;
	}
	.boss-card--pending {
		opacity: 0.75;
	}
	.boss-card--pending:hover {
		opacity: 1;
	}
	.badge--pending {
		background: var(--text-muted);
		color: var(--bg-cloud);
		font-weight: 600;
	}
	.boss-card {
		display: flex;
		gap: 1rem;
		padding: 1rem;
		background: var(--surface-card);
		border: 1px solid var(--border-card);
		border-radius: 10px;
		text-decoration: none;
		color: var(--text-body);
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}
	.boss-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(0,0,0,0.12);
		border-color: var(--accent-primary);
	}
	.boss-card__sprite {
		flex: 0 0 72px;
		width: 72px;
		height: 72px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-cloud);
		border-radius: 8px;
		image-rendering: pixelated;
	}
	/* Confirmed-but-no-data card: not a link, so no hover lift - a
	   lifting card reads as clickable. Dashed border = placeholder. */
	.boss-card--pending-data {
		border-style: dashed;
	}
	.boss-card--pending-data:hover {
		transform: none;
		box-shadow: none;
		border-color: var(--border-card);
	}
	.boss-card__sprite--empty {
		font-size: 2rem;
		font-weight: 700;
		color: var(--text-muted);
	}
	.boss-card__sprite :global(img) {
		max-width: 64px;
		max-height: 64px;
		image-rendering: pixelated;
	}
	.boss-card__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.boss-card__name {
		margin: 0;
		font-size: 1.25rem;
		color: var(--text-heading);
	}
	.boss-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.boss-card__role {
		margin: 0.1rem 0 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		font-style: italic;
	}
	.boss-card__tldr {
		margin: 0.3rem 0 0.5rem;
		font-size: 0.9rem;
		color: var(--text-body);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.boss-card__cta {
		margin-top: auto;
		font-size: 0.85rem;
		color: var(--accent-primary);
		font-weight: 600;
	}

	.badge {
		display: inline-block;
		padding: 0.15rem 0.55rem;
		font-size: 0.75rem;
		border-radius: 999px;
		background: var(--bg-cloud);
		color: var(--text-body);
	}
	.badge--lvl { background: #dfe8f2; color: #1f3a5f; font-weight: 600; }
	/* Threat badges use fixed palettes for cross-theme legibility -
	   see /bosses/[slug].astro for the same rationale. */
	.threat--low       { background: #d4edda; color: #155724; }
	.threat--moderate  { background: #fff3cd; color: #856404; }
	.threat--high      { background: #f8d7da; color: #721c24; }
	.threat--extreme   { background: #2b0d0f; color: #ffd7d9; }
	.threat--unknown   { background: var(--bg-cloud); color: var(--text-body); }
</style>
