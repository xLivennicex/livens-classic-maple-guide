---
import "../styles/global.css";
import MapleLeaf from "../components/MapleLeaf.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import { nextMilestoneHeadline } from "../data/launch";

interface NavItem {
	label: string;
	href: string;
}

// Which visual theme to apply. Defaults to Henesys (the site's home
// palette). See src/styles/themes/*.css for the full set.
export type SiteTheme =
	| "henesys"
	| "kerning"
	| "perion"
	| "lith"
	| "ellinia"
	| "sleepywood";

interface Props {
	title: string;
	description?: string;
	// Which nav item should render as the current page. Matched against
	// NavItem.href. Optional so pages that don't map cleanly (e.g. a
	// specific guide) can just leave it undefined.
	currentPath?: string;
	theme?: SiteTheme;
	// Whether to render theme-specific background decorations (clouds,
	// grass strip, etc). On for immersive pages like the homepage; off
	// for reference-heavy pages where they'd fight with content.
	decorations?: boolean;
}

const {
	title,
	description = "A community-built field manual for Global MapleStory Classic World - every quest, map, item, and skill, sourced and player-verified.",
	currentPath,
	theme = "henesys",
	decorations = false,
} = Astro.props;

// One nav list, sourced here. Adding a section is a one-line edit.
// Real routes get real hrefs; unbuilt sections keep '#' so we don't
// hand out 404s during development.
const navItems: NavItem[] = [
	{ label: "Home", href: "/" },
	{ label: "Launch", href: "/launch" },
	{ label: "Jobs", href: "/jobs" },
	{ label: "Leveling", href: "#" },
	{ label: "Quests & PQs", href: "#" },
	{ label: "Database", href: "#" },
	{ label: "Tools", href: "#" },
];
---

<html lang="en" data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/images/maple-leaf.png" />
		<title>{title}</title>
	</head>

	<body data-theme-decorations={decorations ? "on" : "off"}>
		<div class="announcement">
			<span>Unofficial Classic World Guide</span>
			<span>{nextMilestoneHeadline}</span>
		</div>

		<header class="site-header page-width">
			<a class="brand" href="/">
				<span class="brand-icon"><MapleLeaf size={44} /></span>
				<span>
					<strong>Liven's Classic Maple Guide</strong>
					<small>Adventure begins again</small>
				</span>
			</a>

			<label class="search">
				<span class="sr-only">Search the guide</span>
				<input type="search" placeholder="Search guides, quests, items..." />
			</label>
		</header>

		<nav class="navigation" aria-label="Primary navigation">
			{navItems.map((item) => (
				<a
					href={item.href}
					aria-current={item.href === currentPath ? "page" : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>

		<main class="page-width">
			<slot />
		</main>

		<footer class="site-footer">
			<p>
				Unofficial fan guide. MapleStory and related game material belong to NEXON.
			</p>
			<p class="site-footer__credits">
				Cursors by
				<a href="https://github.com/zaytri/maplestory-cursors" target="_blank" rel="noopener noreferrer">
					zaytri/maplestory-cursors
				</a>. Background music: fan compositions (credit pending).
			</p>
		</footer>

		<MusicPlayer />
	</body>
</html>
