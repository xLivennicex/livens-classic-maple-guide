---
import "../styles/global.css";
import MapleLeaf from "../components/MapleLeaf.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import { nextMilestoneHeadline } from "../data/launch";

// Which visual theme to apply. Defaults to Henesys (the site's home
// palette). See src/styles/themes/*.css for the full set.
export type SiteTheme =
	| "henesys"
	| "kerning"
	| "perion"
	| "lith"
	| "ellinia"
	| "sleepywood";

interface Props {
	title: string;
	description?: string;
	// Which nav item should render as the current page. Matched against
	// NavItem.href. Optional so pages that don't map cleanly (e.g. a
	// specific guide) can just leave it undefined.
	currentPath?: string;
	theme?: SiteTheme;
	// Whether to render theme-specific background decorations (clouds,
	// grass strip, etc). On for immersive pages like the homepage; off
	// for reference-heavy pages where they'd fight with content.
	decorations?: boolean;
	// Absolute or root-relative URL for the social-share preview
	// image. When omitted, we auto-select the themed regional
	// background so every page ships a proper og:image without the
	// caller having to think about it.
	image?: string;
}

// Theme -> preview image mapping. All existing themes have a matching
// 1672x941 background in /public/images so link previews look native
// to whichever region the page belongs to.
const THEME_IMAGE: Record<SiteTheme, string> = {
	henesys: "/images/henesys-background.png",
	kerning: "/images/kerning-background.png",
	perion: "/images/perion-background.png",
	lith: "/images/lith-background.png",
	ellinia: "/images/ellinia-background.png",
	sleepywood: "/images/sleepywood-background.png",
};

const {
	title,
	description = "A community-built field manual for Global MapleStory Classic World - every quest, map, item, and skill, sourced and player-verified.",
	currentPath,
	theme = "henesys",
	decorations = false,
	image,
} = Astro.props;

// Resolve the social image. Prefer explicit prop; fall back to theme
// default. Convert root-relative paths to absolute URLs so scrapers
// (Discord, Twitter) never have to guess the origin.
const rawImage = image ?? THEME_IMAGE[theme];
const socialImage = Astro.site
	? new URL(rawImage, Astro.site).href
	: rawImage;

// Canonical URL for this specific page. Built from `Astro.site` in
// astro.config.mjs + the current pathname. When `site` is unset
// (never happens in this project post-deploy-prep, but handled for
// safety) we skip the canonical tag rather than emit a broken one.
const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: null;

// Nav structure moved to src/components/PrimaryNav.astro during
// Sprint 64 - the flat 17-item row got unusably crowded, so it's
// now a 7-item grouped-dropdown nav. Adding a section = one entry
// in PrimaryNav.astro's NAV_STRUCTURE array.
---

<html lang="en" data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/images/maple-leaf.png" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

		<!-- Open Graph: better link-preview cards when the site is
		     shared in Discord, Twitter, etc. Zero cost, high polish. -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:site_name" content="Liven's Classic Maple Guide" />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1672" />
		<meta property="og:image:height" content="941" />
		<!-- summary_large_image beats summary now that every page has
		     a real 1672x941 preview instead of just a favicon. -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<title>{title}</title>
	</head>

	<body data-theme-decorations={decorations ? "on" : "off"}>
		<div class="announcement">
			<span>Unofficial Classic World Guide</span>
			<span>{nextMilestoneHeadline}</span>
		</div>

		<header class="site-header page-width">
			<a class="brand" href="/">
				<span class="brand-icon"><MapleLeaf size={44} /></span>
				<span>
					<strong>Liven's Classic Maple Guide</strong>
					<small>Adventure begins again</small>
				</span>
			</a>

			<form class="search" action="/search" method="get" role="search">
				<label class="sr-only" for="site-search-input">
					Search every page: items, mobs, quests, maps, guides
				</label>
				<input
					id="site-search-input"
					name="q"
					type="search"
					placeholder="Search items, maps, NPCs..."
					title="Full-text search across every page on the site. Type an item / mob / quest / map / NPC name and hit Enter."
					autocomplete="off"
				/>
			</form>
		</header>

		<PrimaryNav currentPath={currentPath ?? ""} />

		<main class="page-width" data-pagefind-body>
			<slot />
		</main>

		<footer class="site-footer">
			<p>
				Unofficial fan guide. MapleStory and related game material belong to NEXON.
			</p>
			<p class="site-footer__credits">
				Cursors by
				<a href="https://github.com/zaytri/maplestory-cursors" target="_blank" rel="noopener noreferrer">
					zaytri/maplestory-cursors
				</a>. Background music: fan compositions (credit pending).
			</p>
		</footer>

		<MusicPlayer />
	</body>
</html>
