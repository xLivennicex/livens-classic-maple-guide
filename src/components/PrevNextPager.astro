---
/**
 * <PrevNextPager> - "walk through records in sequence" bottom-of-page
 * pager for DB detail pages (items, mobs, NPCs, maps, quests, bosses).
 *
 * Pattern lifted from MeowDB's detail pages where you can browse the
 * catalog by going prev/next without returning to the index. Great for
 * curious readers skimming a category.
 *
 * Usage: build neighbours with buildPagerMap() from lib/catalog-pager
 * (fed the index page's display order), then:
 *
 *   <PrevNextPager prev={pager?.prev} next={pager?.next} sectionLabel="item" />
 *
 * Both prev and next are OPTIONAL - the component renders a half-row
 * when one direction is missing (first / last entry in the series).
 *
 * The `sectionLabel` is used only for the screen-reader aria-label,
 * e.g. "Previous and next item". Default: "entry".
 */

import type { PagerLink } from "../lib/catalog-pager";
export type { PagerLink };

interface Props {
	prev?: PagerLink | null;
	next?: PagerLink | null;
	/** Singular noun for aria labels: "item", "monster", "map", etc. */
	sectionLabel?: string;
}

const { prev, next, sectionLabel = "entry" } = Astro.props;

// If neither direction exists, render nothing. (A pure-middle entry
// should always have both; a one-item category would have neither.)
const hasAny = Boolean(prev) || Boolean(next);
---

{hasAny && (
	<nav
		class="prev-next-pager"
		aria-label={`Previous and next ${sectionLabel}`}
	>
		{prev ? (
			<a class="prev-next-pager__link prev-next-pager__link--prev" href={prev.href}>
				<span class="prev-next-pager__arrow" aria-hidden="true">
					&larr;
				</span>
				<span class="prev-next-pager__content">
					<span class="prev-next-pager__eyebrow">Previous</span>
					<span class="prev-next-pager__label">{prev.label}</span>
				</span>
			</a>
		) : (
			<span class="prev-next-pager__spacer" aria-hidden="true"></span>
		)}

		{next ? (
			<a class="prev-next-pager__link prev-next-pager__link--next" href={next.href}>
				<span class="prev-next-pager__content">
					<span class="prev-next-pager__eyebrow">Next</span>
					<span class="prev-next-pager__label">{next.label}</span>
				</span>
				<span class="prev-next-pager__arrow" aria-hidden="true">
					&rarr;
				</span>
			</a>
		) : (
			<span class="prev-next-pager__spacer" aria-hidden="true"></span>
		)}
	</nav>
)}

<style>
	.prev-next-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin: 2rem 0 1rem;
	}

	.prev-next-pager__link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.6rem;
		text-decoration: none;
		color: var(--text-body);
		transition: border-color 0.15s ease, background 0.15s ease;
		min-height: 68px;
	}

	.prev-next-pager__link:hover,
	.prev-next-pager__link:focus-visible {
		border-color: var(--accent-primary);
		background: color-mix(in srgb, var(--accent-primary) 6%, var(--surface-card));
	}

	.prev-next-pager__link--next {
		justify-content: flex-end;
		text-align: right;
	}

	.prev-next-pager__arrow {
		font-size: 1.3rem;
		color: var(--accent-primary);
		font-weight: bold;
		flex-shrink: 0;
	}

	.prev-next-pager__content {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.prev-next-pager__eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}

	.prev-next-pager__label {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent-primary);
		/* Truncate long names cleanly so a monster name 40 characters
		   long doesn't push the pager to wrap. */
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.prev-next-pager__spacer {
		/* Occupies grid cell when only one direction exists; keeps the
		   other cell anchored to its edge instead of centering. */
		display: block;
	}

	/* Mobile: stack vertically. Prev first, then Next below. */
	@media (max-width: 560px) {
		.prev-next-pager {
			grid-template-columns: 1fr;
		}

		.prev-next-pager__link--next {
			justify-content: space-between;
			text-align: left;
		}

		/* On mobile, next with text-align left reads more naturally as
		   "Next [name] ->", so put arrow after content. The default
		   source order (content, arrow) already does this - we just
		   need to NOT reverse it. */
	}
</style>
