---
/**
 * SystemCard - discovery card for a system/reference guide on the
 * homepage (or anywhere we want to surface guides at-a-glance).
 *
 * Sibling to JobCard (which shows a class guide with a monogram).
 * Systems don't have a natural single-letter identity, so the eyebrow
 * tag ("Systems Guide") + verification badge do the visual heavy
 * lifting instead. Data is passed in explicitly so callers can
 * pull from any source (currently: the `guides` content collection).
 */

import SourceBadge from "./SourceBadge.astro";
import type { SourceType } from "../data/sources";

interface Props {
	href: string;
	eyebrow: string;
	heading: string;
	description: string;
	verificationStatus: SourceType;
}

const { href, eyebrow, heading, description, verificationStatus } = Astro.props;
---

<article class="card system-card">
	<div class="system-card__header">
		<span class="eyebrow">{eyebrow}</span>
		<SourceBadge type={verificationStatus} compact />
	</div>
	<h3>{heading}</h3>
	<p>{description}</p>
	<a class="secondary-button" href={href}>Read the guide</a>
</article>

<style>
	.system-card {
		display: flex;
		flex-direction: column;
	}

	.system-card__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}

	/* The eyebrow reuses the site-wide .eyebrow style token; nothing
	 * to override here. Just ensuring it lines up with the badge. */

	.system-card h3 {
		margin: 0.15rem 0 0.5rem;
	}

	.system-card p {
		flex: 1;
		min-height: 5rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.system-card :global(.secondary-button) {
		align-self: flex-start;
	}
</style>
