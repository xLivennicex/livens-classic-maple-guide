---
/**
 * BenefitGrid - a visual "Confirmed rewards" section that renders any
 * number of benefit categories in a responsive card grid. Data-driven
 * so any guide can opt in via its `benefits:` frontmatter field.
 *
 * Currently used by Citizenship (Grade 10 earrings + Grade 2 chairs).
 * Extensible to Mark of Beta rewards, Founder's Access items, PQ drops,
 * or any grouped town-specific reward set.
 *
 * The types come from the `guides` collection schema in
 * `src/content.config.ts` - reproduced here as plain TS to avoid a
 * circular import between the collection schema and the component.
 */

interface BenefitItem {
	town: "henesys" | "kerning";
	name: string;
	description: string;
}

interface BenefitCategory {
	heading: string;
	subtitle: string;
	icon: "earring" | "chair";
	items: BenefitItem[];
}

interface Props {
	categories: BenefitCategory[];
	sectionId?: string;
	sectionHeading?: string;
	sectionEyebrow?: string;
	sectionLede?: string;
}

const {
	categories,
	sectionId = "confirmed-town-benefits",
	sectionHeading = "Confirmed town benefits",
	sectionEyebrow = "Recorded in COT2",
	sectionLede = "The flagship items unlocked through this system. All figures come from Closed Online Test 2 and should be re-verified at launch.",
} = Astro.props;

// Human-readable town labels for the per-item eyebrows.
const townLabels: Record<BenefitItem["town"], string> = {
	henesys: "Henesys Citizenship",
	kerning: "Kerning City Citizenship",
};
---

<section id={sectionId} class="benefits-section">
	<header class="benefits-section__header">
		<h2>{sectionHeading}</h2>
		<span class="benefits-section__eyebrow">{sectionEyebrow}</span>
	</header>
	<p class="benefits-section__lede">{sectionLede}</p>

	<div class="benefits-grid">
		{categories.map((category) => (
			<article class="benefit-card">
				<header class="benefit-card__header">
					<span class="benefit-card__icon" aria-hidden="true">
						{category.icon === "earring" && (
							<svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="16" cy="9" r="4" fill="currentColor" />
								<path d="M16 13 L16 22" />
								<circle cx="16" cy="25" r="3" fill="currentColor" />
							</svg>
						)}
						{category.icon === "chair" && (
							<svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M8 6 L24 6 L24 18 L8 18 Z" fill="currentColor" fill-opacity="0.25" />
								<path d="M6 18 L26 18" />
								<path d="M9 18 L9 26 M23 18 L23 26" />
							</svg>
						)}
					</span>
					<div class="benefit-card__heading-block">
						<h3>{category.heading}</h3>
						<p class="benefit-card__subtitle">{category.subtitle}</p>
					</div>
				</header>

				<ul class="benefit-card__items">
					{category.items.map((item) => (
						<li class={`benefit-item benefit-item--${item.town}`}>
							<span class="benefit-item__town-label">
								{townLabels[item.town]}
							</span>
							<strong class="benefit-item__name">{item.name}</strong>
							<p class="benefit-item__description">{item.description}</p>
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>

<style>
	.benefits-section {
		margin-top: 2.5rem;
		scroll-margin-top: 1rem;
	}

	.benefits-section__header {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: space-between;
		margin-bottom: 0.4rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--border-divider);
	}

	.benefits-section__header h2 {
		margin: 0;
		color: var(--text-heading);
	}

	.benefits-section__eyebrow {
		font-size: 0.78rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
	}

	.benefits-section__lede {
		max-width: 46rem;
		margin: 0 0 1rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 1rem;
	}

	.benefit-card {
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.9rem;
		padding: 1.1rem 1.15rem 0.6rem;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
	}

	.benefit-card__header {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px dashed var(--border-divider);
		margin-bottom: 0.7rem;
	}

	.benefit-card__icon {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.6rem;
		background: var(--accent-secondary);
		border: 2px solid var(--accent-secondary-border);
		color: var(--accent-secondary-text);
	}

	.benefit-card__heading-block h3 {
		margin: 0 0 0.2rem;
		font-size: 1.1rem;
		color: var(--text-heading);
	}

	.benefit-card__subtitle {
		margin: 0;
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	.benefit-card__items {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.benefit-item {
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		background: rgba(255, 245, 220, 0.55);
		border-left: 4px solid var(--border-divider);
	}

	/* Per-town accent stripes. Colors hardcoded so town identity stays
	 * constant regardless of the current page theme. */
	.benefit-item--henesys {
		border-left-color: #7a9a4a;
	}

	.benefit-item--kerning {
		border-left-color: #8b3a3a;
	}

	.benefit-item__town-label {
		display: block;
		font-size: 0.78rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.15rem;
	}

	.benefit-item--henesys .benefit-item__town-label {
		color: #5a7a2a;
	}

	.benefit-item--kerning .benefit-item__town-label {
		color: #6b2a2a;
	}

	.benefit-item__name {
		display: block;
		color: var(--text-heading);
		font-size: 0.95rem;
		margin-bottom: 0.15rem;
	}

	.benefit-item__description {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--text-body);
	}
</style>
