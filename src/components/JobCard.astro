---
/**
 * JobCard - renders one class in the jobs directory and homepage
 * grid. Takes direct props rather than a `Job` object so the caller
 * can adapt any data source (currently the `jobs` content collection).
 */

interface Props {
	monogram: string;
	name: string;
	description: string;
	href: string;
}
const { monogram, name, description, href } = Astro.props;
---

<article class="card job-card">
	<span class="job-monogram" aria-hidden="true">{monogram}</span>
	<h3>{name}</h3>
	<p>{description}</p>
	<a class="secondary-button" href={href}>Read the guide</a>
</article>

<style>
	.job-card {
		display: flex;
		flex-direction: column;
	}

	.job-monogram {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		margin-bottom: 0.6rem;
		border-radius: 0.6rem;
		background: var(--surface-nav);
		color: var(--text-on-nav);
		font-size: 1.5rem;
		font-weight: bold;
		border: 2px solid var(--border-nav);
	}

	.job-card p {
		flex: 1;
		min-height: 5rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.job-card :global(.secondary-button) {
		align-self: flex-start;
	}
</style>
