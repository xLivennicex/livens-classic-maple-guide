---
/**
 * <HeaderSearch> - global search field in the primary nav, with a
 * progressive-enhancement instant-suggest dropdown.
 *
 * BASELINE (no JS): a plain <form action="/search"> submitting ?q=...;
 * /search reads q and pre-populates Pagefind's full UI. Works with JS
 * off, ships zero client bytes until focus.
 *
 * ENHANCED: on first focus, lazy-imports /pagefind/pagefind.js
 * (~15kb gzip - not paid on page views that never touch search),
 * debounces input, and renders the top 6 matches in a listbox below
 * the field. ArrowUp/Down move the active option (aria-activedescendant),
 * Enter on an active option navigates straight to it, Enter otherwise
 * submits the form. If Pagefind fails to load (astro dev, CDN hiccup)
 * the dropdown never opens and Enter still submits.
 *
 * Layout: lives inside <PrimaryNav>, after the link list. Desktop: flex
 * places it at the right end of the nav row. Mobile: detaches to
 * position: fixed and appears at the top of the open drawer, BELOW the
 * pinned close button (geometry shared via custom properties that
 * PrimaryNav defines - see --drawer-* in PrimaryNav's mobile block).
 */
---

<form class="header-search" role="search" action="/search" method="get" data-header-search>
	<label class="header-search__label" for="header-search-input">Search</label>
	<div class="header-search__wrap">
		<span class="header-search__icon" aria-hidden="true">&#x1F50E;</span>
		<input
			id="header-search-input"
			class="header-search__input"
			type="search"
			name="q"
			placeholder="Search guides, items, mobs..."
			autocomplete="off"
			enterkeyhint="search"
			role="combobox"
			aria-autocomplete="list"
			aria-controls="header-search-results"
			aria-expanded="false"
			data-header-search-input
		/>
		<div
			id="header-search-results"
			class="header-search__results"
			role="listbox"
			aria-label="Search suggestions"
			data-header-search-results
		></div>
	</div>
</form>

<script>
	type Hit = { url: string; meta?: { title?: string }; excerpt?: string };

	const form = document.querySelector<HTMLFormElement>("[data-header-search]");
	const input = form?.querySelector<HTMLInputElement>("[data-header-search-input]");
	const panel = form?.querySelector<HTMLElement>("[data-header-search-results]");

	if (form && input && panel) {
		let pagefind: any = null;
		let loading: Promise<any> | null = null;
		let debounce: ReturnType<typeof setTimeout> | null = null;
		let activeIndex = -1; // -1 = no option active, focus stays in the input
		let latestQuery = "";

		// Single in-flight import shared by every caller, so a focus and
		// a fast first keystroke can't trigger two imports.
		function loadPagefind(): Promise<any> {
			if (pagefind) return Promise.resolve(pagefind);
			loading ??= import(/* @vite-ignore */ "/pagefind/pagefind.js")
				.then(async (mod) => {
					await mod.init?.();
					pagefind = mod;
					return mod;
				})
				.catch(() => {
					// Expected under `astro dev` (Pagefind indexes post-build).
					// Form-submit baseline still works; stay silent.
					loading = null;
					return null;
				});
			return loading;
		}

		const escapeHtml = (s: string): string => {
			const div = document.createElement("div");
			div.textContent = s;
			return div.innerHTML;
		};
		const escapeAttr = (s: string): string => escapeHtml(s).replace(/"/g, "&quot;");

		function options(): HTMLElement[] {
			return Array.from(panel!.querySelectorAll<HTMLElement>(".header-search__result"));
		}

		function setActive(index: number): void {
			activeIndex = index;
			options().forEach((el, i) => {
				const on = i === index;
				el.setAttribute("aria-selected", String(on));
				el.classList.toggle("header-search__result--active", on);
				if (on) el.scrollIntoView({ block: "nearest" });
			});
			if (index >= 0) input!.setAttribute("aria-activedescendant", `header-search-opt-${index}`);
			else input!.removeAttribute("aria-activedescendant");
		}

		function open(): void {
			panel!.classList.add("header-search__results--open");
			input!.setAttribute("aria-expanded", "true");
		}

		function close(): void {
			panel!.classList.remove("header-search__results--open");
			input!.setAttribute("aria-expanded", "false");
			setActive(-1);
		}

		const isOpen = (): boolean => panel!.classList.contains("header-search__results--open");

		function render(hits: Hit[], query: string): void {
			const q = escapeHtml(query);
			const rows = hits.length
				? hits
						.map(
							(hit, i) => `
						<a class="header-search__result" href="${escapeAttr(hit.url)}"
							role="option" id="header-search-opt-${i}" aria-selected="false">
							<span class="header-search__result-title">${escapeHtml(hit.meta?.title ?? hit.url)}</span>
							${hit.excerpt ? `<span class="header-search__result-excerpt">${hit.excerpt}</span>` : ""}
						</a>`,
						)
						.join("")
				: `<div class="header-search__empty">No matches for &ldquo;${q}&rdquo;. Press Enter to search the full index.</div>`;
			panel!.innerHTML =
				rows +
				`<a class="header-search__more" href="/search?q=${encodeURIComponent(query)}">
					See all results for &ldquo;${q}&rdquo; &rarr;
				</a>`;
			activeIndex = -1;
		}

		async function search(query: string): Promise<void> {
			const pf = await loadPagefind();
			if (!pf) return;
			const result = await pf.search(query);
			const hits: Hit[] = await Promise.all(result.results.slice(0, 6).map((r: any) => r.data()));
			// Drop stale responses: a slow search for "zak" must not
			// overwrite results for "zakum" that already rendered.
			if (query !== latestQuery) return;
			render(hits, query);
			open();
		}

		input.addEventListener("input", () => {
			const q = input.value.trim();
			latestQuery = q;
			if (debounce) clearTimeout(debounce);
			if (q.length < 2) {
				close();
				panel.innerHTML = "";
				return;
			}
			debounce = setTimeout(() => search(q), 120);
		});

		// Pre-warm on focus so the first keystroke doesn't wait on the import.
		input.addEventListener("focus", () => {
			loadPagefind();
			if (panel.innerHTML.trim() && input.value.trim().length >= 2) open();
		});

		input.addEventListener("keydown", (e: KeyboardEvent) => {
			const opts = options();
			if (e.key === "ArrowDown" && opts.length) {
				e.preventDefault();
				if (!isOpen()) open();
				setActive(Math.min(activeIndex + 1, opts.length - 1));
			} else if (e.key === "ArrowUp" && opts.length) {
				e.preventDefault();
				setActive(Math.max(activeIndex - 1, -1));
			} else if (e.key === "Enter" && activeIndex >= 0) {
				e.preventDefault();
				const href = (opts[activeIndex] as HTMLAnchorElement).href;
				if (href) window.location.href = href;
			} else if (e.key === "Escape" && isOpen()) {
				// Peel back ONE layer: close the suggestions only. Without
				// this, Escape also bubbled to PrimaryNav's document-level
				// handler and slammed the whole mobile drawer shut.
				e.stopPropagation();
				close();
			}
		});

		document.addEventListener("click", (e) => {
			if (!form.contains(e.target as Node)) close();
		});

		// Echo the active query back into the field on /search, so the
		// header and the page agree about what was searched.
		if (location.pathname.replace(/\/$/, "") === "/search") {
			const q = new URLSearchParams(location.search).get("q");
			if (q) input.value = q;
		}
	}
</script>

<style>
	.header-search {
		display: flex;
		flex-direction: column;
		flex: 0 0 auto;
		margin: 0;
		position: relative;
	}

	.header-search__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.header-search__wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.header-search__icon {
		position: absolute;
		left: 0.6rem;
		font-size: 0.9rem;
		opacity: 0.65;
		pointer-events: none;
		color: var(--text-on-nav);
	}

	.header-search__input {
		width: 15rem;
		max-width: 100%;
		padding: 0.5rem 0.75rem 0.5rem 2rem;
		border-radius: 0.5rem;
		border: 2px solid color-mix(in srgb, var(--border-nav) 55%, transparent);
		background: color-mix(in srgb, var(--surface-card) 85%, transparent);
		color: var(--text-body);
		font: inherit;
		font-size: 0.92rem;
		transition: border-color 0.15s ease, background 0.15s ease, width 0.2s ease;
	}

	.header-search__input::placeholder {
		color: var(--text-muted);
		opacity: 0.75;
	}

	.header-search__input:focus-visible {
		outline: none;
		border-color: var(--accent-primary);
		background: var(--surface-card);
		width: 17rem;
	}

	/* The platform X on type=search clashes with the icon. */
	.header-search__input::-webkit-search-cancel-button {
		appearance: none;
		-webkit-appearance: none;
	}

	.header-search__results {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		right: 0;
		min-width: 18rem;
		max-height: min(70vh, 32rem);
		overflow-y: auto;
		background: var(--surface-card);
		border: 2px solid var(--border-card);
		border-radius: 0.6rem;
		box-shadow:
			0 8px 28px color-mix(in srgb, black 24%, transparent),
			0 2px 6px color-mix(in srgb, black 12%, transparent);
		z-index: 80;
		display: none;
		padding: 0.35rem;
	}

	.header-search__results--open {
		display: block;
	}

	/* Everything inside the panel is injected via innerHTML, so it never
	   receives Astro's data-astro-cid-* scoping attribute. Plain scoped
	   selectors compiled to `.x[data-astro-cid-...]` and matched NOTHING
	   in production - rows were unstyled and the keyboard-active row had
	   no visible highlight. :global() on the injected part, anchored
	   under the (scoped) panel, keeps the rules component-local. */
	.header-search__results :global(.header-search__result) {
		display: block;
		padding: 0.55rem 0.75rem;
		border-radius: 0.4rem;
		text-decoration: none;
		color: var(--text-heading, var(--text-body));
	}

	.header-search__results :global(.header-search__result:hover),
	.header-search__results :global(.header-search__result--active) {
		background: color-mix(in srgb, var(--accent-primary) 12%, transparent);
		color: var(--accent-primary);
	}

	/* Keyboard-active row gets a ring too: background tint alone is too
	   faint on some themes to count as a visible focus indicator. */
	.header-search__results :global(.header-search__result--active) {
		outline: 2px solid var(--accent-primary);
		outline-offset: -2px;
	}

	.header-search__results :global(.header-search__result-title) {
		display: block;
		font-weight: 700;
		font-size: 0.95rem;
		line-height: 1.3;
	}

	.header-search__results :global(.header-search__result-excerpt) {
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-top: 0.15rem;
		line-height: 1.4;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.header-search__results :global(.header-search__result-excerpt mark) {
		background: color-mix(in srgb, var(--accent-primary) 22%, transparent);
		color: inherit;
		font-weight: 600;
		border-radius: 0.2rem;
		padding: 0 0.1em;
	}

	.header-search__results :global(.header-search__empty) {
		padding: 0.75rem 0.9rem;
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.45;
	}

	.header-search__results :global(.header-search__more) {
		display: block;
		margin-top: 0.25rem;
		padding: 0.5rem 0.75rem;
		border-top: 1px solid var(--border-card);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent-primary);
		text-decoration: none;
		text-align: center;
	}

	.header-search__results :global(.header-search__more:hover),
	.header-search__results :global(.header-search__more:focus-visible) {
		background: color-mix(in srgb, var(--accent-primary) 10%, transparent);
	}

	/* Mobile: appears at the top of the open drawer, on its own row BELOW
	   the pinned close button. It used to share the button's row with a
	   hard-coded 3.5rem left inset, but the open button ("X Menu") is
	   ~103px wide and sits above it in z-order, covering the left of the
	   input. Stacking on separate rows removes the width dependency. */
	@media (max-width: 819px) {
		.header-search {
			position: fixed;
			top: var(--drawer-search-top, 3.75rem);
			left: 0;
			width: var(--drawer-width, min(84vw, 320px));
			box-sizing: border-box;
			padding: 0 0.6rem;
			z-index: 105;
			opacity: 0;
			pointer-events: none;
			transform: translateX(-100%);
			transition: transform 0.25s ease, opacity 0.2s ease 0.05s;
		}

		:global(.primary-nav--drawer-open) .header-search {
			transform: translateX(0);
			opacity: 1;
			pointer-events: auto;
		}

		.header-search__input,
		.header-search__input:focus-visible {
			width: 100%;
			font-size: 0.95rem;
			padding: 0.65rem 0.75rem 0.65rem 2.1rem;
		}

		.header-search__results {
			min-width: 0;
		}
	}
</style>
