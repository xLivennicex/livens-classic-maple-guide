---
// Full archive-entry card. Renders every field described in the source
// index schema. Designed to be dropped into a list (e.g. the Official
// Sources section) without needing wrapper markup.

import SourceBadge from "./SourceBadge.astro";
import { type ArchivedSource, getSource } from "../data/sources";

interface Props {
	source: ArchivedSource;
	// Anchor prefix used so verification notices can deep-link to a
	// specific card via `${sourcesAnchor}-${slug}`.
	anchorPrefix?: string;
}

const { source, anchorPrefix = "sources" } = Astro.props;
const anchor = `${anchorPrefix}-${source.slug}`;

const supersededTitle = source.supersededBy
	? getSource(source.supersededBy).title
	: null;
---

<article class="card source-card" id={anchor}>
	<header class="source-card__header">
		<div class="source-card__titles">
			<SourceBadge type={source.sourceType} />
			<h3>{source.title}</h3>
			<p class="source-card__byline">
				{source.publisher} - {source.publishedOn}
			</p>
		</div>

		{source.status === "superseded" && (
			<span class="source-card__superseded">
				Superseded{supersededTitle ? ` by ${supersededTitle}` : ""}
			</span>
		)}
	</header>

	<p class="source-card__summary">{source.summary}</p>

	{source.confirmedFacts.length > 0 && (
		<div class="source-card__facts">
			<h4>Confirmed facts</h4>
			<ul>
				{source.confirmedFacts.map((fact) => <li>{fact}</li>)}
			</ul>
		</div>
	)}

	<dl class="source-card__meta">
		<div>
			<dt>Topics</dt>
			<dd>
				{source.topics.length > 0 ? source.topics.join(", ") : "(none listed)"}
			</dd>
		</div>

		<div>
			<dt>Checked</dt>
			<dd><time datetime={source.checkedOn}>{source.checkedOn}</time></dd>
		</div>

		<div>
			<dt>Links</dt>
			<dd class="source-card__links">
				{source.originalUrl ? (
					<a href={source.originalUrl} target="_blank" rel="noopener noreferrer">
						Original
					</a>
				) : (
					<span class="source-card__pending">Original URL pending</span>
				)}
				{source.archiveUrl && (
					<>
						<span aria-hidden="true">|</span>
						<a href={source.archiveUrl} target="_blank" rel="noopener noreferrer">
							Archive snapshot
						</a>
					</>
				)}
			</dd>
		</div>
	</dl>
</article>

<style>
	.source-card {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		scroll-margin-top: 1rem;
	}

	.source-card__header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.source-card__titles h3 {
		margin: 0.5rem 0 0.25rem;
		font-size: 1.25rem;
		color: #304f34;
	}

	.source-card__byline {
		margin: 0;
		color: #5d665d;
		font-size: 0.9rem;
	}

	.source-card__superseded {
		align-self: flex-start;
		padding: 0.2rem 0.55rem;
		background: #f8d8d0;
		color: #8a2f1c;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.source-card__summary {
		margin: 0;
		line-height: 1.55;
	}

	.source-card__facts {
		padding: 0.75rem 1rem;
		background: #f4f0df;
		border-radius: 0.5rem;
	}

	.source-card__facts h4 {
		margin: 0 0 0.4rem;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #48734b;
	}

	.source-card__facts ul {
		margin: 0;
		padding-left: 1.1rem;
		line-height: 1.6;
	}

	.source-card__meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.6rem 1.5rem;
		margin: 0;
		padding-top: 0.75rem;
		border-top: 1px solid #ded4b7;
		font-size: 0.85rem;
	}

	.source-card__meta div {
		display: flex;
		flex-direction: column;
	}

	.source-card__meta dt {
		font-weight: bold;
		color: #48734b;
		text-transform: uppercase;
		font-size: 0.78rem;
		letter-spacing: 0.05em;
	}

	.source-card__meta dd {
		margin: 0.15rem 0 0;
		color: #4f6653;
	}

	.source-card__links {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.source-card__links a {
		color: #365c3a;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.source-card__links span[aria-hidden] {
		color: #a8b3a9;
	}

	.source-card__pending {
		color: #8a2f1c;
		font-style: italic;
	}
</style>
