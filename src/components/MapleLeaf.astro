---
// Brand mark. Uses a raster PNG (public/images/maple-leaf.png) rather
// than an inline SVG so the actual designed emblem is what ships. Props
// mirror the previous SVG version so callers do not need to change.
interface Props {
	size?: number;
	title?: string;
}
const { size = 28, title = "Maple leaf" } = Astro.props;
---

<img
	src="/images/maple-leaf.png"
	alt={title}
	width={size}
	height={size}
	class="maple-leaf"
	loading="eager"
	decoding="async"
/>

<style>
	.maple-leaf {
		display: inline-block;
		object-fit: contain;
		/* Preserve crisp edges when rendered smaller than native res. */
		image-rendering: auto;
	}
</style>
