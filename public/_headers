# Cloudflare Pages _headers file.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Cache policy: everything Astro fingerprints (immutable hash in the
# filename) gets a long max-age; HTML gets a short max-age with
# must-revalidate so content updates propagate quickly on deploy.

# Astro fingerprinted static assets (JS, CSS chunks with content hashes).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind runtime + index shards. These change on every content
# update (new page = new fragment file), but the filenames include
# content hashes too, so immutable caching is safe.
/pagefind/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages. Short cache + must-revalidate so readers see fresh
# content quickly after a deploy. Cloudflare's edge cache will
# still respect the 5-minute window before checking origin.
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Directory index HTML (Astro's default output shape for pretty URLs).
/
  Cache-Control: public, max-age=300, must-revalidate

# Sensible defaults for everything else (images, fonts, audio).
# 24 hours strikes a balance between freshness and edge-cache benefit.
/*
  Cache-Control: public, max-age=86400

# Security headers - free defense-in-depth against common attacks.
# These are separate from the cache directives above; Cloudflare
# merges both blocks per path.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
