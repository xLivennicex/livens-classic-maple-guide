{
  "name": "livens-classic-maple-guide",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "db": "node scripts/build-database.mjs",
    "db:build": "node scripts/build-database.mjs && astro build && pagefind --site dist",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:sprites": "node scripts/audit-sprites.mjs",
    "audit:vi": "node scripts/audit-vi-references.mjs",
    "transcode:audio": "node scripts/transcode-audio.mjs",
    "fetch:maple-catalog": "node scripts/fetch-maple-catalog.mjs",
    "validate:character-items": "node scripts/validate-character-items.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=livens-classic-maple --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "pagefind": "^1.5.2",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
